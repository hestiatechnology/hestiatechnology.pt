---
import Layout from "@/layouts/Layout.astro";
import { Button } from "@/components/ui/button";
---

<Layout title="404 - Página Não Encontrada">
  <div class="flex flex-col items-center justify-center min-h-[80vh] px-4 text-center">
    <h1 class="text-9xl font-bold text-primary opacity-20">404</h1>
    <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-foreground mt-4">
      Página Não Encontrada
    </h2>
    <p class="text-muted-foreground mt-4 text-lg max-w-md mx-auto">
      Desculpe, não conseguimos encontrar a página que procura. Pode ter sido movida ou apagada.
    </p>
    <div class="mt-8 flex gap-4">
      <Button asChild size="lg">
        <a href="/">Voltar ao Início</a>
      </Button>
      <Button asChild variant="outline" size="lg">
        <a href="/pt/contact">Contactar Suporte</a>
      </Button>
    </div>
  </div>
</Layout>
