---
import Layout from "@/layouts/Layout.astro";
import { Button } from "@/components/ui/button";
import FeatureShowcase from "@/components/FeatureShowcase";
import { HowItWorks } from "@/components/HowItWorks.en";
import { Image } from "astro:assets";
import IPCALogo from "@/assets/ipca_cor.png";
import STARTIpca from "@/assets/start-ipca.png";
import { Magnetic } from "@/components/ui/magnetic";
import { GoogleCalendarButton } from "@/components/GoogleCalendarButton";
import { Check, X } from "lucide-react";
import { EcosystemSection } from "@/components/EcosystemSection";
import { DemoVideoSection } from "@/components/DemoVideoSection";
---

<Layout title="Hestia — The Factory Operating System">
  <div class="flex flex-col">

    <!-- ── Hero ── -->
    <section class="pt-20 pb-16 md:pt-28 md:pb-24 overflow-hidden">
      <div class="container mx-auto px-4 md:px-6 max-w-6xl">
        <div class="grid lg:grid-cols-[1fr,380px] gap-12 lg:gap-20 items-center">

          <!-- Left: copy -->
          <div class="space-y-7 max-w-2xl animate-fade-up">
            <div class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-widest text-primary bg-primary/8 px-3 py-1.5 rounded-full border border-primary/20">
              EU ESPR Regulation — 2027
            </div>
            <h1 class="font-heading text-5xl md:text-6xl lg:text-[3.75rem] xl:text-7xl font-bold tracking-tight leading-[1.06] text-foreground">
              The Factory Operating System
            </h1>
            <p class="text-sm font-semibold text-primary tracking-wide">Purpose-built for textile manufacturers.</p>
            <p class="text-lg text-muted-foreground leading-relaxed max-w-xl mt-4!">
              Hestia connects and orchestrates every layer of your factory — production, compliance, AI, IoT, and Digital Product Passports — replacing fragmented legacy systems with one intelligent platform.
            </p>
            <div class="flex flex-col sm:flex-row gap-3 pt-1">
              <GoogleCalendarButton client:load label="Schedule a Demo" size="lg" />
              <Magnetic client:load>
                <Button size="lg" variant="outline" className="rounded-lg text-base h-11 px-7">
                  <a href={`/${Astro.currentLocale}/features`}>See How It Works</a>
                </Button>
              </Magnetic>
            </div>
          </div>

          <!-- Right: floating stat cards -->
          <div class="hidden lg:flex flex-col gap-3 animate-fade-up [animation-delay:300ms]">
            <div class="bg-card border border-border rounded-2xl p-5 shadow-sm">
              <div class="font-heading text-4xl font-bold text-foreground mb-1">2027</div>
              <div class="text-sm text-muted-foreground">EU DPP Target Date</div>
            </div>
            <div class="bg-card border border-border rounded-2xl p-5 shadow-sm ml-8">
              <div class="font-heading text-4xl font-bold text-foreground mb-1">€166B</div>
              <div class="text-sm text-muted-foreground">EU Textile Industry Revenue</div>
            </div>
            <div class="bg-primary rounded-2xl p-5 shadow-md shadow-primary/20">
              <div class="font-heading text-4xl font-bold text-white mb-1">27</div>
              <div class="text-sm text-white/70">EU Countries Required to Comply</div>
            </div>
          </div>
        </div>

        <!-- Mobile stats row -->
        <div class="lg:hidden grid grid-cols-3 gap-3 mt-10">
          {[
            { value: "2027", label: "DPP Target" },
            { value: "€166B", label: "EU Textile Market" },
            { value: "27", label: "EU Countries" },
          ].map((s) => (
            <div class="bg-card border border-border rounded-xl p-4 text-center">
              <div class="font-heading text-2xl font-bold">{s.value}</div>
              <div class="text-xs text-muted-foreground mt-1">{s.label}</div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ── Institutional Partners ── -->
    <div class="border-y border-border/60 py-8 bg-muted/20">
      <div class="container mx-auto px-4 max-w-6xl">
        <div class="flex flex-wrap items-center justify-between gap-8">
          <p class="text-xs font-bold uppercase tracking-widest text-muted-foreground/60">
            Institutional Support
          </p>
          <div class="flex flex-wrap items-center gap-x-10 gap-y-4 opacity-50 hover:opacity-80 transition-opacity duration-500">
            <Image src={IPCALogo} height={32} alt="IPCA" class="h-8 w-auto object-contain grayscale" />
            <Image src={STARTIpca} height={32} alt="Start IPCA" class="h-8 w-auto object-contain grayscale" />
          </div>
        </div>
      </div>
    </div>

    <!-- ── Features Showcase ── -->
    <div class="py-20 md:py-32">
      <FeatureShowcase
        client:load
        locale={Astro.currentLocale}
        title="One Platform. Every Layer."
        description="From shop floor to compliance, Hestia orchestrates your entire operation."
      />
    </div>

    <!-- ── How It Works ── -->
    <HowItWorks client:visible />

    <!-- ── Demo Video ── -->
    <DemoVideoSection client:visible locale="en" />

    <!-- ── Comparison ── -->
    <section class="py-20 md:py-32">
      <div class="container mx-auto px-4 md:px-6 max-w-6xl">
        <div class="grid lg:grid-cols-[1fr,2fr] gap-16 items-start">
          <div>
            <p class="text-[11px] font-bold uppercase tracking-widest text-primary mb-4">Why Switch</p>
            <h2 class="font-heading text-3xl md:text-4xl font-bold leading-tight mb-4">
              Built for ESPR.<br/>Not retrofitted.
            </h2>
            <p class="text-muted-foreground leading-relaxed text-sm">
              Legacy systems weren't designed for ESPR, DPP, or real-time textile traceability. Hestia was built from the ground up as a complete factory operating system.
            </p>
          </div>

          <div class="grid md:grid-cols-2 gap-4">
            <!-- Legacy -->
            <div class="border border-border rounded-2xl p-7 bg-muted/20">
              <h3 class="font-heading text-lg font-bold text-muted-foreground mb-6">Legacy Systems</h3>
              <ul class="space-y-4">
                {[
                  "No ESPR / DPP compliance built-in",
                  "Manual yarn lot & batch tracing",
                  "IT consultants for every update",
                  "No real-time monitoring",
                ].map((item) => (
                  <li class="flex items-start gap-3 text-sm text-muted-foreground">
                    <div class="w-5 h-5 rounded-full bg-red-100 text-red-500 dark:bg-red-900/30 flex items-center justify-center shrink-0 mt-0.5">
                      <X class="w-3 h-3" />
                    </div>
                    {item}
                  </li>
                ))}
              </ul>
            </div>

            <!-- Hestia -->
            <div class="border-2 border-primary/30 rounded-2xl p-7 bg-primary/4 relative overflow-hidden">
              <div class="absolute top-0 right-0 bg-primary text-white text-[10px] font-bold px-3 py-1 rounded-bl-xl tracking-widest uppercase">
                Hestia
              </div>
              <h3 class="font-heading text-lg font-bold mb-6">Hestia OS</h3>
              <ul class="space-y-4">
                {[
                  "Native EU DPP generation (ESPR-ready)",
                  "Full fiber-to-garment traceability",
                  "Automatic regulatory updates via SaaS",
                  "Real-time production floor monitoring",
                ].map((item) => (
                  <li class="flex items-start gap-3 text-sm font-medium">
                    <div class="w-5 h-5 rounded-full bg-primary/15 text-primary flex items-center justify-center shrink-0 mt-0.5">
                      <Check class="w-3 h-3" />
                    </div>
                    {item}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ── Platform / Ecosystem ── -->
    <EcosystemSection client:visible locale="en" />

    <!-- ── Early Access ── -->
    <section class="py-12 md:py-16">
      <div class="container mx-auto px-4 md:px-6 max-w-6xl">
        <div class="border-2 border-primary/20 bg-primary/4 rounded-2xl p-8 md:p-12 flex flex-col md:flex-row items-center justify-between gap-6">
          <div class="space-y-2 text-center md:text-left">
            <p class="text-[11px] font-bold uppercase tracking-widest text-primary">Early Access</p>
            <h3 class="font-heading text-2xl md:text-3xl font-bold">Join the Early Access Program</h3>
            <p class="text-muted-foreground text-sm max-w-lg">
              Be among the first factories to run on Hestia. Limited spots in our early access program.
            </p>
          </div>
          <Button size="lg" className="rounded-lg font-semibold shrink-0" asChild>
            <a href={`/${Astro.currentLocale}/contact`}>Apply for Early Access</a>
          </Button>
        </div>
      </div>
    </section>

    <!-- ── DPP Regulation — dark section ── -->
    <section class="bg-[#0D1A3A] text-white py-24 md:py-32">
      <div class="container mx-auto px-4 md:px-6 max-w-6xl">
        <div class="grid lg:grid-cols-[1fr,1fr] gap-16 items-center">
          <div class="space-y-6">
            <div class="inline-block bg-white/10 text-white/80 text-[10px] font-bold px-3 py-1.5 rounded-full uppercase tracking-widest border border-white/15">
              EU Regulation · ESPR
            </div>
            <h2 class="font-heading text-4xl md:text-5xl font-bold leading-tight">
              Digital Product Passports Are Mandatory From 2027
            </h2>
          </div>
          <div class="space-y-6">
            <p class="text-white/60 text-base leading-relaxed">
              The EU Ecodesign for Sustainable Products Regulation (ESPR) makes Digital Product Passports mandatory for textile products. Non-compliant goods will be blocked from EU markets.
            </p>
            <p class="text-white/60 text-base leading-relaxed">
              Hestia generates DPPs automatically from your existing production data — no external consultants, no manual data entry, no disruption to operations.
            </p>
            <div class="flex flex-col sm:flex-row gap-3 pt-2">
              <Button size="lg" className="rounded-lg bg-white text-[#0D1A3A] hover:bg-white/90 font-semibold">
                <a href={`/${Astro.currentLocale}/dpp`}>Learn More About DPP</a>
              </Button>
              <GoogleCalendarButton client:load label="Talk to an Expert" variant="outline" size="lg" className="border-white/30 text-white hover:bg-white/10" />
            </div>
          </div>
        </div>
      </div>
    </section>

  </div>
</Layout>
