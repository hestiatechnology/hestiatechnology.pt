---
import Layout from "@/layouts/Layout.astro";
import { Button } from "@/components/ui/button";
import GoogleCalendarButton from "@/components/GoogleCalendarButton";
import TeamSection from "@/components/TeamSection.en";
import { Image } from "astro:assets";
import IPCA from "@/assets/ipca_cor.png";
import STARTIpca from "@/assets/start-ipca.png";
import { ArrowRight, Target, Eye, Zap, Heart, Shield, Lightbulb } from "lucide-react";
---

<Layout title="About Us" darkHero={true}>

  <!-- Hero Section -->
  <section class="relative overflow-hidden py-24 md:py-36" style="background: #060E24;">
    <!-- Animated orbs -->
    <div class="absolute top-1/4 left-1/4 w-72 h-72 rounded-full bg-blue-500/10 blur-3xl animate-pulse"></div>
    <div class="absolute bottom-1/4 right-1/4 w-96 h-96 rounded-full bg-indigo-500/8 blur-3xl animate-pulse" style="animation-delay: 1s;"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-150 h-150 rounded-full bg-violet-500/5 blur-3xl animate-pulse" style="animation-delay: 2s;"></div>

    <div class="relative z-10 max-w-6xl mx-auto px-4 md:px-6 text-center">
      <p class="text-[11px] uppercase tracking-widest text-blue-400 mb-6 font-heading">
        About Hestia Technology
      </p>
      <h1 class="text-4xl sm:text-5xl md:text-7xl font-heading tracking-tight mb-8">
        <span class="text-white">Building the</span>
        <br />
        <span class="bg-linear-to-r from-blue-400 via-indigo-400 to-violet-400 bg-clip-text text-transparent">
          Factory Operating System
        </span>
      </h1>
      <p class="max-w-2xl mx-auto text-lg md:text-xl text-slate-400 leading-relaxed mb-10">
        Legacy systems are costing textile manufacturers their profits and their future.
        We are building the platform that replaces them - purpose-built for EU compliance,
        production tracking, and the Digital Product Passport.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <GoogleCalendarButton client:load size="lg" className="px-8 bg-white text-[#060E24] hover:bg-slate-100">
          Book a Demo
          <ArrowRight className="ml-2 h-4 w-4" />
        </GoogleCalendarButton>
      </div>
    </div>
  </section>

  <!-- Mission & Vision Section -->
  <section class="py-20 md:py-28">
    <div class="max-w-6xl mx-auto px-4 md:px-6">
      <div class="text-center mb-16">
        <p class="text-[11px] uppercase tracking-widest text-primary mb-4 font-heading">
          Why We Exist
        </p>
        <h2 class="text-3xl sm:text-4xl font-heading tracking-tight text-foreground">
          Mission & Vision
        </h2>
      </div>

      <div class="grid gap-8 md:grid-cols-2">
        <!-- Mission Card -->
        <div class="group relative rounded-2xl border border-border/60 bg-card p-8 md:p-10 transition-all hover:border-primary/30 hover:shadow-lg">
          <div class="w-14 h-14 rounded-xl bg-primary/10 flex items-center justify-center mb-6">
            <Target className="h-7 w-7 text-primary" />
          </div>
          <h3 class="text-2xl font-heading text-foreground mb-4">Our Mission</h3>
          <p class="text-muted-foreground text-lg leading-relaxed">
            Build the factory OS that automates EU compliance and production tracking,
            replacing costly legacy systems. We give manufacturers real-time visibility,
            automated regulatory reporting, and a single source of truth for their entire
            production chain.
          </p>
        </div>

        <!-- Vision Card -->
        <div class="group relative rounded-2xl border border-border/60 bg-card p-8 md:p-10 transition-all hover:border-primary/30 hover:shadow-lg">
          <div class="w-14 h-14 rounded-xl bg-violet-500/10 flex items-center justify-center mb-6">
            <Eye className="h-7 w-7 text-violet-500" />
          </div>
          <h3 class="text-2xl font-heading text-foreground mb-4">Our Vision</h3>
          <p class="text-muted-foreground text-lg leading-relaxed">
            Become the standard OS for EU manufacturing, starting with Portuguese textile
            and expanding across Europe. Every factory deserves modern software that
            keeps pace with regulation, not consultants charging by the hour to patch
            outdated systems.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Our Story Section -->
  <section class="py-20 md:py-28 border-y border-border/60" style="background: #060E24;">
    <div class="max-w-6xl mx-auto px-4 md:px-6">
      <div class="max-w-3xl mx-auto">
        <p class="text-[11px] uppercase tracking-widest text-blue-400 mb-6 font-heading">
          Our Story
        </p>
        <h2 class="text-3xl sm:text-4xl font-heading tracking-tight text-white mb-10">
          Born from Frustration with Legacy Systems
        </h2>

        <div class="space-y-6 text-slate-400 text-lg leading-relaxed">
          <p>
            We spent years watching textile manufacturers in Barcelos and across northern Portugal
            fight a losing battle against outdated software. Systems that were designed in the 1990s,
            maintained by a handful of vendors who charged exorbitant fees for every minor update.
            Every time a new EU regulation dropped, factory owners had to scramble - hiring consultants,
            patching spreadsheets, praying nothing fell through the cracks.
          </p>
          <p>
            The Digital Product Passport was the breaking point. A regulation that demands full
            traceability across the supply chain, and the legacy systems couldn't even track
            production across a single floor. Factory managers were stitching together data from
            five different tools, three different formats, and zero real-time visibility.
          </p>
          <p class="text-white font-medium text-xl">
            We decided to stop patching the old world and build the new one.
          </p>
          <p>
            Hestia Technology was founded with a single conviction: textile manufacturers don't need
            another module bolted onto a crumbling ERP. They need a purpose-built operating system
            that treats compliance as a feature, not an afterthought. One platform that connects
            the shop floor to the boardroom, from fiber intake to finished garment, with
            every data point captured, verified, and ready for any regulation the EU throws next.
          </p>
          <p>
            Based in Barcelos - the heart of Portuguese textile manufacturing - we build
            alongside the people who use our software every day. Not from a distant office.
            Not from assumptions. From the factory floor.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Values Section -->
  <section class="py-20 md:py-28">
    <div class="max-w-6xl mx-auto px-4 md:px-6">
      <div class="text-center mb-16">
        <p class="text-[11px] uppercase tracking-widest text-primary mb-4 font-heading">
          What Drives Us
        </p>
        <h2 class="text-3xl sm:text-4xl font-heading tracking-tight text-foreground mb-4">
          Our Values
        </h2>
        <p class="max-w-2xl mx-auto text-muted-foreground text-lg">
          The principles that guide every line of code we write and every relationship we build.
        </p>
      </div>

      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        <!-- Innovation -->
        <div class="group rounded-2xl border border-border/60 bg-card p-8 text-center transition-all hover:border-primary/30 hover:shadow-lg">
          <div class="w-14 h-14 rounded-xl bg-amber-500/10 flex items-center justify-center mx-auto mb-5">
            <Lightbulb className="h-7 w-7 text-amber-500" />
          </div>
          <h3 class="text-lg font-heading text-foreground mb-3">Innovation</h3>
          <p class="text-muted-foreground text-sm leading-relaxed">
            We challenge legacy thinking at every turn. New problems demand new solutions,
            not recycled features from decades-old platforms.
          </p>
        </div>

        <!-- Transparency -->
        <div class="group rounded-2xl border border-border/60 bg-card p-8 text-center transition-all hover:border-primary/30 hover:shadow-lg">
          <div class="w-14 h-14 rounded-xl bg-emerald-500/10 flex items-center justify-center mx-auto mb-5">
            <Shield className="h-7 w-7 text-emerald-500" />
          </div>
          <h3 class="text-lg font-heading text-foreground mb-3">Transparency</h3>
          <p class="text-muted-foreground text-sm leading-relaxed">
            Open pricing, honest timelines, clear communication. Our clients always know
            where they stand - no hidden fees, no fine print.
          </p>
        </div>

        <!-- Excellence -->
        <div class="group rounded-2xl border border-border/60 bg-card p-8 text-center transition-all hover:border-primary/30 hover:shadow-lg">
          <div class="w-14 h-14 rounded-xl bg-blue-500/10 flex items-center justify-center mx-auto mb-5">
            <Target className="h-7 w-7 text-blue-500" />
          </div>
          <h3 class="text-lg font-heading text-foreground mb-3">Excellence</h3>
          <p class="text-muted-foreground text-sm leading-relaxed">
            We ship software that works on the factory floor, not just in a demo.
            Reliability and precision are non-negotiable.
          </p>
        </div>

        <!-- Sustainability -->
        <div class="group rounded-2xl border border-border/60 bg-card p-8 text-center transition-all hover:border-primary/30 hover:shadow-lg">
          <div class="w-14 h-14 rounded-xl bg-rose-500/10 flex items-center justify-center mx-auto mb-5">
            <Heart className="h-7 w-7 text-rose-500" />
          </div>
          <h3 class="text-lg font-heading text-foreground mb-3">Sustainability</h3>
          <p class="text-muted-foreground text-sm leading-relaxed">
            We help manufacturers meet environmental standards not as a burden,
            but as a competitive advantage built into the platform.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Institutional Support Section -->
  <section class="py-16 md:py-20 border-y border-border/60 bg-muted/30">
    <div class="max-w-6xl mx-auto px-4 md:px-6">
      <div class="text-center mb-12">
        <p class="text-[11px] uppercase tracking-widest text-primary mb-4 font-heading">
          Backed By
        </p>
        <h2 class="text-2xl sm:text-3xl font-heading tracking-tight text-foreground">
          Institutional Support
        </h2>
      </div>

      <div class="flex flex-wrap items-center justify-center gap-12 md:gap-20">
        <div class="grayscale opacity-70 hover:grayscale-0 hover:opacity-100 transition-all duration-300">
          <Image
            src={IPCA}
            alt="IPCA - Instituto Politecnico do Cavado e do Ave"
            class="h-16 md:h-20 w-auto object-contain"
          />
        </div>
        <div class="grayscale opacity-70 hover:grayscale-0 hover:opacity-100 transition-all duration-300">
          <Image
            src={STARTIpca}
            alt="START @IPCA Incubator"
            class="h-16 md:h-20 w-auto object-contain"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Team Section -->
  <TeamSection client:load />

  <!-- Final CTA Section -->
  <section class="relative overflow-hidden py-20 md:py-28" style="background: #060E24;">
    <!-- Animated orbs -->
    <div class="absolute top-0 right-1/4 w-64 h-64 rounded-full bg-blue-500/10 blur-3xl animate-pulse"></div>
    <div class="absolute bottom-0 left-1/3 w-80 h-80 rounded-full bg-violet-500/8 blur-3xl animate-pulse" style="animation-delay: 1.5s;"></div>

    <div class="relative z-10 max-w-6xl mx-auto px-4 md:px-6 text-center">
      <p class="text-[11px] uppercase tracking-widest text-blue-400 mb-6 font-heading">
        Join Us
      </p>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-heading tracking-tight text-white mb-6">
        Want to Be Part of Our Story?
      </h2>
      <p class="max-w-2xl mx-auto text-lg text-slate-400 leading-relaxed mb-10">
        We are building the future of manufacturing software from Barcelos, Portugal.
        Whether you are a factory looking for a better system, a talented engineer
        who wants to solve real problems, or a partner who shares our vision -
        we want to hear from you.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <GoogleCalendarButton client:load size="lg" className="px-8 bg-white text-[#060E24] hover:bg-slate-100">
          Book a Conversation
          <ArrowRight className="ml-2 h-4 w-4" />
        </GoogleCalendarButton>
        <a href="mailto:contact@hestiatechnology.pt">
          <Button variant="outline" size="lg" className="px-8 border-slate-600 text-slate-300 hover:bg-slate-800 hover:text-white w-full">
            Get in Touch
          </Button>
        </a>
      </div>
    </div>
  </section>

</Layout>
