---
import { Badge } from "@/components/ui/badge";
import { Button } from "@/components/ui/button";
import {
  Card,
  CardContent,
  CardDescription,
  CardHeader,
  CardTitle,
} from "@/components/ui/card";
import { Avatar, AvatarFallback, AvatarImage } from "@/components/ui/avatar";
import { Separator } from "@/components/ui/separator";
import Layout from "@/layouts/Layout.astro";
import IPCA from "@/assets/ipca_cor.png";
import TeamSection from "@/components/TeamSection.en";
---

<Layout title="About Us">
  <section
    class="py-12 md:py-24 lg:py-32"
  >
    <div class="px-4 md:px-6">
      <div class="text-center mb-12">
        <Badge
          variant="outline"
          className="w-fit h-fit mb-4 border"
        >
          🏢 About Us
        </Badge>
        <h1
          class="text-3xl font-bold tracking-tighter sm:text-5xl text-foreground mb-4"
        >
          Building the Factory Operating System
        </h1>
        <p class="max-w-[900px] mx-auto text-muted-foreground md:text-xl">
          Legacy systems are costing textile manufacturers their profits and their
          future. We are here to change that.
        </p>
      </div>
    </div>
  </section>

  <!-- Mission & Vision -->

    <section class="py-12 md:py-24">

      <div class="px-4 md:px-6">

        <div class="grid gap-8 md:grid-cols-2 max-w-6xl mx-auto">

          <Card className="border">

            <CardHeader>

              <div

                class="w-16 h-16 border flex items-center justify-center mb-4"

              >

                <span class="text-3xl">🎯</span>

              </div>

              <CardTitle className="text-2xl">Our Mission</CardTitle>

            </CardHeader>

            <CardContent>

              <CardDescription className="text-base leading-relaxed">

                To build the factory operating system that automates EU compliance

                and production tracking, replacing costly and unreliable legacy systems.

              </CardDescription>

            </CardContent>

          </Card>

  

          <Card className="border">

            <CardHeader>

              <div

                class="w-16 h-16 border flex items-center justify-center mb-4"

              >

                <span class="text-3xl">🔮</span>

              </div>

              <CardTitle className="text-2xl">Our Vision</CardTitle>

            </CardHeader>

            <CardContent>

              <CardDescription className="text-base leading-relaxed">

                To become the standard operating system for EU manufacturing,

                starting with the Portuguese textile market and expanding across

                European industry.

              </CardDescription>

            </CardContent>

          </Card>

        </div>

      </div>

    </section>

  

    <!-- Values Section -->
  <section class="py-12 md:py-24">
    <div class="px-4 md:px-6">
      <div class="text-center mb-12">
        <h2
          class="text-2xl font-bold tracking-tighter sm:text-4xl text-foreground mb-4"
        >
          Our Values
        </h2>
        <p class="max-w-[700px] mx-auto text-muted-foreground">
          Principles that guide our development of SaaS solutions and our relationship with clients and partners.
        </p>
      </div>

      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4 max-w-6xl mx-auto">
        <Card className="text-center border">
          <CardHeader>
            <div
              class="w-12 h-12 border flex items-center justify-center mx-auto mb-2"
            >
              <span class="text-2xl">💡</span>
            </div>
            <CardTitle className="text-lg">Innovation</CardTitle>
          </CardHeader>
          <CardContent>
            <CardDescription>
              We constantly seek new ways to solve problems and create value.
            </CardDescription>
          </CardContent>
        </Card>

        <Card className="text-center border">
          <CardHeader>
            <div
              class="w-12 h-12 border flex items-center justify-center mx-auto mb-2"
            >
              <span class="text-2xl">🤝</span>
            </div>
            <CardTitle className="text-lg">Transparency</CardTitle>
          </CardHeader>
          <CardContent>
            <CardDescription>
              Open and honest communication in all our relationships.
            </CardDescription>
          </CardContent>
        </Card>

        <Card className="text-center border">
          <CardHeader>
            <div
              class="w-12 h-12 border flex items-center justify-center mx-auto mb-2"
            >
              <span class="text-2xl">🎯</span>
            </div>
            <CardTitle className="text-lg">Excellence</CardTitle>
          </CardHeader>
          <CardContent>
            <CardDescription>
              Commitment to quality in everything we do.
            </CardDescription>
          </CardContent>
        </Card>

        <Card className="text-center border">
          <CardHeader>
            <div
              class="w-12 h-12 border flex items-center justify-center mx-auto mb-2"
            >
              <span class="text-2xl">🌱</span>
            </div>
            <CardTitle className="text-lg">Sustainability</CardTitle>
          </CardHeader>
          <CardContent>
            <CardDescription>
              Social and environmental responsibility in all our operations.
            </CardDescription>
          </CardContent>
        </Card>
      </div>
    </div>
  </section>

  <!-- Founder Story -->
  <section class="py-12 md:py-24 bg-muted/20 border-y border-border/60">
    <div class="px-4 md:px-6">
      <div class="max-w-3xl mx-auto text-center space-y-6">
        <p class="text-[11px] font-bold uppercase tracking-widest text-primary">Our Story</p>
        <h2 class="text-2xl font-bold tracking-tighter sm:text-4xl text-foreground">
          Born from Frustration with Legacy Systems
        </h2>
        <p class="text-muted-foreground md:text-lg leading-relaxed">
          We saw textile manufacturers struggling with legacy systems that couldn't keep up with EU regulations. Expensive consultants for every update. No real-time visibility. Zero DPP support. So we built what they actually need — a factory operating system.
        </p>
      </div>
    </div>
  </section>

  <!-- Team Section -->
  <TeamSection client:load />

  <!-- CTA Section -->
  <section class="py-12 md:py-24">
    <div class="px-4 md:px-6">
      <Card className="border">
        <CardContent className="p-8 md:p-12 text-center">
          <h2
            class="text-2xl font-bold tracking-tighter sm:text-4xl text-foreground mb-4"
          >
            Want to Be Part of Our Story?
          </h2>
          <p class="max-w-[600px] mx-auto text-muted-foreground mb-8">
            We are always looking for exceptional talent and partners who
            share our vision. Join us!
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <Button variant="outline" size="lg" className="px-8">
              See Opportunities
            </Button>
            <Button
              variant="outline"
              size="lg"
              className="px-8"
            >
              Contact Us
            </Button>
          </div>
        </CardContent>
      </Card>
    </div>
  </section>
</Layout>