---
import { Badge } from "@/components/ui/badge";
import { Button } from "@/components/ui/button";
import {
  Card,
  CardContent,
  CardDescription,
  CardHeader,
  CardTitle,
} from "@/components/ui/card";
import { Avatar, AvatarFallback, AvatarImage } from "@/components/ui/avatar";
import { Separator } from "@/components/ui/separator";
import Layout from "@/layouts/Layout.astro";
import IPCA from "@/assets/ipca_cor.png";
import TeamSection from "@/components/TeamSection.en";
---

<Layout title="About Us">
  <section
    class="py-12 md:py-24 lg:py-32"
  >
    <div class="px-4 md:px-6">
      <div class="text-center mb-12">
        <Badge
          variant="outline"
          className="w-fit h-fit mb-4 border"
        >
          🏢 About Us
        </Badge>
        <h1
          class="text-3xl font-bold tracking-tighter sm:text-5xl text-foreground mb-4"
        >
          Replacing Legacy ERPs for Textile Manufacturers
        </h1>
        <p class="max-w-[900px] mx-auto text-muted-foreground md:text-xl">
          Legacy ERPs are costing textile manufacturers their profits and their
          future. We are here to change that.
        </p>
      </div>
    </div>
  </section>

  <!-- Mission & Vision -->
  <section class="py-12 md:py-24">
    <div class="px-4 md:px-6">
      <div class="grid gap-8 md:grid-cols-2 max-w-6xl mx-auto">
        <Card className="border">
          <CardHeader>
            <div
              class="w-16 h-16 border flex items-center justify-center mb-4"
            >
              <span class="text-3xl">🎯</span>
            </div>
            <CardTitle className="text-2xl">Our Mission</CardTitle>
          </CardHeader>
          <CardContent>
            <CardDescription className="text-base leading-relaxed">
              To automate EU compliance and production tracking for textile
              manufacturers, replacing costly and unreliable legacy systems.
            </CardDescription>
          </CardContent>
        </Card>

        <Card className="border">
          <CardHeader>
            <div
              class="w-16 h-16 border flex items-center justify-center mb-4"
            >
              <span class="text-3xl">🔮</span>
            </div>
            <CardTitle className="text-2xl">Our Vision</CardTitle>
          </CardHeader>
          <CardContent>
            <CardDescription className="text-base leading-relaxed">
              To become the standard for EU manufacturing, starting by
              dominating the Portuguese textile market and then conquering EU
              textiles.
            </CardDescription>
          </CardContent>
        </Card>
      </div>
    </div>
  </section>

  <!-- Company Story -->
  <section class="py-12 md:py-24">
    <div class="px-4 md:px-6">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-12">
          <h2
            class="text-2xl font-bold tracking-tighter sm:text-4xl text-foreground mb-4"
          >
            Our Journey
          </h2>
          <p class="text-muted-foreground">
            From idea to execution: our story of innovation in SaaS and ERP
          </p>
        </div>

        <div class="space-y-8">
          <Card className="border">
            <CardContent className="p-6">
              <div class="flex items-start gap-4">
                <Badge variant="secondary" className="mt-1 border">2025</Badge>
                <div>
                  <h3 class="font-semibold text-lg mb-2">Strong Market Demand</h3>
                  <p class="text-muted-foreground">
                    20 Manufacturers Ready to Adopt Hestia. €132k+ in Pipeline
                    ARR.
                  </p>
                </div>
              </div>
            </CardContent>
          </Card>

          <Card className="border">
            <CardContent className="p-6">
              <div class="flex items-start gap-4">
                <Badge className="mt-1 border">2026</Badge>
                <div>
                  <h3 class="font-semibold text-lg mb-2">
                    First Pilot Deployment
                  </h3>
                  <p class="text-muted-foreground">
                    First Pilot deployment in Q1 2026.
                  </p>
                </div>
              </div>
            </CardContent>
          </Card>
        </div>
      </div>
    </div>
  </section>

  <!-- Team Section -->
  <section class="py-12 md:py-24">
    <div class="px-4 md:px-6">
      <div class="text-center mb-12">
        <h2
          class="text-2xl font-bold tracking-tighter sm:text-4xl text-foreground mb-4"
        >
          Our Team
        </h2>
        <p class="max-w-[700px] mx-auto text-muted-foreground">
          Meet the experts in SaaS and ERP who are transforming business management.
        </p>
      </div>

      <TeamSection client:load />
    </div>
  </section>

  

  <!-- Values Section -->
  <section class="py-12 md:py-24">
    <div class="px-4 md:px-6">
      <div class="text-center mb-12">
        <h2
          class="text-2xl font-bold tracking-tighter sm:text-4xl text-foreground mb-4"
        >
          Our Values
        </h2>
        <p class="max-w-[700px] mx-auto text-muted-foreground">
          Principles that guide our development of SaaS solutions and our relationship with clients and partners.
        </p>
      </div>

      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4 max-w-6xl mx-auto">
        <Card className="text-center border">
          <CardHeader>
            <div
              class="w-12 h-12 border flex items-center justify-center mx-auto mb-2"
            >
              <span class="text-2xl">💡</span>
            </div>
            <CardTitle className="text-lg">Innovation</CardTitle>
          </CardHeader>
          <CardContent>
            <CardDescription>
              We constantly seek new ways to solve problems and create value.
            </CardDescription>
          </CardContent>
        </Card>

        <Card className="text-center border">
          <CardHeader>
            <div
              class="w-12 h-12 border flex items-center justify-center mx-auto mb-2"
            >
              <span class="text-2xl">🤝</span>
            </div>
            <CardTitle className="text-lg">Transparency</CardTitle>
          </CardHeader>
          <CardContent>
            <CardDescription>
              Open and honest communication in all our relationships.
            </CardDescription>
          </CardContent>
        </Card>

        <Card className="text-center border">
          <CardHeader>
            <div
              class="w-12 h-12 border flex items-center justify-center mx-auto mb-2"
            >
              <span class="text-2xl">🎯</span>
            </div>
            <CardTitle className="text-lg">Excellence</CardTitle>
          </CardHeader>
          <CardContent>
            <CardDescription>
              Commitment to quality in everything we do.
            </CardDescription>
          </CardContent>
        </Card>

        <Card className="text-center border">
          <CardHeader>
            <div
              class="w-12 h-12 border flex items-center justify-center mx-auto mb-2"
            >
              <span class="text-2xl">🌱</span>
            </div>
            <CardTitle className="text-lg">Sustainability</CardTitle>
          </CardHeader>
          <CardContent>
            <CardDescription>
              Social and environmental responsibility in all our operations.
            </CardDescription>
          </CardContent>
        </Card>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-12 md:py-24">
    <div class="px-4 md:px-6">
      <Card className="border">
        <CardContent className="p-8 md:p-12 text-center">
          <h2
            class="text-2xl font-bold tracking-tighter sm:text-4xl text-foreground mb-4"
          >
            Want to Be Part of Our Story?
          </h2>
          <p class="max-w-[600px] mx-auto text-muted-foreground mb-8">
            We are always looking for exceptional talent and partners who
            share our vision. Join us!
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <Button variant="outline" size="lg" className="px-8">
              See Opportunities
            </Button>
            <Button
              variant="outline"
              size="lg"
              className="px-8"
            >
              Contact Us
            </Button>
          </div>
        </CardContent>
      </Card>
    </div>
  </section>
</Layout>