---
import Layout from "@/layouts/Layout.astro";
import { Button } from "@/components/ui/button";
import { GoogleCalendarButton } from "@/components/GoogleCalendarButton";
import {
  Check, ArrowRight, Factory, ShieldCheck, Cpu,
  BarChart3, Zap, Globe, FileText, Plug, ScanLine,
  Layers, Smartphone, CloudCog, Lock, Users, Eye, Workflow
} from "lucide-react";

const coreFeatures = [
  {
    Icon: Factory,
    title: "Production Management",
    desc: "End-to-end visibility from raw material intake to finished garment. Track every order, every machine, every operator - in real time.",
    highlights: ["Order tracking", "Machine monitoring", "Operator performance"],
  },
  {
    Icon: ShieldCheck,
    title: "EU Compliance Engine",
    desc: "Stay ahead of ESPR, CSRD, and evolving EU textile regulations. Automated audit trails and compliance reports, always up to date.",
    highlights: ["ESPR-ready", "Automated audits", "Regulation updates"],
  },
  {
    Icon: FileText,
    title: "Digital Product Passports",
    desc: "Generate DPPs for every product automatically. Full material traceability, sustainability data, and QR-code access for consumers.",
    highlights: ["Auto-generation", "Full traceability", "QR access"],
  },
  {
    Icon: BarChart3,
    title: "AI Analytics",
    desc: "Predictive insights that reduce waste, optimize scheduling, and flag issues before they become problems. Your factory, but smarter.",
    highlights: ["Waste reduction", "Smart scheduling", "Anomaly detection"],
  },
  {
    Icon: Plug,
    title: "IoT Integration",
    desc: "Connect looms, cutting machines, and sensors directly to Hestia. Real-time data flows from every corner of your shop floor.",
    highlights: ["Machine connectivity", "Sensor data", "Real-time feeds"],
  },
  {
    Icon: Layers,
    title: "Inventory & Supply Chain",
    desc: "From yarn cones to finished pallets - full inventory control with supplier management, automated reordering, and stock alerts.",
    highlights: ["Stock tracking", "Supplier management", "Auto reordering"],
  },
];

const additionalFeatures = [
  { title: "IoT Integration", desc: "Connect your machines directly to Hestia for real-time data.", Icon: Cpu },
  { title: "Predictive Analytics", desc: "Anticipate failures and maintenance needs with AI.", Icon: BarChart3 },
  { title: "Cloud Access", desc: "Access your data anywhere, anytime, securely.", Icon: CloudCog },
  { title: "Mobile App", desc: "Shop floor management via native iOS and Android app.", Icon: Smartphone },
  { title: "Data Security", desc: "End-to-end encryption and automatic backups.", Icon: Lock },
  { title: "Fast Implementation", desc: "Get started in weeks, not months, with assisted onboarding.", Icon: Zap },
  { title: "Inventory Management", desc: "Full inventory control, from yarn to final garment.", Icon: Layers },
  { title: "Multi-Language", desc: "Native support for multiple languages and currencies.", Icon: Globe },
];

const stats = [
  { value: "2–4", unit: "weeks", label: "Average deployment time" },
  { value: "99.9", unit: "%", label: "Platform uptime SLA" },
  { value: "27", unit: "EU countries", label: "Compliance coverage" },
  { value: "€99", unit: "/mo", label: "Starting price" },
];

const architectureLayers = [
  {
    label: "Intelligence Layer",
    color: "from-[#6B8BF5] to-[#A78BFA]",
    items: ["AI Analytics", "Predictive Maintenance", "Demand Forecasting", "Anomaly Detection"],
  },
  {
    label: "Built-in Capabilities",
    color: "from-primary to-[#6B8BF5]",
    items: ["Digital Product Passports", "EU Compliance Engine", "IoT Connectivity", "Supply Chain"],
  },
  {
    label: "Hestia Core",
    color: "from-[#1a2744] to-[#0D1A3A]",
    items: ["Production Management", "Inventory", "Order Tracking", "User & Access Control"],
  },
];
---

<Layout title="Capabilities - Hestia" darkHero={true}>
  <div class="flex flex-col min-h-screen">

    <!-- ══════════════════════════════════════════════════ -->
    <!-- ── HERO - Cinematic dark section ── -->
    <!-- ══════════════════════════════════════════════════ -->
    <section class="relative min-h-[70vh] flex items-center overflow-hidden bg-[#060E24]">
      <!-- Animated gradient orbs -->
      <div class="absolute inset-0 overflow-hidden pointer-events-none">
        <div class="absolute top-1/3 left-1/5 w-[500px] h-[500px] bg-primary/20 rounded-full blur-[120px] animate-pulse-glow"></div>
        <div class="absolute bottom-1/4 right-1/5 w-[400px] h-[400px] bg-[#6B8BF5]/15 rounded-full blur-[100px] animate-pulse-glow [animation-delay:2s]"></div>
        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[300px] h-[300px] bg-[#A78BFA]/10 rounded-full blur-[80px] animate-pulse-glow [animation-delay:3.5s]"></div>
      </div>
      <!-- Grid overlay -->
      <div class="absolute inset-0 opacity-[0.03]" style="background-image: linear-gradient(to right, white 1px, transparent 1px), linear-gradient(to bottom, white 1px, transparent 1px); background-size: 48px 48px;"></div>

      <div class="container relative mx-auto px-4 md:px-6 max-w-6xl py-24 md:py-32">
        <div class="max-w-3xl">
          <!-- Badge -->
          <div class="inline-flex items-center gap-2.5 text-xs font-bold uppercase tracking-widest text-white/70 bg-white/[0.06] px-4 py-2 rounded-full border border-white/10 mb-8 animate-fade-up backdrop-blur-sm">
            <span class="relative flex h-2 w-2">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-primary opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-primary"></span>
            </span>
            Platform Capabilities
          </div>

          <h1 class="font-heading text-5xl sm:text-6xl md:text-7xl font-extrabold tracking-tight leading-[0.95] text-white mb-6 animate-fade-up [animation-delay:150ms]">
            Every layer your<br/>
            <span class="text-gradient bg-gradient-to-r from-[#6B8BF5] via-[#A78BFA] to-[#6B8BF5] bg-[length:200%_auto] animate-gradient-x">factory needs</span>
          </h1>

          <p class="text-lg md:text-xl text-white/50 leading-relaxed max-w-2xl mb-10 animate-fade-up [animation-delay:300ms]">
            From the shop floor to EU compliance - Hestia provides a complete operating system designed specifically for modern textile manufacturers.
          </p>

          <div class="flex flex-col sm:flex-row gap-3 animate-fade-up [animation-delay:450ms]">
            <Button size="lg" className="rounded-lg bg-white text-[#060E24] hover:bg-white/90 font-semibold gap-2 text-base px-7" asChild>
              <a href={`/${Astro.currentLocale}/contact`}>
                Schedule Demo <ArrowRight className="w-4 h-4" />
              </a>
            </Button>
            <Button size="lg" variant="outline" className="rounded-lg border-white/20 text-white hover:bg-white/10 font-semibold text-base px-7" asChild>
              <a href={`/${Astro.currentLocale}/prices`}>View Pricing</a>
            </Button>
          </div>
        </div>
      </div>
    </section>

    <!-- ══════════════════════════════════════════════════ -->
    <!-- ── CORE CAPABILITIES - 6 feature cards ── -->
    <!-- ══════════════════════════════════════════════════ -->
    <section class="py-20 md:py-28 border-b border-border/60">
      <div class="container mx-auto px-4 md:px-6 max-w-6xl">
        <div class="mb-16 max-w-2xl">
          <p class="text-[11px] font-bold uppercase tracking-widest text-primary mb-4">Core Capabilities</p>
          <h2 class="font-heading text-4xl md:text-5xl font-bold tracking-tight leading-tight mb-5">
            Built for textile. Built for compliance.
          </h2>
          <p class="text-lg text-muted-foreground leading-relaxed">
            Six pillars that cover every critical function of your factory - from production lines to EU regulations.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {coreFeatures.map(({ Icon, title, desc, highlights }) => (
            <div class="group relative border border-border rounded-2xl p-8 bg-card hover:border-primary/50 hover:shadow-lg transition-all duration-300">
              <div class="w-12 h-12 bg-primary/10 rounded-xl flex items-center justify-center mb-6 text-primary group-hover:bg-primary group-hover:text-white transition-all duration-300">
                <Icon className="w-6 h-6" />
              </div>
              <h3 class="font-heading text-xl font-bold mb-3">{title}</h3>
              <p class="text-muted-foreground text-sm leading-relaxed mb-5">{desc}</p>
              <div class="flex flex-wrap gap-2">
                {highlights.map((h: string) => (
                  <span class="inline-flex items-center gap-1.5 text-xs font-medium text-primary bg-primary/8 px-2.5 py-1 rounded-full">
                    <Check className="w-3 h-3" /> {h}
                  </span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ══════════════════════════════════════════════════ -->
    <!-- ── PLATFORM ARCHITECTURE ── -->
    <!-- ══════════════════════════════════════════════════ -->
    <section class="py-20 md:py-28 bg-muted/30 border-b border-border/60">
      <div class="container mx-auto px-4 md:px-6 max-w-6xl">
        <div class="text-center mb-16 max-w-2xl mx-auto">
          <p class="text-[11px] font-bold uppercase tracking-widest text-primary mb-4">Platform Architecture</p>
          <h2 class="font-heading text-4xl md:text-5xl font-bold tracking-tight leading-tight mb-5">
            Three layers. One platform.
          </h2>
          <p class="text-lg text-muted-foreground leading-relaxed">
            Hestia's architecture stacks intelligence on top of built-in capabilities, all running on a rock-solid core.
          </p>
        </div>

        <div class="max-w-3xl mx-auto space-y-4">
          <!-- Intelligence Layer -->
          <div class="relative rounded-2xl border border-[#6B8BF5]/30 bg-gradient-to-r from-[#6B8BF5]/10 to-[#A78BFA]/10 p-8 backdrop-blur-sm">
            <div class="flex items-center gap-3 mb-4">
              <div class="w-3 h-3 rounded-full bg-gradient-to-r from-[#6B8BF5] to-[#A78BFA]"></div>
              <span class="text-xs font-bold uppercase tracking-widest text-[#6B8BF5]">Intelligence Layer</span>
            </div>
            <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
              {architectureLayers[0].items.map((item: string) => (
                <div class="text-sm font-medium text-foreground/80 bg-white/60 dark:bg-white/5 rounded-lg px-3 py-2 text-center border border-[#6B8BF5]/15">
                  {item}
                </div>
              ))}
            </div>
          </div>

          <!-- Arrow -->
          <div class="flex justify-center">
            <div class="w-px h-6 bg-border"></div>
          </div>

          <!-- Built-in Capabilities -->
          <div class="relative rounded-2xl border border-primary/30 bg-gradient-to-r from-primary/10 to-[#6B8BF5]/10 p-8">
            <div class="flex items-center gap-3 mb-4">
              <div class="w-3 h-3 rounded-full bg-gradient-to-r from-primary to-[#6B8BF5]"></div>
              <span class="text-xs font-bold uppercase tracking-widest text-primary">Built-in Capabilities</span>
            </div>
            <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
              {architectureLayers[1].items.map((item: string) => (
                <div class="text-sm font-medium text-foreground/80 bg-white/60 dark:bg-white/5 rounded-lg px-3 py-2 text-center border border-primary/15">
                  {item}
                </div>
              ))}
            </div>
          </div>

          <!-- Arrow -->
          <div class="flex justify-center">
            <div class="w-px h-6 bg-border"></div>
          </div>

          <!-- Hestia Core -->
          <div class="relative rounded-2xl border border-border bg-[#060E24] p-8 text-white">
            <div class="flex items-center gap-3 mb-4">
              <div class="w-3 h-3 rounded-full bg-white/40"></div>
              <span class="text-xs font-bold uppercase tracking-widest text-white/60">Hestia Core</span>
            </div>
            <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
              {architectureLayers[2].items.map((item: string) => (
                <div class="text-sm font-medium text-white/80 bg-white/8 rounded-lg px-3 py-2 text-center border border-white/10">
                  {item}
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ══════════════════════════════════════════════════ -->
    <!-- ── ADDITIONAL FEATURES - 8-item grid ── -->
    <!-- ══════════════════════════════════════════════════ -->
    <section class="py-20 md:py-28 border-b border-border/60">
      <div class="container mx-auto px-4 md:px-6 max-w-6xl">
        <div class="mb-14">
          <p class="text-[11px] font-bold uppercase tracking-widest text-primary mb-4">Additional Features</p>
          <h2 class="font-heading text-3xl md:text-4xl font-bold leading-tight mb-3">More than just the basics</h2>
          <p class="text-muted-foreground text-sm max-w-lg">Details that make the difference in day-to-day operations.</p>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
          {additionalFeatures.map(({ title, desc, Icon }) => (
            <div class="border border-border rounded-2xl p-6 bg-card hover:border-primary/50 hover:shadow-sm transition-all group">
              <div class="w-10 h-10 bg-primary/10 rounded-xl flex items-center justify-center mb-5 text-primary group-hover:bg-primary group-hover:text-white transition-all duration-200">
                <Icon className="w-5 h-5" />
              </div>
              <h3 class="font-heading font-bold mb-2">{title}</h3>
              <p class="text-sm text-muted-foreground leading-relaxed">{desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ══════════════════════════════════════════════════ -->
    <!-- ── NUMBERS THAT MATTER ── -->
    <!-- ══════════════════════════════════════════════════ -->
    <section class="py-20 md:py-28 bg-muted/30 border-b border-border/60">
      <div class="container mx-auto px-4 md:px-6 max-w-6xl">
        <div class="text-center mb-16">
          <p class="text-[11px] font-bold uppercase tracking-widest text-primary mb-4">Numbers That Matter</p>
          <h2 class="font-heading text-4xl md:text-5xl font-bold tracking-tight leading-tight">
            Built to perform at scale
          </h2>
        </div>

        <div class="grid grid-cols-2 lg:grid-cols-4 gap-6">
          {stats.map(({ value, unit, label }) => (
            <div class="text-center p-8 rounded-2xl border border-border bg-card">
              <div class="font-heading text-5xl md:text-6xl font-extrabold tracking-tight text-foreground mb-1">
                {value}<span class="text-primary text-3xl md:text-4xl">{unit}</span>
              </div>
              <p class="text-sm text-muted-foreground font-medium mt-2">{label}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ══════════════════════════════════════════════════ -->
    <!-- ── CTA - Dark urgency section ── -->
    <!-- ══════════════════════════════════════════════════ -->
    <section class="relative overflow-hidden bg-[#060E24] text-white py-24 md:py-32">
      <!-- Background orbs -->
      <div class="absolute inset-0 overflow-hidden pointer-events-none">
        <div class="absolute top-1/2 left-1/3 w-[400px] h-[400px] bg-primary/15 rounded-full blur-[100px] animate-pulse-glow"></div>
        <div class="absolute bottom-1/3 right-1/4 w-[300px] h-[300px] bg-[#A78BFA]/10 rounded-full blur-[80px] animate-pulse-glow [animation-delay:2s]"></div>
      </div>

      <div class="container relative mx-auto px-4 md:px-6 max-w-6xl text-center">
        <!-- Urgency badge -->
        <div class="inline-flex items-center gap-2.5 text-xs font-bold uppercase tracking-widest text-white/70 bg-white/[0.06] px-4 py-2 rounded-full border border-white/10 mb-8 backdrop-blur-sm">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-amber-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-amber-400"></span>
          </span>
          ESPR Deadline: 2027
        </div>

        <h2 class="font-heading text-4xl md:text-5xl lg:text-6xl font-extrabold tracking-tight leading-[1] mb-6 max-w-3xl mx-auto">
          The deadline is set.<br/>
          <span class="text-gradient bg-gradient-to-r from-[#6B8BF5] via-[#A78BFA] to-[#6B8BF5] bg-[length:200%_auto] animate-gradient-x">Is your factory ready?</span>
        </h2>

        <p class="text-lg text-white/50 leading-relaxed max-w-xl mx-auto mb-10">
          Digital Product Passports become mandatory in 2027. Factories that start now will lead. Those that wait will scramble. The choice is yours.
        </p>

        <div class="flex flex-col sm:flex-row justify-center gap-4">
          <GoogleCalendarButton client:load size="lg" className="rounded-lg bg-white text-[#060E24] hover:bg-white/90 font-semibold gap-2 text-base px-8 h-12" />
          <Button size="lg" variant="outline" className="rounded-lg border-white/20 text-white hover:bg-white/10 font-semibold text-base px-8 h-12" asChild>
            <a href={`/${Astro.currentLocale}/prices`}>
              View Pricing <ArrowRight className="w-4 h-4 ml-2" />
            </a>
          </Button>
        </div>

        <p class="text-xs text-white/30 mt-6">No credit card required. Free onboarding included.</p>
      </div>
    </section>

  </div>
</Layout>
