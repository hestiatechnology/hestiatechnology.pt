---
import Layout from "@/layouts/Layout.astro";
import { actions } from "astro:actions";
import { ContactForm } from "@/components/ContactForm";
import { Mail, Phone, MapPin } from "lucide-react";
import { GoogleCalendarButton } from "@/components/GoogleCalendarButton";

export const prerender = false;

let captchaError = "";

if (Astro.request.method === "POST") {
  try {
    const formData = await Astro.request.formData();

    const captchaToken = formData.get("h-captcha-response");

    const captchaVerify = await fetch("https://api.hcaptcha.com/siteverify", {
      method: "POST",
      headers: { "Content-Type": "application/x-www-form-urlencoded" },
      body: new URLSearchParams({
        secret: import.meta.env.HCAPTCHA_SECRET_KEY,
        response: captchaToken?.toString() || "",
        remoteip: Astro.request.headers.get("x-forwarded-for") || "",
        sitekey: "22ee0f18-378a-46ce-9246-473c5c64bd9a",
      }),
    });

    const captchaResult = await captchaVerify.json();

    console.log("hCaptcha result:", captchaResult);

    if (!captchaResult.success) {
      captchaError = "Captcha failed. Please try again.";
    } else {
      const { data, error } = await Astro.callAction(actions.email, formData);
      return Astro.redirect(`/${Astro.currentLocale}/contact?submitted=true`);
    }
  } catch (error) {
    if (error instanceof Error) {
      captchaError = "An error occurred. Please try again.";
      console.error(error.message);
    }
  }
}

const labels = {
  company: "Company",
  email: "Email",
  phone: "Phone (Optional)",
  topic: "Topic",
  message: "Message",
  submit: "Send Message",
  selectPlaceholder: "Select a topic",
  topics: {
    sales: "Sales",
    support: "Support",
    partnership: "Partnership",
    other: "Other",
  },
};
---

<Layout title="Contact — Hestia">
  <div class="flex flex-col min-h-screen">

    <!-- ── Hero ── -->
    <section class="pt-20 pb-16 md:pt-28 md:pb-20 border-b border-border/60">
      <div class="container mx-auto px-4 md:px-6 max-w-6xl">
        <div class="max-w-2xl">
          <p class="text-[11px] font-bold uppercase tracking-widest text-primary mb-4">Contact</p>
          <h1 class="font-heading text-5xl md:text-6xl font-bold tracking-tight leading-tight mb-5">
            Get in Touch
          </h1>
          <p class="text-lg text-muted-foreground leading-relaxed">
            Have a question or want to schedule a demo? Our team is ready to help.
          </p>
        </div>
      </div>
    </section>

    <!-- ── Contact body ── -->
    <section class="py-16 md:py-20 flex-1">
      <div class="container mx-auto px-4 md:px-6 max-w-6xl">
        <div class="grid lg:grid-cols-[1fr,1.5fr] gap-12 lg:gap-16">

          <!-- Left: info -->
          <div class="space-y-10">
            <div>
              <h2 class="font-heading text-2xl font-bold mb-3">Contact Us</h2>
              <p class="text-muted-foreground text-sm leading-relaxed">
                Fill out the form and we'll get back to you as soon as possible.
              </p>
            </div>

            <div class="space-y-6">
              <div class="flex items-start gap-4">
                <div class="w-10 h-10 bg-primary/10 rounded-xl flex items-center justify-center shrink-0 text-primary">
                  <Mail class="w-5 h-5" />
                </div>
                <div>
                  <h3 class="font-heading font-bold text-sm mb-0.5">Email</h3>
                  <p class="text-xs text-muted-foreground leading-relaxed">General inquiries and support</p>
                  <a href="mailto:info@hestiatechnology.pt" class="text-sm font-medium text-foreground hover:text-primary transition-colors mt-1 inline-block">
                    info@hestiatechnology.pt
                  </a>
                </div>
              </div>

              <div class="flex items-start gap-4">
                <div class="w-10 h-10 bg-primary/10 rounded-xl flex items-center justify-center shrink-0 text-primary">
                  <Phone class="w-5 h-5" />
                </div>
                <div>
                  <h3 class="font-heading font-bold text-sm mb-0.5">Phone</h3>
                  <p class="text-xs text-muted-foreground leading-relaxed">Mon-Fri, 9am to 6pm</p>
                  <a href="tel:+351928251008" class="text-sm font-medium text-foreground hover:text-primary transition-colors mt-1 inline-block">
                    +351 928 251 008
                  </a>
                </div>
              </div>

              <div class="flex items-start gap-4">
                <div class="w-10 h-10 bg-primary/10 rounded-xl flex items-center justify-center shrink-0 text-primary">
                  <MapPin class="w-5 h-5" />
                </div>
                <div>
                  <h3 class="font-heading font-bold text-sm mb-0.5">Office</h3>
                  <p class="text-xs text-muted-foreground leading-relaxed whitespace-pre-line">Incubadora IPCA, Campus do IPCA
Lugar do Aldão, 4750-810 Barcelos
Portugal</p>
                </div>
              </div>
            </div>

            <!-- Schedule a call -->
            <div class="border border-border rounded-2xl p-6 bg-muted/20 space-y-3">
              <h3 class="font-heading font-bold text-sm">Prefer a call?</h3>
              <p class="text-xs text-muted-foreground leading-relaxed">
                Schedule a free 30-minute demo with our team.
              </p>
              <GoogleCalendarButton client:load label="Schedule a Demo" size="default" />
            </div>
          </div>

          <!-- Right: form -->
          <div class="bg-card border border-border rounded-2xl p-8">
            <h2 class="font-heading text-xl font-bold mb-6">Send us a message</h2>
            {captchaError && (
              <div class="bg-destructive/10 text-destructive text-sm p-3 rounded-xl mb-5 border border-destructive/20">
                {captchaError}
              </div>
            )}
            <ContactForm
              client:load
              labels={labels}
              siteKey="22ee0f18-378a-46ce-9246-473c5c64bd9a"
            />
          </div>

        </div>
      </div>
    </section>

  </div>
</Layout>
