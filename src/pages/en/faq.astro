---
import Layout from "@/layouts/Layout.astro";
import FAQ from "@/components/FAQ";
import { Button } from "@/components/ui/button";

const faqs = [
  {
    question: "How long does implementation take?",
    answer: "Most clients start seeing value in 2-4 weeks. Our assisted implementation ensures data is migrated and the team is trained quickly."
  },
  {
    question: "Does Hestia work with my current machines?",
    answer: "Yes, Hestia is compatible with most modern industrial machines via standard protocols (OPC UA, MQTT). For older machines, we have IoT hardware partners for retrofitting."
  },
  {
    question: "Is my data secure?",
    answer: "Absolutely. We use bank-level encryption, automatic daily backups, and hosting on secure EU servers, fully GDPR compliant."
  },
  {
    question: "Can I export my data if I cancel?",
    answer: "Yes, the data is yours. You can export your entire database in standard formats (CSV, JSON, Excel) at any time."
  },
  {
    question: "What is included in support?",
    answer: "All plans include email and chat support. The Growth plan includes priority support, and the Enterprise plan includes a dedicated account manager."
  }
];
---

<Layout title="FAQ - Hestia">
  <div class="min-h-screen bg-muted/30">
    <div class="container mx-auto px-4 md:px-6 py-20 md:py-32 max-w-3xl">
      <div class="text-center mb-12">
        <h1 class="text-4xl md:text-5xl tracking-tight text-foreground mb-4">
          Frequently Asked Questions
        </h1>
        <p class="text-muted-foreground text-lg">
          Answers to common questions about Hestia.
        </p>
      </div>

      <FAQ client:load items={faqs} />

      <div class="mt-12 text-center">
        <p class="text-muted-foreground mb-4">Still have questions?</p>
        <Button size="lg">
            <a href={`/${Astro.currentLocale}/contact`}>Talk to Team</a>
        </Button>
      </div>
    </div>
  </div>
</Layout>
