---
import { Badge } from "@/components/ui/badge";
import Layout from "@/layouts/Layout.astro";
import { ServicesList } from "@/data/en/services";
import FeatureCard from "@/components/FeatureCard";
---

<Layout title="Services">
  <section id="features" class="py-12 md:py-24 lg:py-32">
    <div class="container mx-auto px-4 md:px-6">
      <div class="text-center mb-12">
        <Badge className="mb-4 w-fit h-fit bg-primary text-primary-foreground"
          >Features</Badge
        >
        <h2
          class="text-3xl font-bold tracking-tighter sm:text-5xl text-foreground mb-4"
        >
          Services
        </h2>
        <p class="max-w-[900px] mx-auto text-muted-foreground md:text-xl">
          Hestia Technology offers services that allow your company to reach its
          potential!
        </p>
      </div>

      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {ServicesList.map((resource) => <FeatureCard data={resource} />)}
      </div>
    </div>
  </section>
</Layout>