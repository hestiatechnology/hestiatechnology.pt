---
import { Badge } from "@/components/ui/badge";
import Layout from "@/layouts/Layout.astro";
import { PricingStepper } from "@/components/PricingStepper.en";
import { translations } from "@/lib/translations";
---

<Layout title="Prices">
  <section id="features" class="py-12 md:py-24 lg:py-32">
    <div class="container mx-auto px-4 md:px-6">
      <div class="text-center mb-12">
        <Badge className="mb-4 w-fit h-fit bg-primary text-primary-foreground"
          >Features</Badge
        >
        <h2
          class="text-3xl font-bold tracking-tighter sm:text-5xl text-foreground mb-4"
        >
          Modules
        </h2>
        <p class="max-w-[900px] mx-auto text-muted-foreground md:text-xl">
          Our ERP offers modules, allowing us to adapt to your needs
        </p>
      </div>

      <PricingStepper client:only="react" locale={Astro.currentLocale as keyof typeof translations} />
    </div>
  </section>
</Layout>