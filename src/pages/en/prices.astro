---
import { Button } from "@/components/ui/button";
import Layout from "@/layouts/Layout.astro";
import { Check } from "lucide-react";
import PricingSimulator from "@/components/PricingSimulator";
import { CompetitorComparison } from "@/components/CompetitorComparison";
---

<Layout title="Pricing — Hestia">
  <div class="flex flex-col min-h-screen">

    <!-- ── Hero ── -->
    <section class="pt-20 pb-16 md:pt-28 md:pb-20 border-b border-border/60">
      <div class="container mx-auto px-4 md:px-6 max-w-6xl">
        <div class="max-w-2xl">
          <p class="text-[11px] font-bold uppercase tracking-widest text-primary mb-4">Pricing</p>
          <h1 class="font-heading text-5xl md:text-6xl font-bold tracking-tight leading-tight mb-5">
            Pay for What You Use
          </h1>
          <p class="text-lg text-muted-foreground leading-relaxed">
            A flat platform fee, then add users and modules as your factory grows. No surprises, no upfront costs.
          </p>
        </div>
      </div>
    </section>

    <!-- ── How pricing works ── -->
    <section class="py-16 md:py-20 bg-muted/20 border-b border-border/60">
      <div class="container mx-auto px-4 md:px-6 max-w-6xl">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {[
            { n: "1", title: "Platform Base", desc: "One fixed monthly fee covers your Hestia Core platform and DPP compliance engine." },
            { n: "2", title: "Add Your Users", desc: "Pay only for the seats you need — Operators and Managers at different rates." },
            { n: "3", title: "Choose Modules", desc: "Unlock advanced features only when your factory is ready for them." },
          ].map((step) => (
            <div class="flex gap-5">
              <div class="w-8 h-8 rounded-full bg-primary text-white flex items-center justify-center font-heading font-bold text-sm shrink-0 mt-0.5">
                {step.n}
              </div>
              <div>
                <h3 class="font-heading font-bold mb-2">{step.title}</h3>
                <p class="text-sm text-muted-foreground leading-relaxed">{step.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ── Base platform card ── -->
    <section class="py-16 md:py-20">
      <div class="container mx-auto px-4 md:px-6 max-w-6xl">
        <div class="grid lg:grid-cols-[1fr,2fr] gap-12 items-start">
          <div>
            <p class="text-[11px] font-bold uppercase tracking-widest text-primary mb-4">Base Plan</p>
            <h2 class="font-heading text-3xl font-bold leading-tight mb-4">
              Everything you need to get started
            </h2>
            <p class="text-sm text-muted-foreground leading-relaxed">
              One fee covers the core platform, DPP generation, and automatic regulatory compliance.
            </p>
          </div>

          <div class="border-2 border-primary/30 rounded-2xl p-8 bg-primary/4">
            <div class="flex items-start justify-between mb-6">
              <div>
                <div class="flex items-baseline gap-1">
                  <span class="font-heading text-5xl font-bold">€99</span>
                  <span class="text-muted-foreground">/month</span>
                </div>
                <p class="text-xs text-muted-foreground mt-1">or ~€1,015/year with 15% discount</p>
              </div>
              <div class="bg-primary text-white text-[10px] font-bold px-3 py-1 rounded-full uppercase tracking-widest">
                Included
              </div>
            </div>
            <ul class="grid sm:grid-cols-2 gap-3 mb-8">
              {[
                "Hestia Core (production, inventory, suppliers)",
                "EU Digital Product Passport generation",
                "Automatic regulatory updates",
                "2 Manager seats included",
                "5 Operator seats included",
                "Standard support",
              ].map((f) => (
                <li class="flex items-start gap-3 text-sm">
                  <div class="mt-0.5 bg-primary/15 p-1 rounded-full shrink-0">
                    <Check class="w-3 h-3 text-primary" />
                  </div>
                  <span class="text-foreground/80">{f}</span>
                </li>
              ))}
            </ul>
            <Button size="lg" className="rounded-lg font-semibold w-full sm:w-auto" asChild>
              <a href={`/${Astro.currentLocale}/contact`}>Get Started</a>
            </Button>
          </div>
        </div>
      </div>
    </section>

    <!-- ── User seats ── -->
    <section class="py-16 md:py-20 bg-muted/20 border-y border-border/60">
      <div class="container mx-auto px-4 md:px-6 max-w-6xl">
        <div class="grid lg:grid-cols-[1fr,2fr] gap-12 items-start">
          <div>
            <p class="text-[11px] font-bold uppercase tracking-widest text-primary mb-4">Users</p>
            <h2 class="font-heading text-3xl font-bold leading-tight mb-4">
              User Seats
            </h2>
            <p class="text-sm text-muted-foreground leading-relaxed">
              Add seats beyond the ones included in the platform base.
            </p>
          </div>

          <div class="grid sm:grid-cols-2 gap-5">
            {[
              {
                role: "Operator",
                price: "€5",
                period: "/user/month",
                features: ["Log production runs", "Scan and trace items", "View assigned tasks", "Basic data input"],
              },
              {
                role: "Manager",
                price: "€18",
                period: "/user/month",
                features: ["Everything Operators can do", "Approve workflows", "Inventory management", "Reporting & analytics access"],
              },
            ].map((seat) => (
              <div class="border border-border rounded-2xl p-6 bg-card">
                <div class="mb-5">
                  <h3 class="font-heading text-xl font-bold mb-2">{seat.role}</h3>
                  <div class="flex items-baseline gap-1">
                    <span class="font-heading text-3xl font-bold">{seat.price}</span>
                    <span class="text-sm text-muted-foreground">{seat.period}</span>
                  </div>
                </div>
                <ul class="space-y-2.5">
                  {seat.features.map((f) => (
                    <li class="flex items-start gap-2.5 text-sm text-foreground/75">
                      <Check class="w-4 h-4 text-primary shrink-0 mt-0.5" />
                      {f}
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- ── Add-on modules ── -->
    <section class="py-16 md:py-20">
      <div class="container mx-auto px-4 md:px-6 max-w-6xl">
        <div class="mb-10">
          <p class="text-[11px] font-bold uppercase tracking-widest text-primary mb-4">Modules</p>
          <h2 class="font-heading text-3xl font-bold leading-tight mb-3">Add-on Modules</h2>
          <p class="text-muted-foreground text-sm max-w-xl">
            Unlock advanced capabilities when your factory is ready. Each module adds on top of the base plan.
          </p>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
          {[
            { name: "AI Document Validation", desc: "Automatically validate supplier documents and certifications.", price: "€129", period: "/month" },
            { name: "Advanced Integrations", desc: "Connect with Smartex and other manufacturing platforms.", price: "€99", period: "/month per integration" },
            { name: "Real-time Analytics", desc: "Live production dashboards and performance reports.", price: "€99", period: "/month" },
            { name: "Advanced DPP", desc: "Multi-product DPP management and export capabilities.", price: "€79", period: "/month" },
          ].map((mod) => (
            <div class="border border-border rounded-2xl p-6 bg-card hover:border-primary/50 transition-colors group">
              <h3 class="font-heading font-bold text-sm leading-snug mb-2 group-hover:text-primary transition-colors">{mod.name}</h3>
              <div class="flex items-baseline gap-1 mb-3">
                <span class="font-heading text-2xl font-bold">{mod.price}</span>
                <span class="text-xs text-muted-foreground">{mod.period}</span>
              </div>
              <p class="text-xs text-muted-foreground leading-relaxed">{mod.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ── Examples ── -->
    <section class="py-16 md:py-20 bg-muted/20 border-y border-border/60">
      <div class="container mx-auto px-4 md:px-6 max-w-6xl">
        <div class="mb-10">
          <p class="text-[11px] font-bold uppercase tracking-widest text-primary mb-4">Examples</p>
          <h2 class="font-heading text-3xl font-bold leading-tight">What Does It Cost in Practice?</h2>
        </div>
        <div class="grid md:grid-cols-2 gap-6 max-w-3xl">
          {[
            {
              label: "Small Factory",
              title: "1 Manager · 15 Operators",
              items: [
                { desc: "Platform base", amount: "€99" },
                { desc: "1 manager (included in base)", amount: "€0", muted: true },
                { desc: "10 extra operators × €5", amount: "€50" },
              ],
              total: "€149/month",
              note: "~€1,790/year · No upfront cost",
            },
            {
              label: "Mid-size Factory",
              title: "3 Managers · 40 Operators",
              items: [
                { desc: "Platform base", amount: "€99" },
                { desc: "1 extra manager × €18", amount: "€18" },
                { desc: "35 extra operators × €5", amount: "€175" },
                { desc: "Analytics + 1 integration", amount: "€198" },
              ],
              total: "€490/month",
              note: "~€5,880/year · Includes two premium modules",
            },
          ].map((ex) => (
            <div class="border border-border rounded-2xl p-7 bg-card">
              <div class="text-[10px] font-bold uppercase tracking-widest text-muted-foreground mb-1">{ex.label}</div>
              <h3 class="font-heading font-bold text-lg mb-6">{ex.title}</h3>
              <div class="space-y-2.5 text-sm mb-5">
                {ex.items.map((item) => (
                  <div class="flex justify-between">
                    <span class="text-muted-foreground">{item.desc}</span>
                    <span class={item.muted ? "text-muted-foreground" : "font-medium"}>{item.amount}</span>
                  </div>
                ))}
                <div class="border-t border-border/60 pt-3 flex justify-between font-bold">
                  <span>Total</span>
                  <span class="text-primary">{ex.total}</span>
                </div>
              </div>
              <p class="text-xs text-muted-foreground">{ex.note}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ── Cost Comparison ── -->
    <section class="py-16 md:py-20">
      <div class="container mx-auto px-4 md:px-6 max-w-6xl">
        <div class="mb-10">
          <p class="text-[11px] font-bold uppercase tracking-widest text-primary mb-4">Compare</p>
          <h2 class="font-heading text-3xl font-bold leading-tight mb-3">How Hestia Compares</h2>
          <p class="text-muted-foreground text-sm max-w-lg">Choose a competitor and factory size to see a real cost comparison.</p>
        </div>
        <CompetitorComparison client:load locale="en" />
      </div>
    </section>

    <!-- ── Simulator ── -->
    <section class="py-16 md:py-24">
      <div class="container mx-auto px-4 md:px-6 max-w-6xl">
        <div class="mb-10">
          <p class="text-[11px] font-bold uppercase tracking-widest text-primary mb-4">Simulator</p>
          <h2 class="font-heading text-3xl font-bold leading-tight mb-3">Try the Price Simulator</h2>
          <p class="text-muted-foreground text-sm">Adjust users and modules to see your exact monthly cost.</p>
        </div>
        <PricingSimulator locale="en" contactHref={`/${Astro.currentLocale}/contact`} client:load />
      </div>
    </section>

    <!-- ── Early Access ── -->
    <section class="py-12 md:py-16">
      <div class="container mx-auto px-4 md:px-6 max-w-6xl">
        <div class="border-2 border-primary/20 bg-primary/4 rounded-2xl p-8 md:p-12 flex flex-col md:flex-row items-center justify-between gap-6">
          <div class="space-y-2 text-center md:text-left">
            <p class="text-[11px] font-bold uppercase tracking-widest text-primary">Early Access</p>
            <h3 class="font-heading text-2xl md:text-3xl font-bold">Join the Early Access Program</h3>
            <p class="text-muted-foreground text-sm max-w-lg">
              Be among the first factories to run on Hestia. Limited spots in our early access program.
            </p>
          </div>
          <Button size="lg" className="rounded-lg font-semibold shrink-0" asChild>
            <a href={`/${Astro.currentLocale}/contact`}>Apply for Early Access</a>
          </Button>
        </div>
      </div>
    </section>

    <!-- ── CTA ── -->
    <section class="bg-[#0D1A3A] text-white py-20">
      <div class="container mx-auto px-4 md:px-6 max-w-6xl text-center">
        <h2 class="font-heading text-3xl md:text-4xl font-bold mb-4">
          Not sure which setup fits your factory?
        </h2>
        <p class="text-white/60 mb-8 max-w-md mx-auto">
          Our team helps you find the right plan for your factory's size and needs. ESPR compliance takes months to implement — start now to be ready for 2027.
        </p>
        <Button size="lg" className="rounded-lg bg-white text-[#0D1A3A] hover:bg-white/90 font-semibold" asChild>
          <a href={`/${Astro.currentLocale}/contact`}>Talk to Our Team</a>
        </Button>
      </div>
    </section>

  </div>
</Layout>
