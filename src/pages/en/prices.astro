---
import {
  Card,
  CardContent,
  CardDescription,
  CardHeader,
  CardTitle,
} from "@/components/ui/card";
import { Button } from "@/components/ui/button";
import Layout from "@/layouts/Layout.astro";
import { Check, HelpCircle, Construction } from "lucide-react";
import { Badge } from "@/components/ui/badge";

const tiers = [
  {
    name: "Essential",
    price: "XXXX€",
    period: "/year",
    description: "Core features for small manufacturers to get compliant.",
    features: [
      "Core ERP Functions",
      "Standard Production Workflow",
      "EU DPP Generation (Basic)",
      "Standard Support",
      "5 Users"
    ],
    buttonText: "Get Started",
    buttonVariant: "outline",
    popular: false,
  },
  {
    name: "Growth",
    price: "XXXX€",
    period: "/year",
    description: "Advanced tools for growing operations scaling production.",
    features: [
      "Everything in Essential",
      "AI Document Validation",
      "Advanced Integrations (Smartex, etc.)",
      "Real-time Analytics Dashboard",
      "Unlimited Users",
      "Priority Support"
    ],
    buttonText: "Upgrade to Growth",
    buttonVariant: "default",
    popular: true,
  },
  {
    name: "Enterprise",
    price: "XXXX€",
    period: "",
    description: "Tailored solutions for large-scale industrial operations.",
    features: [
      "Everything in Growth",
      "Custom Workflows & API Access",
      "Dedicated Customer Success Manager",
      "On-premise Deployment Options",
      "SLA Guarantees",
      "Custom Training"
    ],
    buttonText: "Contact Sales",
    buttonVariant: "outline",
    popular: false,
  },
];
---

<Layout title="Pricing - Hestia ERP">
  <div class="flex flex-col min-h-screen">
    <section class="py-20 md:py-32 lg:py-40 relative overflow-hidden">
       {/* Background Decoration */}
       <div class="absolute inset-0 -z-10 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-primary/10 via-background to-background"></div>
      
      <div class="container mx-auto px-4 md:px-6">
        <div class="text-center mb-16 space-y-4">
          <Badge variant="secondary" className="mb-4">Simple, Transparent Pricing</Badge>
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold tracking-tighter text-foreground">
            Invest in Your Factory's Future
          </h1>
          <p class="max-w-2xl mx-auto text-muted-foreground md:text-xl">
            Choose the plan that fits your manufacturing scale. No hidden fees.
          </p>
        </div>

        <div class="relative">
          <div class="absolute inset-0 z-20 flex items-center justify-center bg-background/60 backdrop-blur-[2px] rounded-3xl border-2 border-dashed border-primary/50">
            <div class="bg-card p-8 rounded-2xl shadow-2xl border border-border flex flex-col items-center text-center max-w-md mx-4 transform -rotate-1">
              <div class="bg-primary/10 p-4 rounded-full mb-6">
                <Construction className="w-12 h-12 text-primary animate-bounce" />
              </div>
              <h2 class="text-3xl font-bold mb-4">Pricing Coming Soon</h2>
              <p class="text-muted-foreground mb-6">
                We are currently finalizing our pricing structure to provide the best value for your manufacturing needs.
              </p>
              <Button asChild className="rounded-full">
                <a href={`/${Astro.currentLocale}/contact`}>
                  Get a Custom Quote
                </a>
              </Button>
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-7xl mx-auto opacity-40 pointer-events-none select-none">
            {
              tiers.map((tier) => (
              <Card className={`flex flex-col border-2 relative transition-all duration-300 hover:shadow-xl ${tier.popular ? 'border-primary shadow-lg scale-105 z-10' : 'border-border hover:border-primary/50'}`}>
                {tier.popular && (
                    <div class="absolute top-0 right-0 -mt-3 -mr-3">
                        <span class="bg-primary text-primary-foreground text-xs font-bold px-3 py-1 rounded-full shadow-md">MOST POPULAR</span>
                    </div>
                )}
                <CardHeader className="pb-8">
                  <CardTitle className="text-2xl mb-2">{tier.name}</CardTitle>
                  <CardDescription className="text-base">{tier.description}</CardDescription>
                </CardHeader>
                <CardContent className="flex flex-col flex-1 gap-8">
                  <div class="flex items-baseline gap-1">
                    <span class="text-4xl font-bold tracking-tight">{tier.price}</span>
                    <span class="text-muted-foreground font-medium">{tier.period}</span>
                  </div>
                  
                  <ul class="space-y-4 flex-1">
                    {tier.features.map((feature) => (
                      <li class="flex items-start gap-3">
                        <div class="mt-1 bg-primary/10 p-1 rounded-full">
                            <Check className="w-3 h-3 text-primary" />
                        </div>
                        <span class="text-sm text-foreground/80 leading-tight">{feature}</span>
                      </li>
                    ))}
                  </ul>
                  
                  <Button
                    size="lg"
                    className={`w-full rounded-full font-semibold ${tier.popular ? 'shadow-lg shadow-primary/20' : ''}`}
                    variant={tier.buttonVariant as any}
                  >
                    <a href={`/${Astro.currentLocale}/contact`} class="w-full h-full flex items-center justify-center">
                        {tier.buttonText}
                    </a>
                  </Button>
                </CardContent>
              </Card>
            ))
          }
        </div>
      </div>

      <div class="mt-20 text-center">
            <p class="text-muted-foreground mb-4">Have questions about our pricing?</p>
            <Button variant="link" asChild>
                <a href={`/${Astro.currentLocale}/contact`} class="gap-2">
                    Contact our support team <HelpCircle className="w-4 h-4" />
                </a>
            </Button>
        </div>
      </div>
    </section>
  </div>
</Layout>