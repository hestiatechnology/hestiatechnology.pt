---
import Layout from "@/layouts/Layout.astro";
import { Button } from "@/components/ui/button";
import { GoogleCalendarButton } from "@/components/GoogleCalendarButton";
---

<Layout title="Welcome to Hestia Technology">
  <div class="flex flex-col">

    <!-- Hero -->
    <section class="min-h-[75vh] flex flex-col items-center justify-center text-center relative overflow-hidden pt-32 pb-20 px-4">
      <!-- Background -->
      <div class="absolute inset-0 -z-10">
        <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,_var(--tw-gradient-stops))] from-primary/10 via-background to-background"></div>
        <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[500px] bg-primary/20 blur-[120px] rounded-full opacity-40"></div>
      </div>

      <div class="max-w-3xl mx-auto space-y-8">
        <div class="inline-flex items-center gap-2 bg-primary/10 border border-primary/20 text-primary text-sm px-4 py-2 rounded-full">
          👋 Hey, welcome
        </div>

        <h1 class="text-4xl md:text-6xl tracking-tight text-foreground">
          Your factory deserves<br/>an operating system.
        </h1>

        <p class="text-xl text-muted-foreground max-w-2xl mx-auto leading-relaxed">
          Hestia is the factory operating system built from the ground up for textile manufacturers - with native EU DPP compliance, real-time IoT and AI built into every layer.
        </p>

        <div class="flex flex-col sm:flex-row justify-center items-center gap-4 pt-4">
          <GoogleCalendarButton client:load label="Schedule a Demo" />
          <Button size="lg" variant="outline" className="rounded-full text-lg h-12 px-8">
            <a href="/en/features">See Features</a>
          </Button>
        </div>
      </div>
    </section>

    <!-- 3 pillars -->
    <section class="py-20 px-4 bg-muted/30 border-y">
      <div class="container mx-auto max-w-5xl">
        <p class="text-center text-sm text-muted-foreground uppercase tracking-widest mb-12">
          What sets us apart
        </p>
        <div class="grid md:grid-cols-3 gap-8">

          <div class="bg-card border rounded-2xl p-8 space-y-4 hover:border-primary/30 transition-colors">
            <div class="text-3xl">🗂</div>
            <h3 class="text-lg text-foreground">Native DPP</h3>
            <p class="text-muted-foreground text-sm leading-relaxed">
              EU-compliant Digital Product Passport built in - no external integrations or extra costs required.
            </p>
          </div>

          <div class="bg-card border rounded-2xl p-8 space-y-4 hover:border-primary/30 transition-colors">
            <div class="text-3xl">📡</div>
            <h3 class="text-lg text-foreground">Real-Time IoT</h3>
            <p class="text-muted-foreground text-sm leading-relaxed">
              Full shop floor visibility with live sensors and dashboards - no paper, no delays.
            </p>
          </div>

          <div class="bg-card border rounded-2xl p-8 space-y-4 hover:border-primary/30 transition-colors">
            <div class="text-3xl">🤖</div>
            <h3 class="text-lg text-foreground">AI & Automation</h3>
            <p class="text-muted-foreground text-sm leading-relaxed">
              Demand forecasting, stock optimisation and automatic reports - with zero manual intervention.
            </p>
          </div>

        </div>
      </div>
    </section>

    <!-- Final CTA -->
    <section class="py-20 px-4">
      <div class="container mx-auto max-w-3xl text-center space-y-8">
        <div class="relative bg-primary/5 border border-primary/10 rounded-3xl p-10 md:p-16">
          <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,_var(--tw-gradient-stops))] from-primary/10 via-transparent to-transparent opacity-50 rounded-3xl"></div>
          <div class="relative z-10 space-y-6">
            <h2 class="text-3xl md:text-4xl text-foreground">
              Ready to modernise your factory?
            </h2>
            <p class="text-muted-foreground text-lg">
              Talk to us. In 30 minutes we'll show you how Hestia becomes your factory's operating system - no stress, no painful migrations.
            </p>
            <div class="flex justify-center">
              <GoogleCalendarButton client:load label="Book a Free Call" />
            </div>
          </div>
        </div>
      </div>
    </section>

  </div>
</Layout>