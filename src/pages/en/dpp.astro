---
import Layout from "@/layouts/Layout.astro";
import { Badge } from "@/components/ui/badge";
import { Button } from "@/components/ui/button";
import {
  Recycle,
  Users,
  Database,
  Link,
  Container,
  FileText,
  ShieldCheck,
} from "lucide-react";

const whatIsDpp = [
  {
    title: "Sustainability & Circularity",
    description:
      "The DPP aims to make products more sustainable by providing transparent info on origin, materials, and environmental impact.",
    icon: Recycle,
  },
  {
    title: "Transparency",
    description:
      "Empowers consumers and businesses with detailed journey information, fostering trust and informed choices.",
    icon: Users,
  },
  {
    title: "Digital Record",
    description:
      "For textiles, this means a complete digital twin of the supply chain, from raw material to final garment.",
    icon: Database,
  },
];

const hestiaBenefits = [
  {
    title: "End-to-End Traceability",
    description:
      "Track your entire supply chain from raw materials to finished product, ensuring full compliance.",
    icon: Link,
  },
  {
    title: "Central Data Hub",
    description:
      "A single source of truth for all product data, simplifying the management and sharing required by the DPP.",
    icon: Container,
  },
  {
    title: "Automated Reporting",
    description:
      "Generate DPP-compliant reports instantly, saving time and reducing manual errors.",
    icon: FileText,
  },
  {
    title: "Future-Proof",
    description:
      "Stay ahead of evolving EU regulations and be ready for the digital future of manufacturing.",
    icon: ShieldCheck,
  },
];
---

<Layout title="EU Digital Product Passport (DPP) - Hestia ERP">
  
  <!-- Hero Section -->
  <section class="py-20 md:py-32 text-center relative overflow-hidden">
    <div class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_center,_var(--tw-gradient-stops))] from-primary/10 via-background to-background"></div>
    <div class="container mx-auto px-4 md:px-6 relative z-10">
      <Badge className="mb-6 border bg-primary/10 text-primary hover:bg-primary/20 transition-colors"
        >Future of Textile Industry</Badge
      >
      <h1
        class="text-4xl md:text-5xl lg:text-7xl font-bold tracking-tight text-foreground max-w-5xl mx-auto leading-tight"
      >
        EU Digital Product Passport with
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary to-blue-400"> Hestia ERP</span>
      </h1>
      <p class="max-w-3xl mx-auto mt-6 text-muted-foreground md:text-xl leading-relaxed">
        The DPP is the new standard. Hestia ERP is built to ensure your factory not only complies but leads in transparency.
      </p>
      <div class="mt-10 flex justify-center gap-4">
        <Button size="lg" className="rounded-full px-8">
          <a href={`/${Astro.currentLocale}/contact`}>Schedule DPP Demo</a>
        </Button>
      </div>
    </div>
  </section>

  <!-- What is DPP Section -->
  <section id="what-is-dpp" class="py-20 md:py-32 bg-muted/30">
    <div class="container mx-auto px-4 md:px-6">
      <div class="text-center mb-16">
        <h2 class="text-3xl font-bold tracking-tight sm:text-4xl text-foreground">
          What is the Digital Product Passport?
        </h2>
        <p class="max-w-3xl mx-auto mt-4 text-muted-foreground md:text-lg">
          An EU requirement for sustainable products. Hestia provides the infrastructure to manage this data.
        </p>
      </div>
      <div class="grid gap-8 md:grid-cols-3">
        {whatIsDpp.map((item) => (
          <div class="flex flex-col items-center text-center p-6 bg-card rounded-xl border shadow-sm hover:shadow-md transition-all">
            <div class="p-3 bg-primary/10 rounded-full mb-4">
              <item.icon className="w-8 h-8 text-primary" />
            </div>
            <h3 class="text-xl font-bold mb-2">{item.title}</h3>
            <p class="text-muted-foreground leading-relaxed">{item.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Why Hestia Section -->
  <section id="why-hestia" class="py-20 md:py-32">
    <div class="container mx-auto px-4 md:px-6">
      <div class="text-center mb-16">
        <h2 class="text-3xl font-bold tracking-tight sm:text-4xl text-foreground">
          Why Hestia for DPP?
        </h2>
        <p class="max-w-3xl mx-auto mt-4 text-muted-foreground md:text-lg">
          More than compliance, a competitive advantage.
        </p>
      </div>
      <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-4">
        {hestiaBenefits.map((item) => (
          <div class="group relative p-6 bg-background border rounded-xl hover:border-primary/50 transition-colors">
            <div class="absolute inset-0 bg-primary/5 opacity-0 group-hover:opacity-100 transition-opacity rounded-xl"></div>
            <div class="relative z-10">
              <item.icon className="w-10 h-10 text-primary mb-4" />
              <h3 class="text-lg font-bold mb-2">{item.title}</h3>
              <p class="text-sm text-muted-foreground">{item.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-20 md:py-32 text-center bg-primary/5 border-t">
    <div class="container mx-auto px-4 md:px-6">
      <h2 class="text-3xl font-bold tracking-tight sm:text-4xl text-foreground mb-6">
        Ready for the Future?
      </h2>
      <p class="max-w-2xl mx-auto text-muted-foreground md:text-lg mb-8">
        Don't wait for regulation. Secure your spot in the future of the textile industry with Hestia ERP today.
      </p>
      <Button size="lg" className="rounded-full px-10 h-12 text-lg shadow-lg">
        <a href={`/${Astro.currentLocale}/contact`}>Talk to an Expert</a>
      </Button>
    </div>
  </section>
</Layout>
