---
import Layout from "@/layouts/Layout.astro";
import { Badge } from "@/components/ui/badge";
import { Button } from "@/components/ui/button";
import { Card, CardContent, CardHeader, CardTitle, CardDescription } from "@/components/ui/card";
import {
  Plug,
  Database,
  Cloud,
  FileCode,
  ShoppingCart,
  Factory,
  Settings,
  RefreshCw,
} from "lucide-react";

const integrationCategories = [
  {
    title: "ERP & Contabilidade",
    description: "Sincronização financeira e faturação.",
    icon: Database,
    apps: ["Primavera", "PHC", "SAP", "Sage", "Microsoft Dynamics 365"],
  },
  {
    title: "E-commerce",
    description: "Gestão de encomendas e stock multicanal.",
    icon: ShoppingCart,
    apps: ["Shopify", "WooCommerce", "Magento", "PrestaShop"],
  },
  {
    title: "Operações Têxteis (IoT)",
    description: "Conetividade direta com máquinas e sensores.",
    icon: Factory,
    apps: ["OPC UA", "MQTT", "Modbus", "Smartex", "Datatex"],
  },
  {
    title: "Ferramentas de Produtividade",
    description: "Comunicação e gestão de tarefas.",
    icon: Cloud,
    apps: ["Slack", "Microsoft Teams", "Google Workspace", "Office 365"],
  },
];
---

<Layout title="Integrações - Hestia">
  <div class="flex flex-col min-h-screen">
    <!-- Hero Section -->
    <section class="py-20 md:py-32 relative overflow-hidden text-center bg-background border-b">
        <div class="absolute inset-0 -z-10 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-primary/10 via-background to-background"></div>
        <div class="container mx-auto px-4 md:px-6">
            <Badge variant="outline" class="mb-6 border bg-background/50 backdrop-blur-sm">
                Conectividade Total
            </Badge>
            <h1 class="text-4xl md:text-5xl lg:text-7xl tracking-tight text-foreground mb-6">
                Ligue o Hestia ao Seu <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary to-blue-400">Ecossistema</span>
            </h1>
            <p class="max-w-2xl mx-auto text-muted-foreground md:text-xl leading-relaxed">
                Integre facilmente com as ferramentas que já utiliza. Desde sistemas de contabilidade a máquinas industriais, a Hestia OS conecta tudo.
            </p>
        </div>
    </section>

    <!-- Integrations Grid -->
    <section class="py-20 bg-muted/30">
        <div class="container mx-auto px-4 md:px-6">
            <div class="grid md:grid-cols-2 gap-8 max-w-5xl mx-auto">
                {integrationCategories.map((category) => (
                    <Card class="border shadow-sm hover:shadow-md transition-shadow">
                        <CardHeader>
                            <div class="flex items-center gap-4">
                                <div class="p-3 bg-primary/10 rounded-lg text-primary">
                                    <category.icon class="w-6 h-6" />
                                </div>
                                <div>
                                    <CardTitle class="text-xl">{category.title}</CardTitle>
                                    <CardDescription>{category.description}</CardDescription>
                                </div>
                            </div>
                        </CardHeader>
                        <CardContent>
                            <div class="flex flex-wrap gap-2">
                                {category.apps.map((app) => (
                                    <Badge variant="secondary" class="bg-background border px-3 py-1">
                                        {app}
                                    </Badge>
                                ))}
                            </div>
                        </CardContent>
                    </Card>
                ))}
            </div>
        </div>
    </section>

    <!-- API Section -->
    <section class="py-20 md:py-32">
        <div class="container mx-auto px-4 md:px-6 max-w-5xl">
            <div class="grid md:grid-cols-2 gap-12 items-center">
                <div class="space-y-6">
                    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-100 text-blue-700 text-xs dark:bg-blue-900/30 dark:text-blue-400">
                        <FileCode class="w-3 h-3" />
                        API First
                    </div>
                    <h2 class="text-3xl md:text-4xl tracking-tight">API Robusta para Desenvolvedores</h2>
                    <p class="text-muted-foreground text-lg">
                        Precisa de algo personalizado? A nossa API RESTful completa permite-lhe construir fluxos de trabalho à medida e conectar qualquer sistema proprietário.
                    </p>
                    <ul class="space-y-3">
                        <li class="flex items-center gap-2 text-foreground/80">
                            <RefreshCw class="w-5 h-5 text-green-500" />
                            Webhooks em tempo real
                        </li>
                        <li class="flex items-center gap-2 text-foreground/80">
                            <Settings class="w-5 h-5 text-blue-500" />
                            Documentação Swagger completa
                        </li>
                        <li class="flex items-center gap-2 text-foreground/80">
                            <Plug class="w-5 h-5 text-purple-500" />
                            Autenticação segura OAuth 2.0
                        </li>
                    </ul>
                    <Button variant="outline" class="mt-4">
                        <a href="#">Ler Documentação API</a>
                    </Button>
                </div>
                <div class="bg-slate-950 rounded-xl p-6 shadow-2xl border border-slate-800 font-mono text-sm text-slate-300 relative overflow-hidden">
                    <div class="absolute top-0 right-0 p-4 opacity-50">
                        <div class="flex gap-2">
                            <div class="w-3 h-3 rounded-full bg-red-500"></div>
                            <div class="w-3 h-3 rounded-full bg-yellow-500"></div>
                            <div class="w-3 h-3 rounded-full bg-green-500"></div>
                        </div>
                    </div>
                    <pre class="mt-4"><code><span class="text-purple-400">POST</span> /api/v1/orders
Authorization: Bearer <span class="text-yellow-400">token_123</span>
Content-Type: application/json

{'{'}
  <span class="text-green-400">"customer_id"</span>: <span class="text-blue-400">"cust_892"</span>,
  <span class="text-green-400">"items"</span>: [
    {'{'}
      <span class="text-green-400">"sku"</span>: <span class="text-blue-400">"TSHIRT-XL-WHT"</span>,
      <span class="text-green-400">"quantity"</span>: <span class="text-orange-400">500</span>,
      <span class="text-green-400">"due_date"</span>: <span class="text-blue-400">"2024-04-15"</span>
    {'}'}
  ]
{'}'}</code></pre>
                </div>
            </div>
        </div>
    </section>

    <!-- CTA -->
    <section class="py-20 text-center bg-primary/5">
        <div class="container mx-auto px-4">
            <h2 class="text-3xl mb-6">Não encontra a sua ferramenta?</h2>
            <p class="text-muted-foreground max-w-2xl mx-auto mb-8">
                Adicionamos novas integrações semanalmente. Fale connosco para verificar a compatibilidade com o seu stack tecnológico.
            </p>
            <Button size="lg">
                <a href={`/${Astro.currentLocale}/contact`}>Falar com Engenharia</a>
            </Button>
        </div>
    </section>
  </div>
</Layout>
