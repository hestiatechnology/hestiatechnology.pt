---
import Layout from "@/layouts/Layout.astro";
import BlogPage from "@/components/pages/BlogPage";
import { getCollection } from "astro:content";

const raw = await getCollection("blog", ({ id }) => id.startsWith("pt/"));
const posts = raw
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .map((post, i) => ({
    slug: post.slug.split("/")[1],
    title: post.data.title,
    description: post.data.description,
    date: post.data.date.toLocaleDateString("pt-PT", { day: "2-digit", month: "short", year: "numeric" }).toUpperCase(),
    tags: post.data.tags ?? [],
    bg: (i % 6) + 1,
  }));
---

<Layout title="Blog — Notas da fábrica">
  <BlogPage posts={posts} />
</Layout>
