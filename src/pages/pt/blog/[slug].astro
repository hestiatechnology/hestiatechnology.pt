---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ id }) => id.startsWith("pt/"));
  return posts.map((post) => ({
    params: { slug: post.slug.split("/")[1] },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();
const date = post.data.date.toLocaleDateString("pt-PT", { day: "2-digit", month: "long", year: "numeric" });
---

<Layout title={`${post.data.title} — Hestia Technology`}>
  <div style="max-width: 1200px; margin: 0 auto; padding: 0 24px;">

    <header class="article-hero">
      <div class="eyebrow-row">
        <a href="/pt/blog" class="eyebrow" style="text-decoration: none; color: inherit;">← Blog</a>
        {post.data.tags?.map(tag => (
          <span class="eyebrow" style="color: var(--ember);">{tag}</span>
        ))}
      </div>
      <h1>{post.data.title}</h1>
      <div class="article-meta">
        <span>{date}</span>
        <span class="article-meta__dot"></span>
        <span>{post.data.author}</span>
      </div>
    </header>

    <div class="article-body">
      <Content />
    </div>

  </div>
</Layout>
