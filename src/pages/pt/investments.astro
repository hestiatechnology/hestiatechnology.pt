---
import ScheduleMeeting from "@/components/ScheduleMeeting";
import { Badge } from "@/components/ui/badge";
import { Button } from "@/components/ui/button";
import {
  Card,
  CardContent,
  CardDescription,
  CardHeader,
  CardTitle,
} from "@/components/ui/card";
import Layout from "@/layouts/Layout.astro";
import { TrendingUp, Target, Rocket, Calendar } from "lucide-react";
---

<Layout title="Investimentos - Hestia ERP">
  <!-- Hero Section -->
  <section
    class="py-20 md:py-32 relative overflow-hidden"
  >
    <div class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_top,_var(--tw-gradient-stops))] from-primary/10 via-background to-background"></div>
    <div class="container mx-auto px-4 md:px-6 text-center">
      <Badge
        variant="outline"
        className="mb-6 border bg-background/50 backdrop-blur-sm"
      >
        🚀 Oportunidade Pre-Seed
      </Badge>
      <h1
        class="text-4xl md:text-6xl lg:text-7xl font-bold tracking-tight text-foreground mb-6"
      >
        Invista no Futuro da <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary to-blue-400">Indústria Têxtil</span>
      </h1>
      <p class="max-w-2xl mx-auto text-muted-foreground md:text-xl mb-10 leading-relaxed">
        Junte-se a nós numa jornada revolucionária. Procuramos parceiros visionários para acelerar o nosso crescimento e transformar o mercado global.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <Button size="lg" className="px-8 rounded-full h-12 text-lg shadow-lg">
          <a href="mailto:investors@hestiatechnology.pt">Falar com Fundadores</a>
        </Button>
        <Button variant="outline" size="lg" className="px-8 rounded-full h-12 text-lg">
          <a href="#pitch">Ver Pitch Deck</a>
        </Button>
      </div>
    </div>
  </section>

  <!-- Investment Info -->
  <section class="py-20 bg-muted/30 border-y">
    <div class="container mx-auto px-4 md:px-6">
      <div class="grid md:grid-cols-2 gap-12 items-center max-w-5xl mx-auto">
        <div class="space-y-6">
          <Badge variant="secondary">Ronda Atual</Badge>
          <h2 class="text-3xl md:text-4xl font-bold tracking-tight">Objetivo: €250K</h2>
          <p class="text-lg text-muted-foreground leading-relaxed">
            Estamos a levantar a nossa ronda pre-seed para financiar 18 meses de operações, focados em desenvolvimento de produto e aquisição de clientes iniciais.
          </p>
          <div class="grid grid-cols-2 gap-4 pt-4">
            <div class="p-4 bg-background rounded-xl border shadow-sm">
              <div class="text-3xl font-bold text-primary mb-1">4</div>
              <div class="text-sm font-medium">Engenheiros</div>
              <div class="text-xs text-muted-foreground">Dev Produto</div>
            </div>
            <div class="p-4 bg-background rounded-xl border shadow-sm">
              <div class="text-3xl font-bold text-primary mb-1">1</div>
              <div class="text-sm font-medium">Vendas</div>
              <div class="text-xs text-muted-foreground">Go-to-Market</div>
            </div>
          </div>
        </div>
        
        <div class="bg-card border rounded-2xl p-8 shadow-lg relative">
            <div class="absolute -top-4 -right-4 w-24 h-24 bg-primary/10 rounded-full blur-2xl"></div>
            <h3 class="font-bold text-xl mb-6">Uso de Fundos</h3>
            <div class="space-y-4">
                <div class="flex items-center justify-between">
                    <span>Desenvolvimento (R&D)</span>
                    <span class="font-bold">60%</span>
                </div>
                <div class="w-full bg-muted rounded-full h-2">
                    <div class="bg-primary h-2 rounded-full" style="width: 60%"></div>
                </div>
                
                <div class="flex items-center justify-between mt-4">
                    <span>Vendas & Marketing</span>
                    <span class="font-bold">25%</span>
                </div>
                <div class="w-full bg-muted rounded-full h-2">
                    <div class="bg-blue-400 h-2 rounded-full" style="width: 25%"></div>
                </div>

                <div class="flex items-center justify-between mt-4">
                    <span>Operações</span>
                    <span class="font-bold">15%</span>
                </div>
                <div class="w-full bg-muted rounded-full h-2">
                    <div class="bg-indigo-400 h-2 rounded-full" style="width: 15%"></div>
                </div>
            </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Milestones -->
  <section class="py-20 md:py-32">
    <div class="container mx-auto px-4 md:px-6">
      <div class="text-center mb-16">
        <h2 class="text-3xl font-bold tracking-tight mb-4">Marcos a Alcançar (18 Meses)</h2>
        <p class="text-muted-foreground text-lg">O nosso plano claro para o sucesso.</p>
      </div>
      
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6 max-w-6xl mx-auto">
        <Card className="bg-background border-2 hover:border-primary/50 transition-all">
            <CardHeader>
                <TrendingUp class="w-10 h-10 text-primary mb-2" />
                <CardTitle>15k€ MRR</CardTitle>
                <CardDescription>Receita Recorrente Mensal</CardDescription>
            </CardHeader>
        </Card>
        <Card className="bg-background border-2 hover:border-primary/50 transition-all">
            <CardHeader>
                <Target class="w-10 h-10 text-primary mb-2" />
                <CardTitle>25 Clientes</CardTitle>
                <CardDescription>Fabricantes Pagantes</CardDescription>
            </CardHeader>
        </Card>
        <Card className="bg-background border-2 hover:border-primary/50 transition-all">
            <CardHeader>
                <Rocket class="w-10 h-10 text-primary mb-2" />
                <CardTitle>Produto V1</CardTitle>
                <CardDescription>Módulos IA e DPP completos</CardDescription>
            </CardHeader>
        </Card>
        <Card className="bg-background border-2 hover:border-primary/50 transition-all">
            <CardHeader>
                <Calendar class="w-10 h-10 text-primary mb-2" />
                <CardTitle>Seed Ready</CardTitle>
                <CardDescription>Preparados para Série A</CardDescription>
            </CardHeader>
        </Card>
      </div>
    </div>
  </section>

  <!-- Pitch Deck Embed -->
  <section id="pitch" class="py-20 bg-muted/30">
    <div class="container mx-auto px-4 md:px-6 text-center">
      <h2 class="text-3xl font-bold mb-8">Pitch Deck</h2>
      <div class="max-w-4xl mx-auto shadow-2xl rounded-xl overflow-hidden border bg-background">
        <iframe
          src="https://docs.google.com/presentation/d/e/2PACX-1vSc8ct3XoeALpqILbHoV3VKjl5yANi4-GpTRik1cQRZ-23l6UfixP0wmYZijEarFrde46B9QAhBfRJC/pubembed?start=false&loop=false&delayms=5000"
          width="100%"
          height="550"
          allowfullscreen="true"
          class="border-0"
          title="Hestia ERP Pitch Deck"></iframe>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20 text-center">
    <div class="container mx-auto px-4">
        <h2 class="text-3xl font-bold mb-6">Vamos Conversar?</h2>
        <div class="flex justify-center">
            <ScheduleMeeting client:only="react" />
        </div>
    </div>
  </section>
</Layout>