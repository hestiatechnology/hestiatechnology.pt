---
import { Badge } from "@/components/ui/badge";
import { Button } from "@/components/ui/button";
import {
  Card,
  CardContent,
  CardDescription,
  CardHeader,
  CardTitle,
} from "@/components/ui/card";
import { Avatar, AvatarFallback, AvatarImage } from "@/components/ui/avatar";
import { Separator } from "@/components/ui/separator";
import Layout from "@/layouts/Layout.astro";
import IPCA from "@/assets/ipca_cor.png";
import TeamSection from "@/components/TeamSection.pt";
---

<Layout title="Sobre Nós">
  <section
    class="py-12 md:py-24 lg:py-32"
  >
    <div class="px-4 md:px-6">
      <div class="text-center mb-12">
        <Badge
          variant="outline"
          className="w-fit h-fit mb-4 border"
        >
          🏢 Sobre Nós
        </Badge>
        <h1
          class="text-3xl tracking-tighter sm:text-5xl text-foreground mb-4"
        >
          A Construir o Sistema Operativo da Empresa Têxtil
        </h1>
        <p class="max-w-[900px] mx-auto text-muted-foreground md:text-xl">
          Os sistemas legados estão a custar aos empresas têxteis os seus lucros
          e o seu futuro. Estamos aqui para mudar isso.
        </p>
      </div>
    </div>
  </section>

<!-- Mission & Vision -->

  <section class="py-12 md:py-24">

    <div class="px-4 md:px-6">

      <div class="grid gap-8 md:grid-cols-2 max-w-6xl mx-auto">

        <Card className="border">

          <CardHeader>

            <div

              class="w-16 h-16 border flex items-center justify-center mb-4"

            >

              <span class="text-3xl">🎯</span>

            </div>

            <CardTitle className="text-2xl">A Nossa Missão</CardTitle>

          </CardHeader>

          <CardContent>

            <CardDescription className="text-base leading-relaxed">

              Construir o sistema operativo para empresas têxteis que automatiza a conformidade

              com a UE e o acompanhamento da produção, substituindo sistemas legados

              dispendiosos e pouco fiáveis.

            </CardDescription>

          </CardContent>

        </Card>



        <Card className="border">

          <CardHeader>

            <div

              class="w-16 h-16 border flex items-center justify-center mb-4"

            >

              <span class="text-3xl">🔮</span>

            </div>

            <CardTitle className="text-2xl">A Nossa Visão</CardTitle>

          </CardHeader>

          <CardContent>

            <CardDescription className="text-base leading-relaxed">

              Tornarmo-nos o sistema operativo padrão para a indústria

              transformadora da UE, começando pelo mercado têxtil português

              e expandindo pela indústria europeia.

            </CardDescription>

          </CardContent>

        </Card>

      </div>

    </div>

  </section>



  <!-- Values Section -->
  <section class="py-12 md:py-24">
    <div class="px-4 md:px-6">
      <div class="text-center mb-12">
        <h2
          class="text-2xl tracking-tighter sm:text-4xl text-foreground mb-4"
        >
          Os Nossos Valores
        </h2>
        <p class="max-w-[700px] mx-auto text-muted-foreground">
          Princípios que guiam o nosso desenvolvimento de soluções SaaS e a
          relação com clientes e parceiros.
        </p>
      </div>

      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4 max-w-6xl mx-auto">
        <Card className="text-center border">
          <CardHeader>
            <div
              class="w-12 h-12 border flex items-center justify-center mx-auto mb-2"
            >
              <span class="text-2xl">💡</span>
            </div>
            <CardTitle className="text-lg">Inovação</CardTitle>
          </CardHeader>
          <CardContent>
            <CardDescription>
              Buscamos constantemente novas formas de resolver problemas e criar
              valor.
            </CardDescription>
          </CardContent>
        </Card>

        <Card className="text-center border">
          <CardHeader>
            <div
              class="w-12 h-12 border flex items-center justify-center mx-auto mb-2"
            >
              <span class="text-2xl">🤝</span>
            </div>
            <CardTitle className="text-lg">Transparência</CardTitle>
          </CardHeader>
          <CardContent>
            <CardDescription>
              Comunicação aberta e honesta em todas as nossas relações.
            </CardDescription>
          </CardContent>
        </Card>

        <Card className="text-center border">
          <CardHeader>
            <div
              class="w-12 h-12 border flex items-center justify-center mx-auto mb-2"
            >
              <span class="text-2xl">🎯</span>
            </div>
            <CardTitle className="text-lg">Excelência</CardTitle>
          </CardHeader>
          <CardContent>
            <CardDescription>
              Comprometimento com a qualidade em tudo o que fazemos.
            </CardDescription>
          </CardContent>
        </Card>

        <Card className="text-center border">
          <CardHeader>
            <div
              class="w-12 h-12 border flex items-center justify-center mx-auto mb-2"
            >
              <span class="text-2xl">🌱</span>
            </div>
            <CardTitle className="text-lg">Sustentabilidade</CardTitle>
          </CardHeader>
          <CardContent>
            <CardDescription>
              Responsabilidade social e ambiental em todas as nossas operações.
            </CardDescription>
          </CardContent>
        </Card>
      </div>
    </div>
  </section>

  <!-- Founder Story -->
  <section class="py-12 md:py-24 bg-muted/20 border-y border-border/60">
    <div class="px-4 md:px-6">
      <div class="max-w-3xl mx-auto text-center space-y-6">
        <p class="text-[11px] uppercase tracking-widest text-primary">A Nossa História</p>
        <h2 class="text-2xl tracking-tighter sm:text-4xl text-foreground">
          Nascida da Frustração com Sistemas Legados
        </h2>
        <p class="text-muted-foreground md:text-lg leading-relaxed">
          Vimos empresas têxteis a debaterem-se com sistemas legados que não acompanhavam as regulamentações da UE. Consultores caros para cada atualização. Sem visibilidade em tempo real. Zero suporte DPP. Por isso construímos o que realmente precisam - um sistema operativo para empresas têxteis.
        </p>
      </div>
    </div>
  </section>

  <!-- Team Section -->
  <TeamSection client:load />

  <!-- CTA Section -->
  <section class="py-12 md:py-24">
    <div class="px-4 md:px-6">
      <Card className="border">
        <CardContent className="p-8 md:p-12 text-center">
          <h2
            class="text-2xl tracking-tighter sm:text-4xl text-foreground mb-4"
          >
            Quer Fazer Parte da Nossa História?
          </h2>
          <p class="max-w-[600px] mx-auto text-muted-foreground mb-8">
            Estamos sempre à procura de talentos excepcionais e parceiros que
            partilhem a nossa visão. Junta-te a nós!
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <Button variant="outline" size="lg" className="px-8">
              Ver Oportunidades
            </Button>
            <Button
              variant="outline"
              size="lg"
              className="px-8"
            >
              Contactar-nos
            </Button>
          </div>
        </CardContent>
      </Card>
    </div>
  </section>
</Layout>
