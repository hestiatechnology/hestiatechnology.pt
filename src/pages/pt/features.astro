---
import Layout from "@/layouts/Layout.astro";
import { Button } from "@/components/ui/button";
import FeatureShowcase from "@/components/FeatureShowcase";
import {
  Cpu, BarChart4, CloudCog, Smartphone,
  Shield, Zap, Layers, Globe,
} from "lucide-react";

const additionalFeatures = [
  { title: "Integração IoT", desc: "Conecte as suas máquinas diretamente ao ERP para dados em tempo real.", Icon: Cpu },
  { title: "Análise Preditiva", desc: "Antecipe falhas e necessidades de manutenção com IA.", Icon: BarChart4 },
  { title: "Acesso na Nuvem", desc: "Aceda aos seus dados em qualquer lugar, a qualquer hora, com segurança.", Icon: CloudCog },
  { title: "App Móvel", desc: "Gestão no chão de fábrica através de aplicação nativa iOS e Android.", Icon: Smartphone },
  { title: "Segurança de Dados", desc: "Encriptação de ponta a ponta e backups automáticos.", Icon: Shield },
  { title: "Implementação Rápida", desc: "Comece a usar em semanas, não meses, com onboarding assistido.", Icon: Zap },
  { title: "Gestão de Stock", desc: "Controlo total de inventário, desde o fio até à peça final.", Icon: Layers },
  { title: "Multi-Idioma", desc: "Suporte nativo para múltiplos idiomas e moedas.", Icon: Globe },
];
---

<Layout title="Funcionalidades - Hestia ERP">
  <div class="flex flex-col min-h-screen">

    <!-- ── Hero ── -->
    <section class="pt-20 pb-16 md:pt-28 md:pb-20 border-b border-border/60">
      <div class="container mx-auto px-4 md:px-6 max-w-6xl">
        <div class="max-w-2xl">
          <p class="text-[11px] font-bold uppercase tracking-widest text-primary mb-4">Funcionalidades</p>
          <h1 class="font-heading text-5xl md:text-6xl font-bold tracking-tight leading-tight mb-5">
            Todas as Ferramentas para Escalar
          </h1>
          <p class="text-lg text-muted-foreground leading-relaxed">
            Do chão de fábrica à gestão executiva, o Hestia ERP oferece um conjunto completo de funcionalidades desenhadas especificamente para a indústria têxtil moderna.
          </p>
        </div>
      </div>
    </section>

    <!-- ── Main Features Showcase ── -->
    <div class="py-16 md:py-24">
      <FeatureShowcase
        client:load
        locale={Astro.currentLocale}
        title="Funcionalidades Principais"
        description="O núcleo do nosso sistema, construído para a eficiência da indústria têxtil."
      />
    </div>

    <!-- ── Additional features grid ── -->
    <section class="py-16 md:py-20 bg-muted/20 border-t border-border/60">
      <div class="container mx-auto px-4 md:px-6 max-w-6xl">
        <div class="mb-12">
          <p class="text-[11px] font-bold uppercase tracking-widest text-primary mb-4">Mais Funcionalidades</p>
          <h2 class="font-heading text-3xl font-bold leading-tight mb-3">Mais do que Apenas o Básico</h2>
          <p class="text-muted-foreground text-sm max-w-lg">Detalhes que fazem a diferença no dia-a-dia.</p>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
          {additionalFeatures.map(({ title, desc, Icon }) => (
            <div className="border border-border rounded-2xl p-6 bg-card hover:border-primary/50 hover:shadow-sm transition-all group">
              <div className="w-10 h-10 bg-primary/10 rounded-xl flex items-center justify-center mb-5 text-primary group-hover:bg-primary group-hover:text-white transition-all duration-200">
                <Icon className="w-5 h-5" />
              </div>
              <h3 className="font-heading font-bold mb-2">{title}</h3>
              <p className="text-sm text-muted-foreground leading-relaxed">{desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ── CTA ── -->
    <section class="bg-[#0D1A3A] text-white py-20 md:py-24">
      <div class="container mx-auto px-4 md:px-6 max-w-6xl text-center">
        <h2 class="font-heading text-3xl md:text-4xl font-bold mb-4">
          Pronto para Modernizar a Sua Fábrica?
        </h2>
        <p class="text-white/60 mb-8 max-w-md mx-auto">
          Agende uma demonstração e veja o Hestia em acção na sua indústria.
        </p>
        <div class="flex flex-col sm:flex-row justify-center gap-3">
          <Button size="lg" className="rounded-lg bg-white text-[#0D1A3A] hover:bg-white/90 font-semibold" asChild>
            <a href={`/${Astro.currentLocale}/contact`}>Agendar Demonstração</a>
          </Button>
          <Button size="lg" variant="outline" className="rounded-lg border-white/30 text-white hover:bg-white/10" asChild>
            <a href={`/${Astro.currentLocale}/prices`}>Ver Planos</a>
          </Button>
        </div>
      </div>
    </section>

  </div>
</Layout>
