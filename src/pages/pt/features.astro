---
import Layout from "@/layouts/Layout.astro";
import { Badge } from "@/components/ui/badge";
import { Button } from "@/components/ui/button";
import FeatureShowcase from "@/components/FeatureShowcase";
import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card";
import {
  Cpu,
  BarChart4,
  CloudCog,
  Smartphone,
  Shield,
  Zap,
  Layers,
  Globe,
} from "lucide-react";

const additionalFeatures = [
  {
    title: "Integração IoT",
    description: "Conecte as suas máquinas diretamente ao ERP para dados em tempo real.",
    icon: Cpu,
  },
  {
    title: "Análise Preditiva",
    description: "Antecipe falhas e necessidades de manutenção com IA.",
    icon: BarChart4,
  },
  {
    title: "Acesso na Nuvem",
    description: "Aceda aos seus dados em qualquer lugar, a qualquer hora, com segurança.",
    icon: CloudCog,
  },
  {
    title: "App Móvel",
    description: "Gestão no chão de fábrica através de aplicação nativa iOS e Android.",
    icon: Smartphone,
  },
  {
    title: "Segurança de Dados",
    description: "Encriptação de ponta a ponta e backups automáticos.",
    icon: Shield,
  },
  {
    title: "Implementação Rápida",
    description: "Comece a usar em semanas, não meses, com onboarding assistido.",
    icon: Zap,
  },
  {
    title: "Gestão de Stock",
    description: "Controlo total de inventário, desde o fio até à peça final.",
    icon: Layers,
  },
  {
    title: "Multi-Idioma",
    description: "Suporte nativo para múltiplos idiomas e moedas.",
    icon: Globe,
  },
];
---

<Layout title="Funcionalidades - Hestia ERP">
  <div class="flex flex-col min-h-screen">
    <!-- Hero Section -->
    <section class="py-20 md:py-32 relative overflow-hidden text-center">
      <div class="absolute inset-0 -z-10 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-primary/10 via-background to-background"></div>
      <div class="container mx-auto px-4 md:px-6">
        <Badge variant="outline" class="mb-6 border bg-background/50 backdrop-blur-sm">
          Potência Total
        </Badge>
        <h1 class="text-4xl md:text-5xl lg:text-7xl font-bold tracking-tight text-foreground mb-6">
          Todas as Ferramentas para <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary to-blue-400">Escalar</span>
        </h1>
        <p class="max-w-3xl mx-auto text-muted-foreground md:text-xl leading-relaxed">
          Do chão de fábrica à gestão executiva, o Hestia ERP oferece um conjunto completo de funcionalidades desenhadas especificamente para a indústria têxtil moderna.
        </p>
      </div>
    </section>

    <!-- Main Features Showcase -->
    <div class="py-12">
        <FeatureShowcase
            client:load
            locale={Astro.currentLocale}
            title="Funcionalidades Principais"
            description="O núcleo do nosso sistema, construído para a eficiência."
        />
    </div>

    <!-- Additional Features Grid -->
    <section class="py-20 bg-muted/30">
        <div class="container mx-auto px-4 md:px-6">
            <div class="text-center mb-16">
                <h2 class="text-3xl font-bold tracking-tight mb-4">Mais do que Apenas o Básico</h2>
                <p class="text-muted-foreground text-lg">Detalhes que fazem a diferença no dia-a-dia.</p>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 max-w-7xl mx-auto">
                {additionalFeatures.map((feature) => (
                    <Card class="bg-background border hover:border-primary/50 transition-all hover:shadow-md">
                        <CardHeader>
                            <div class="w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center mb-4 text-primary">
                                <feature.icon class="w-6 h-6" />
                            </div>
                            <CardTitle class="text-xl">{feature.title}</CardTitle>
                        </CardHeader>
                        <CardContent>
                            <p class="text-muted-foreground text-sm">{feature.description}</p>
                        </CardContent>
                    </Card>
                ))}
            </div>
        </div>
    </section>

    <!-- CTA -->
    <section class="py-20 md:py-32 text-center">
        <div class="container mx-auto px-4 md:px-6">
            <h2 class="text-3xl md:text-4xl font-bold tracking-tight mb-6">Pronto para Modernizar a Sua Fábrica?</h2>
            <div class="flex justify-center gap-4">
                <Button size="lg" class="rounded-full px-8">
                    <a href={`/${Astro.currentLocale}/contact`}>Agendar Demonstração</a>
                </Button>
                <Button variant="outline" size="lg" class="rounded-full px-8">
                    <a href={`/${Astro.currentLocale}/prices`}>Ver Planos</a>
                </Button>
            </div>
        </div>
    </section>
  </div>
</Layout>
