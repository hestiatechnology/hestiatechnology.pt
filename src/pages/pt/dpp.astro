---
import Layout from "@/layouts/Layout.astro";
import { Badge } from "@/components/ui/badge";
import { Button } from "@/components/ui/button";
import {
  Recycle,
  Users,
  Database,
  Link,
  Container,
  FileText,
  ShieldCheck,
} from "lucide-react";

const whatIsDpp = [
  {
    title: "Sustentabilidade e Circularidade",
    description:
      "O DPP visa tornar os produtos mais sustentáveis e circulares, fornecendo informações sobre a origem, materiais e impacto ambiental de um produto.",
    icon: Recycle,
  },
  {
    title: "Transparência",
    description:
      "Fornece aos consumidores e às empresas informações detalhadas sobre o percurso de um produto, promovendo a confiança e escolhas informadas.",
    icon: Users,
  },
  {
    title: "Registo Digital Completo",
    description:
      "Para a indústria têxtil, isto significa um registo digital completo de toda a cadeia de abastecimento, desde as matérias-primas até à peça final.",
    icon: Database,
  },
];

const hestiaBenefits = [
  {
    title: "Rastreabilidade Completa",
    description:
      "Rastreie toda a sua cadeia de abastecimento, desde as matérias-primas até ao produto acabado, garantindo conformidade.",
    icon: Link,
  },
  {
    title: "Hub de Dados Central",
    description:
      "Uma única fonte de verdade para todos os dados do seu produto, facilitando a gestão e partilha de informação exigida pelo DPP.",
    icon: Container,
  },
  {
    title: "Relatórios Automatizados",
    description:
      "Gere relatórios em conformidade com o DPP com facilidade, poupando tempo e reduzindo o risco de erros manuais.",
    icon: FileText,
  },
  {
    title: "À Prova de Futuro",
    description:
      "Mantenha-se à frente da evolução dos regulamentos e esteja preparado para o futuro digital da indústria têxtil.",
    icon: ShieldCheck,
  },
];
---

<Layout title="Conformidade Passaporte Digital de Produto (DPP) - Hestia">
  
  <!-- Hero Section -->
  <section class="py-20 md:py-32 text-center relative overflow-hidden">
    <div class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_center,_var(--tw-gradient-stops))] from-primary/10 via-background to-background"></div>
    <div class="container mx-auto px-4 md:px-6 relative z-10">
      <Badge className="mb-6 border bg-primary/10 text-primary hover:bg-primary/20 transition-colors"
        >Futuro da Indústria Têxtil</Badge
      >
      <h1
        class="text-4xl md:text-5xl lg:text-7xl font-bold tracking-tight text-foreground max-w-5xl mx-auto leading-tight"
      >
        Passaporte Digital de Produto da UE com o
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary to-blue-400"> Hestia</span>
      </h1>
      <p class="max-w-3xl mx-auto mt-6 text-muted-foreground md:text-xl leading-relaxed">
        O DPP é o novo padrão. A Hestia foi construída de raiz para garantir que a sua fábrica não só cumpre as normas, mas lidera na transparência.
      </p>
      <div class="mt-10 flex justify-center gap-4">
        <Button size="lg" className="rounded-full px-8">
          <a href={`/${Astro.currentLocale}/contact`}>Agendar Demo DPP</a>
        </Button>
      </div>
    </div>
  </section>

  <!-- What is DPP Section -->
  <section id="what-is-dpp" class="py-20 md:py-32 bg-muted/30">
    <div class="container mx-auto px-4 md:px-6">
      <div class="text-center mb-16">
        <h2 class="text-3xl font-bold tracking-tight sm:text-4xl text-foreground">
          O que é o Passaporte Digital de Produto?
        </h2>
        <p class="max-w-3xl mx-auto mt-4 text-muted-foreground md:text-lg">
          Um requisito da UE para tornar os produtos sustentáveis. O Hestia fornece a infraestrutura para gerir esta informação.
        </p>
      </div>
      <div class="grid gap-8 md:grid-cols-3">
        {whatIsDpp.map((item) => (
          <div class="flex flex-col items-center text-center p-6 bg-card rounded-xl border shadow-sm hover:shadow-md transition-all">
            <div class="p-3 bg-primary/10 rounded-full mb-4">
              <item.icon className="w-8 h-8 text-primary" />
            </div>
            <h3 class="text-xl font-bold mb-2">{item.title}</h3>
            <p class="text-muted-foreground leading-relaxed">{item.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Why Hestia Section -->
  <section id="why-hestia" class="py-20 md:py-32">
    <div class="container mx-auto px-4 md:px-6">
      <div class="text-center mb-16">
        <h2 class="text-3xl font-bold tracking-tight sm:text-4xl text-foreground">
          Porquê o Hestia para o DPP?
        </h2>
        <p class="max-w-3xl mx-auto mt-4 text-muted-foreground md:text-lg">
          Mais do que conformidade, uma vantagem competitiva.
        </p>
      </div>
      <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-4">
        {hestiaBenefits.map((item) => (
          <div class="group relative p-6 bg-background border rounded-xl hover:border-primary/50 transition-colors">
            <div class="absolute inset-0 bg-primary/5 opacity-0 group-hover:opacity-100 transition-opacity rounded-xl"></div>
            <div class="relative z-10">
              <item.icon className="w-10 h-10 text-primary mb-4" />
              <h3 class="text-lg font-bold mb-2">{item.title}</h3>
              <p class="text-sm text-muted-foreground">{item.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-20 md:py-32 text-center bg-primary/5 border-t">
    <div class="container mx-auto px-4 md:px-6">
      <h2 class="text-3xl font-bold tracking-tight sm:text-4xl text-foreground mb-6">
        Pronto para o Futuro?
      </h2>
      <p class="max-w-2xl mx-auto text-muted-foreground md:text-lg mb-8">
        Não espere pela regulação. Garanta hoje o seu lugar no futuro da indústria têxtil com a Hestia.
      </p>
      <Button size="lg" className="rounded-full px-10 h-12 text-lg shadow-lg">
        <a href={`/${Astro.currentLocale}/contact`}>Falar com Especialista</a>
      </Button>
    </div>
  </section>
</Layout>
