---
import Layout from "@/layouts/Layout.astro";
import { Badge } from "@/components/ui/badge";
import { Button } from "@/components/ui/button";
import FeatureShowcase from "@/components/FeatureShowcase";
import { features } from "@/data/pt/features.ts";
import { CheckCircle, XCircle, Zap } from "lucide-react";
import TeamSection from "@/components/TeamSection.pt";
import { Image } from "astro:assets";
import IPCALogo from "@/assets/ipca_cor.png";
import STARTIpca from "@/assets/start-ipca.png";
import SafariBackground from "@/components/SafariBackground";
---

<Layout title="Hestia ERP - A Plataforma de Operações para Fabricantes Têxteis">
  <div class="flex flex-col">
    <!-- Hero Section -->
    <section class="py-20 md:py-32 lg:py-40 text-center">
      <div class="container mx-auto px-4 md:px-6">
        <Badge className="mb-4 bg-primary text-primary-foreground">
         Construído para o futuro dos negócios
        </Badge>
        <h1
          class="text-4xl md:text-5xl lg:text-6xl font-bold tracking-tighter text-foreground"
        >
          A Plataforma de Operações para <span class="text-primary"
            >Fabricantes Têxteis</span
          >
        </h1>
        <p class="max-w-3xl mx-auto mt-4 text-muted-foreground md:text-xl">
          O Hestia ERP transforma os seus maiores desafios operacionais nas suas maiores forças. Passe do caos operacional para o controlo total.
        </p>
        <div class="mt-8 flex justify-center gap-4">
          <Button size="lg">
            <a href={`/${Astro.currentLocale}/contact`}>Agendar uma Demonstração</a>
          </Button>
          <Button size="lg" variant="outline">
            <a href={`/${Astro.currentLocale}/prices`}>Ver Preços</a>
          </Button>
        </div>
		<div class="mt-8">
			<SafariBackground client:only="react" />
		</div>
      </div>
    </section>

<FeatureShowcase
client:load
features={features}
title="Todas as ferramentas que precisa"
description="O Hestia ERP é uma plataforma modular que lhe permite escolher as ferramentas que precisa para gerir o seu negócio."
/>

    <!-- DPP Section -->
    <section id="dpp" class="py-12 md:py-24 bg-muted">
      <div class="container mx-auto px-4 md:px-6">
        <div class="text-center">
          <Zap className="w-12 h-12 text-primary mx-auto" />
          <h2
            class="mt-4 text-3xl font-bold tracking-tighter sm:text-4xl text-foreground"
          >
            Prepare-se para o Passaporte Digital de Produto (DPP)
          </h2>
          <p
            class="max-w-3xl mx-auto mt-4 text-muted-foreground md:text-lg"
          >
            O futuro Passaporte Digital de Produto da UE irá revolucionar a indústria têxtil, exigindo uma transparência e rastreabilidade sem precedentes. O Hestia ERP foi concebido para cumprir estas novas normas desde o primeiro dia, proporcionando-lhe uma solução robusta e escalável para garantir que a sua empresa não só está em conformidade, como também é líder na nova era digital.
          </p>
          <div class="mt-8">
            <Button>
              <a href={`/${Astro.currentLocale}/dpp`}>Saiba Mais Sobre o DPP</a>
            </Button>
          </div>
        </div>
      </div>
    </section>

    <!-- Team Section -->
    <TeamSection client:load />

    <!-- Partners Section -->
    <section id="partners" class="py-12 md:py-24">
      <div class="container mx-auto">
        <h2
          class="text-3xl font-bold tracking-tighter sm:text-5xl text-foreground mb-8 text-center"
        >
          Os Nossos Parceiros
        </h2>
        <div
          class="flex flex-col md:flex-row items-center justify-center gap-x-12 gap-y-8"
        >
          <Image
            src={IPCALogo}
            height={120}
            alt="IPCA Logo"
            class="grayscale hover:grayscale-0 transition-all"
          />
          <Image
            src={STARTIpca}
            height={120}
            alt="START IPCA Logo"
            class="grayscale hover:grayscale-0 transition-all"
          />
        </div>
      </div>
    </section>
  </div>
</Layout>
