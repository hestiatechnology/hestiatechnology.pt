---
import Layout from "@/layouts/Layout.astro";
import { Button } from "@/components/ui/button";
import FeatureShowcase from "@/components/FeatureShowcase";
import { features } from "@/data/pt/features.ts";
import TeamSection from "@/components/TeamSection.pt";
import { Image } from "astro:assets";
import IPCALogo from "@/assets/ipca_cor.png";
import STARTIpca from "@/assets/start-ipca.png";
---

<Layout title="Hestia ERP - A Plataforma de Operações para Fabricantes Têxteis">
  <div class="flex flex-col">
    <!-- Hero Section -->
    <section class="min-h-screen flex items-center justify-center text-center bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-primary/20 via-background to-background py-20 md:py-32">
      <div class="container mx-auto px-4 md:px-6">
        <h1
          class="text-5xl md:text-7xl lg:text-8xl font-bold tracking-tighter text-foreground"
        >
          A Plataforma de Operações com IA para <span class="text-primary"
            >Fabricantes</span
          >
        </h1>
        <p class="max-w-3xl mx-auto mt-6 text-lg text-muted-foreground md:text-xl">
          O Hestia é o ERP inteligente para fabricantes têxteis, automatizando a
          conformidade com a UE e o acompanhamento da produção.
        </p>
        <div class="mt-10 flex justify-center gap-4">
          <Button size="lg">
            <a href={`/${Astro.currentLocale}/contact`}>Agendar uma Demonstração</a>
          </Button>
          <Button size="lg" variant="outline">
            <a href={`/${Astro.currentLocale}/prices`}>Ver Preços</a>
          </Button>
        </div>
      </div>
    </section>

    <!-- Features Section -->
    <div class="py-20 md:py-32">
      <FeatureShowcase
        client:load
        features={features}
        title="O ERP Inteligente para Fabricantes Têxteis"
        description="Automatizamos a conformidade com a UE e o acompanhamento da produção, substituindo sistemas legados dispendiosos e pouco fiáveis."
      />
    </div>

    <!-- Comparison Section -->
    <section class="py-20 md:py-32 bg-muted/30">
      <div class="container mx-auto px-4 md:px-6">
        <div class="text-center mb-16">
          <h2 class="text-3xl font-bold tracking-tighter sm:text-5xl text-foreground">
            Porquê Mudar para o Hestia?
          </h2>
          <p class="max-w-2xl mx-auto mt-4 text-muted-foreground md:text-xl">
            Deixe de lutar com software desatualizado. Atualize para o futuro da indústria.
          </p>
        </div>
        <div class="grid md:grid-cols-2 gap-8 max-w-4xl mx-auto">
          <!-- Legacy ERP Card -->
          <div class="bg-card border rounded-xl p-8 opacity-70">
            <h3 class="text-xl font-bold text-muted-foreground mb-6">ERPs Legados</h3>
            <ul class="space-y-4">
              <li class="flex items-center gap-3 text-muted-foreground">
                <span class="text-red-500 text-xl">✕</span>
                Introdução Manual de Dados
              </li>
              <li class="flex items-center gap-3 text-muted-foreground">
                <span class="text-red-500 text-xl">✕</span>
                Informação Isolada
              </li>
              <li class="flex items-center gap-3 text-muted-foreground">
                <span class="text-red-500 text-xl">✕</span>
                Atualizações Dispendiosas
              </li>
              <li class="flex items-center gap-3 text-muted-foreground">
                <span class="text-red-500 text-xl">✕</span>
                Sem Suporte DPP
              </li>
            </ul>
          </div>

          <!-- Hestia ERP Card -->
          <div class="bg-card border-2 border-primary rounded-xl p-8 shadow-lg relative overflow-hidden">
            <div class="absolute top-0 right-0 bg-primary text-primary-foreground text-xs font-bold px-3 py-1 rounded-bl-lg">
              RECOMENDADO
            </div>
            <h3 class="text-2xl font-bold text-foreground mb-6">Hestia ERP</h3>
            <ul class="space-y-4">
              <li class="flex items-center gap-3 font-medium">
                <span class="text-green-500 text-xl">✓</span>
                Automação por IA
              </li>
              <li class="flex items-center gap-3 font-medium">
                <span class="text-green-500 text-xl">✓</span>
                Visibilidade em Tempo Real
              </li>
              <li class="flex items-center gap-3 font-medium">
                <span class="text-green-500 text-xl">✓</span>
                Atualizações SaaS
              </li>
              <li class="flex items-center gap-3 font-medium">
                <span class="text-green-500 text-xl">✓</span>
                Conformidade DPP Nativa
              </li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- DPP Section -->
    <section id="dpp" class="py-20 md:py-32">
      <div class="container mx-auto px-4 md:px-6">
        <div class="text-center max-w-4xl mx-auto">
          <h2
            class="text-4xl font-bold tracking-tighter sm:text-5xl text-foreground"
          >
            Prepare-se para o Passaporte Digital de Produto (DPP)
          </h2>
          <p
            class="max-w-3xl mx-auto mt-6 text-lg text-muted-foreground"
          >
            O futuro Passaporte Digital de Produto da UE irá revolucionar a indústria têxtil, exigindo uma transparência e rastreabilidade sem precedentes. O Hestia ERP foi concebido para cumprir estas novas normas desde o primeiro dia, proporcionando-lhe uma solução robusta e escalável para garantir que a sua empresa não só está em conformidade, como também é líder na nova era digital.
          </p>
          <div class="mt-10">
            <Button size="lg">
              <a href={`/${Astro.currentLocale}/dpp`}>Saiba Mais Sobre o DPP</a>
            </Button>
          </div>
        </div>
      </div>
    </section>

    <!-- Team Section -->
    <div class="py-20 md:py-32">
      <TeamSection client:load />
    </div>

    <!-- Partners Section -->
    <section id="partners" class="py-20 md:py-32">
      <div class="container mx-auto">
        <h2
          class="text-4xl font-bold tracking-tighter sm:text-5xl text-foreground mb-12 text-center"
        >
          Os Nossos Parceiros
        </h2>
        <div
          class="flex flex-col md:flex-row items-center justify-center gap-x-16 gap-y-10"
        >
          <Image
            src={IPCALogo}
            height={100}
            alt="IPCA Logo"
            class=""
          />
          <Image
            src={STARTIpca}
            height={100}
            alt="START IPCA Logo"
            class=""
          />
        </div>
      </div>
    </section>
  </div>
</Layout>
