---
import Layout from "@/layouts/Layout.astro";
import { Button } from "@/components/ui/button";
import FeatureShowcase from "@/components/FeatureShowcase";
import { HowItWorks } from "@/components/HowItWorks.pt";
import { Image } from "astro:assets";
import IPCALogo from "@/assets/ipca_cor.png";
import STARTIpca from "@/assets/start-ipca.png";
import { Magnetic } from "@/components/ui/magnetic";
import { GoogleCalendarButton } from "@/components/GoogleCalendarButton";
import { Check, X } from "lucide-react";
---

<Layout title="Hestia ERP - A Plataforma de Operações para Fabricantes Têxteis">
  <div class="flex flex-col">

    <!-- ── Hero ── -->
    <section class="pt-20 pb-16 md:pt-28 md:pb-24 overflow-hidden">
      <div class="container mx-auto px-4 md:px-6 max-w-6xl">
        <div class="grid lg:grid-cols-[1fr,380px] gap-12 lg:gap-20 items-center">

          <!-- Left: copy -->
          <div class="space-y-7 max-w-2xl animate-fade-up">
            <div class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-widest text-primary bg-primary/8 px-3 py-1.5 rounded-full border border-primary/20">
              Regulamento ESPR da UE — 2027
            </div>
            <h1 class="font-heading text-5xl md:text-6xl lg:text-[3.75rem] xl:text-7xl font-bold tracking-tight leading-[1.06] text-foreground">
              O ERP com IA para Fabricantes Têxteis
            </h1>
            <p class="text-lg text-muted-foreground leading-relaxed max-w-xl">
              Hestia automatiza a conformidade com a UE, o acompanhamento da produção e os Passaportes Digitais de Produto — substituindo sistemas legados dispendiosos e pouco fiáveis.
            </p>
            <div class="flex flex-col sm:flex-row gap-3 pt-1">
              <GoogleCalendarButton client:load label="Agendar uma Demonstração" size="lg" />
              <Magnetic client:load>
                <Button size="lg" variant="outline" className="rounded-lg text-base h-11 px-7">
                  <a href={`/${Astro.currentLocale}/features`}>Ver Funcionalidades</a>
                </Button>
              </Magnetic>
            </div>
          </div>

          <!-- Right: floating stat cards -->
          <div class="hidden lg:flex flex-col gap-3 animate-fade-up [animation-delay:300ms]">
            <div class="bg-card border border-border rounded-2xl p-5 shadow-sm">
              <div class="font-heading text-4xl font-bold text-foreground mb-1">2027</div>
              <div class="text-sm text-muted-foreground">Data-Alvo DPP da UE</div>
            </div>
            <div class="bg-card border border-border rounded-2xl p-5 shadow-sm ml-8">
              <div class="font-heading text-4xl font-bold text-foreground mb-1">€166B</div>
              <div class="text-sm text-muted-foreground">Receita da Indústria Têxtil da UE</div>
            </div>
            <div class="bg-primary rounded-2xl p-5 shadow-md shadow-primary/20">
              <div class="font-heading text-4xl font-bold text-white mb-1">27</div>
              <div class="text-sm text-white/70">Países da UE Obrigados a Conformidade</div>
            </div>
          </div>
        </div>

        <!-- Mobile stats row -->
        <div class="lg:hidden grid grid-cols-3 gap-3 mt-10">
          {[
            { value: "2027", label: "DPP Target" },
            { value: "€166B", label: "EU Textile Market" },
            { value: "27", label: "EU Countries" },
          ].map((s) => (
            <div class="bg-card border border-border rounded-xl p-4 text-center">
              <div class="font-heading text-2xl font-bold">{s.value}</div>
              <div class="text-xs text-muted-foreground mt-1">{s.label}</div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ── Institutional Partners ── -->
    <div class="border-y border-border/60 py-8 bg-muted/20">
      <div class="container mx-auto px-4 max-w-6xl">
        <div class="flex flex-wrap items-center justify-between gap-8">
          <p class="text-xs font-bold uppercase tracking-widest text-muted-foreground/60">
            Apoio Institucional
          </p>
          <div class="flex flex-wrap items-center gap-x-10 gap-y-4 opacity-50 hover:opacity-80 transition-opacity duration-500">
            <Image src={IPCALogo} height={32} alt="IPCA" class="h-8 w-auto object-contain grayscale" />
            <Image src={STARTIpca} height={32} alt="Start IPCA" class="h-8 w-auto object-contain grayscale" />
          </div>
        </div>
      </div>
    </div>

    <!-- ── Features Showcase ── -->
    <div class="py-20 md:py-32">
      <FeatureShowcase
        client:load
        locale={Astro.currentLocale}
        title="O ERP Inteligente para Fabricantes Têxteis"
        description="Automatizamos a conformidade com a UE e o acompanhamento da produção, substituindo sistemas legados dispendiosos e pouco fiáveis."
      />
    </div>

    <!-- ── How It Works ── -->
    <HowItWorks client:visible />

    <!-- ── Comparison ── -->
    <section class="py-20 md:py-32">
      <div class="container mx-auto px-4 md:px-6 max-w-6xl">
        <div class="grid lg:grid-cols-[1fr,2fr] gap-16 items-start">
          <div>
            <p class="text-[11px] font-bold uppercase tracking-widest text-primary mb-4">Porquê Mudar</p>
            <h2 class="font-heading text-3xl md:text-4xl font-bold leading-tight mb-4">
              Feito para o ESPR.<br/>Não adaptado.
            </h2>
            <p class="text-muted-foreground leading-relaxed text-sm">
              Os ERPs legados não foram criados para o ESPR, DPP ou rastreabilidade têxtil em tempo real. O Hestia foi.
            </p>
          </div>

          <div class="grid md:grid-cols-2 gap-4">
            <!-- Legacy -->
            <div class="border border-border rounded-2xl p-7 bg-muted/20">
              <h3 class="font-heading text-lg font-bold text-muted-foreground mb-6">ERPs Legados</h3>
              <ul class="space-y-4">
                {[
                  "Sem conformidade ESPR / DPP integrada",
                  "Rastreio manual de lotes e partidas de fio",
                  "Consultores de TI para cada atualização",
                  "Sem monitorização em tempo real",
                ].map((item) => (
                  <li class="flex items-start gap-3 text-sm text-muted-foreground">
                    <div class="w-5 h-5 rounded-full bg-red-100 text-red-500 dark:bg-red-900/30 flex items-center justify-center shrink-0 mt-0.5">
                      <X class="w-3 h-3" />
                    </div>
                    {item}
                  </li>
                ))}
              </ul>
            </div>

            <!-- Hestia -->
            <div class="border-2 border-primary/30 rounded-2xl p-7 bg-primary/4 relative overflow-hidden">
              <div class="absolute top-0 right-0 bg-primary text-white text-[10px] font-bold px-3 py-1 rounded-bl-xl tracking-widest uppercase">
                Hestia
              </div>
              <h3 class="font-heading text-lg font-bold mb-6">Hestia ERP</h3>
              <ul class="space-y-4">
                {[
                  "Geração nativa de DPP (pronto para ESPR)",
                  "Rastreabilidade total da fibra ao produto final",
                  "Atualizações regulatórias automáticas via SaaS",
                  "Monitorização da produção em tempo real",
                ].map((item) => (
                  <li class="flex items-start gap-3 text-sm font-medium">
                    <div class="w-5 h-5 rounded-full bg-primary/15 text-primary flex items-center justify-center shrink-0 mt-0.5">
                      <Check class="w-3 h-3" />
                    </div>
                    {item}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ── Testimonials ── -->
    <section class="py-20 md:py-28 bg-muted/20 border-y border-border/60">
      <div class="container mx-auto px-4 md:px-6 max-w-6xl">
        <div class="grid lg:grid-cols-[1fr,2fr] gap-16 items-start">
          <div>
            <p class="text-[11px] font-bold uppercase tracking-widest text-primary mb-4">
              Testemunhos
            </p>
            <h2 class="font-heading text-3xl font-bold leading-tight">
              O Que Dizem os Fabricantes
            </h2>
          </div>
          <div class="grid sm:grid-cols-1 gap-6">
            {[
              {
                quote: "Passávamos semanas por trimestre a preparar documentos de conformidade manualmente. O Hestia reduziu isso para minutos. Só a geração de DPP justifica toda a plataforma.",
                name: "Responsável de Produção",
                company: "Fabricante Têxtil, Norte de Portugal",
              },
              {
                quote: "O nosso ERP legado precisava de um consultor de TI sempre que as regulamentações mudavam. Com o Hestia atualiza automaticamente. É um modelo completamente diferente.",
                name: "Diretor de Operações",
                company: "Empresa de Tecelagem, Braga",
              },
              {
                quote: "O painel em tempo real mostrou-nos exatamente onde estavam os nossos estrangulamentos. Melhorámos o rendimento sem adicionar recursos humanos. O ROI foi visível no primeiro mês.",
                name: "Proprietário de Fábrica",
                company: "Fiação, Guimarães",
              },
            ].map((t) => (
              <div class="bg-card border border-border/60 rounded-2xl p-7 space-y-5">
                <div class="flex gap-0.5 text-primary text-sm">★★★★★</div>
                <p class="text-foreground/80 text-sm leading-relaxed">"{t.quote}"</p>
                <div class="pt-2 border-t border-border/60">
                  <div class="font-semibold text-sm">{t.name}</div>
                  <div class="text-xs text-muted-foreground mt-0.5">{t.company}</div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- ── DPP Regulation — dark section ── -->
    <section class="bg-[#0D1A3A] text-white py-24 md:py-32">
      <div class="container mx-auto px-4 md:px-6 max-w-6xl">
        <div class="grid lg:grid-cols-[1fr,1fr] gap-16 items-center">
          <div class="space-y-6">
            <div class="inline-block bg-white/10 text-white/80 text-[10px] font-bold px-3 py-1.5 rounded-full uppercase tracking-widest border border-white/15">
              Regulamento da UE · ESPR
            </div>
            <h2 class="font-heading text-4xl md:text-5xl font-bold leading-tight">
              Os Passaportes Digitais São Obrigatórios a Partir de 2027
            </h2>
          </div>
          <div class="space-y-6">
            <p class="text-white/60 text-base leading-relaxed">
              O Regulamento de Ecodesign para Produtos Sustentáveis da UE (ESPR) torna os Passaportes Digitais de Produto obrigatórios para têxteis. Produtos não conformes serão bloqueados nos mercados da UE.
            </p>
            <p class="text-white/60 text-base leading-relaxed">
              O Hestia gera DPPs automaticamente a partir dos seus dados de produção existentes — sem consultores externos, sem introdução manual de dados, sem perturbação das operações.
            </p>
            <div class="flex flex-col sm:flex-row gap-3 pt-2">
              <Button size="lg" className="rounded-lg bg-white text-[#0D1A3A] hover:bg-white/90 font-semibold">
                <a href={`/${Astro.currentLocale}/dpp`}>Saiba Mais Sobre o DPP</a>
              </Button>
              <GoogleCalendarButton client:load label="Falar com um Especialista" variant="outline" size="lg" className="border-white/30 text-white hover:bg-white/10" />
            </div>
          </div>
        </div>
      </div>
    </section>

  </div>
</Layout>
