---
import Layout from "@/layouts/Layout.astro";
import { Button } from "@/components/ui/button";
import { Image } from "astro:assets";
import IPCALogo from "@/assets/ipca_cor.png";
import STARTIpca from "@/assets/start-ipca.png";
import { Magnetic } from "@/components/ui/magnetic";
import { GoogleCalendarButton } from "@/components/GoogleCalendarButton";
import {
  Check, X, ArrowRight, Factory, ShieldCheck, Cpu,
  FileText, Plug, ScanLine,
  Clock, AlertTriangle, TrendingUp, Lock, Layers
} from "lucide-react";
---

<Layout title="Hestia - O Sistema Operativo da Sua Empresa Têxtil" darkHero={true}>
  <div class="flex flex-col">

    <!-- ══════════════════════════════════════════════════ -->
    <!-- ── HERO - Full-impact, dark, cinematic ── -->
    <!-- ══════════════════════════════════════════════════ -->
    <section class="relative min-h-[92vh] flex items-center overflow-hidden bg-[#060E24]">
      <!-- Animated gradient orbs -->
      <div class="absolute inset-0 overflow-hidden pointer-events-none">
        <div class="absolute top-1/4 left-1/4 w-[600px] h-[600px] bg-primary/20 rounded-full blur-[120px] animate-pulse-glow"></div>
        <div class="absolute bottom-1/4 right-1/4 w-[500px] h-[500px] bg-[#6B8BF5]/15 rounded-full blur-[100px] animate-pulse-glow [animation-delay:1.5s]"></div>
      </div>
      <!-- Subtle grid overlay -->
      <div class="absolute inset-0 opacity-[0.03]" style="background-image: linear-gradient(to right, white 1px, transparent 1px), linear-gradient(to bottom, white 1px, transparent 1px); background-size: 48px 48px;"></div>

      <div class="container relative mx-auto px-4 md:px-6 max-w-6xl py-24 md:py-32">
        <div class="max-w-4xl mx-auto text-center">
          <!-- Urgency badge -->
          <div class="inline-flex items-center gap-2.5 text-xs font-bold uppercase tracking-widest text-white/70 bg-white/[0.06] px-4 py-2 rounded-full border border-white/10 mb-8 animate-fade-up backdrop-blur-sm">
            <span class="relative flex h-2 w-2">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-amber-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-amber-400"></span>
            </span>
            Passaportes Digitais da UE obrigatórios a partir de 2027
          </div>

          <!-- Main headline -->
          <h1 class="font-heading text-5xl sm:text-6xl md:text-7xl lg:text-8xl font-extrabold tracking-tight leading-[0.95] text-white mb-6 animate-fade-up [animation-delay:150ms]">
            O <span class="text-gradient bg-gradient-to-r from-[#6B8BF5] via-[#A78BFA] to-[#6B8BF5] bg-[length:200%_auto] animate-gradient-x">sistema operativo</span><br/>
            da sua empresa têxtil
          </h1>

          <!-- Subheadline -->
          <p class="text-lg md:text-xl text-white/50 leading-relaxed max-w-2xl mx-auto mb-10 animate-fade-up [animation-delay:300ms]">
            A Hestia substitui sistemas legados fragmentados por uma plataforma inteligente - produção, conformidade, IA, IoT e Passaportes Digitais de Produto - desenvolvida especificamente para empresas têxteis.
          </p>

          <!-- Dual CTA -->
          <div class="flex flex-col sm:flex-row items-center justify-center gap-4 animate-fade-up [animation-delay:450ms]">
            <GoogleCalendarButton client:load label="Marcar Demonstração" size="lg" className="bg-white! text-[#060E24]! hover:bg-white/90! shadow-xl! shadow-white/10! rounded-xl! text-base! font-bold! h-13! px-8!" />
            <Magnetic client:load>
              <a href="/pt/features" class="inline-flex items-center gap-2 text-white/70 hover:text-white text-base font-medium transition-colors group">
                Ver como funciona
                <ArrowRight className="w-4 h-4 group-hover:translate-x-1 transition-transform" />
              </a>
            </Magnetic>
          </div>

          <!-- Stats bar -->
          <div class="grid grid-cols-3 gap-6 md:gap-12 mt-16 md:mt-24 pt-10 border-t border-white/10 animate-fade-up [animation-delay:600ms]">
            {[
              { value: "2027", label: "Prazo DPP da UE" },
              { value: "€166B", label: "Mercado Têxtil da UE" },
              { value: "27", label: "Países Devem Cumprir" },
            ].map((stat) => (
              <div class="text-center">
                <div class="font-heading text-3xl md:text-4xl font-extrabold text-white tabular-nums">{stat.value}</div>
                <div class="text-xs md:text-sm text-white/40 mt-1">{stat.label}</div>
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- Scroll indicator -->
      <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 text-white/30">
        <div class="w-5 h-8 rounded-full border border-white/20 flex items-start justify-center p-1.5">
          <div class="w-1 h-2 bg-white/40 rounded-full animate-scroll"></div>
        </div>
      </div>
    </section>

    <!-- ══════════════════════════════════════════════════ -->
    <!-- ── TRUST BAR - Institutional partners ── -->
    <!-- ══════════════════════════════════════════════════ -->
    <div class="border-b border-border/60 py-8 bg-muted/30">
      <div class="container mx-auto px-4 max-w-6xl">
        <div class="flex flex-wrap items-center justify-center md:justify-between gap-8">
          <p class="text-[10px] font-bold uppercase tracking-[0.2em] text-muted-foreground/50">
            Apoiado por instituições de referência
          </p>
          <div class="flex flex-wrap items-center gap-x-12 gap-y-4 opacity-40 hover:opacity-70 transition-opacity duration-500">
            <Image src={IPCALogo} height={36} alt="IPCA" class="h-9 w-auto object-contain grayscale" />
            <Image src={STARTIpca} height={36} alt="Start IPCA" class="h-9 w-auto object-contain grayscale" />
          </div>
        </div>
      </div>
    </div>

    <!-- ══════════════════════════════════════════════════ -->
    <!-- ── THE PROBLEM - Agitate pain points ── -->
    <!-- ══════════════════════════════════════════════════ -->
    <section class="py-24 md:py-32">
      <div class="container mx-auto px-4 md:px-6 max-w-6xl">
        <div class="text-center mb-16">
          <p class="text-[11px] font-bold uppercase tracking-widest text-red-500/80 mb-4">O Problema</p>
          <h2 class="font-heading text-3xl md:text-5xl font-bold tracking-tight leading-tight mb-5">
            Os sistemas legados estão a drenar<br class="hidden md:block" /> os recursos da sua empresa têxtil
          </h2>
          <p class="text-muted-foreground text-lg max-w-2xl mx-auto leading-relaxed">
            A maioria dos empresas têxteis depende de software desconectado e desatualizado que nunca foi concebido para conformidade moderna ou operações em tempo real.
          </p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-5">
          {[
            {
              icon: "AlertTriangle",
              title: "Zero Suporte DPP",
              description: "Os ERPs legados não têm capacidade de Passaporte Digital de Produto. Consultores externos cobram mais de 50.000€ para adaptações.",
              color: "text-red-500",
              bg: "bg-red-500/10",
            },
            {
              icon: "Clock",
              title: "Meses para Implementar",
              description: "As implementações tradicionais de ERP demoram 6 a 18 meses e requerem equipas de TI dedicadas para cada atualização.",
              color: "text-orange-500",
              bg: "bg-orange-500/10",
            },
            {
              icon: "TrendingUp",
              title: "Custos Ocultos Acumulam-se",
              description: "Licenças, horas de consultoria, manutenção de servidores, formação - o custo real é 3 a 5 vezes o preço anunciado.",
              color: "text-amber-500",
              bg: "bg-amber-500/10",
            },
            {
              icon: "Lock",
              title: "Dependência do Fornecedor",
              description: "Formatos proprietários e APIs fechadas significam que os seus dados estão presos. Os custos de migração mantêm-no refém.",
              color: "text-rose-500",
              bg: "bg-rose-500/10",
            },
          ].map((item) => (
            <div class="border border-border rounded-2xl p-7 bg-card hover:shadow-md transition-all group">
              <div class={`w-11 h-11 rounded-xl ${item.bg} flex items-center justify-center mb-5`}>
                {item.icon === "AlertTriangle" && <AlertTriangle className={`w-5 h-5 ${item.color}`} />}
                {item.icon === "Clock" && <Clock className={`w-5 h-5 ${item.color}`} />}
                {item.icon === "TrendingUp" && <TrendingUp className={`w-5 h-5 ${item.color}`} />}
                {item.icon === "Lock" && <Lock className={`w-5 h-5 ${item.color}`} />}
              </div>
              <h3 class="font-heading font-bold text-lg mb-2">{item.title}</h3>
              <p class="text-sm text-muted-foreground leading-relaxed">{item.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ══════════════════════════════════════════════════ -->
    <!-- ── THE SOLUTION - Feature benefits ── -->
    <!-- ══════════════════════════════════════════════════ -->
    <section class="py-24 md:py-32 bg-muted/30 border-y border-border/60">
      <div class="container mx-auto px-4 md:px-6 max-w-6xl">
        <div class="text-center mb-16">
          <p class="text-[11px] font-bold uppercase tracking-widest text-primary mb-4">A Solução</p>
          <h2 class="font-heading text-3xl md:text-5xl font-bold tracking-tight leading-tight mb-5">
            Uma plataforma. Todas as camadas.<br class="hidden md:block" /> Zero fricção.
          </h2>
          <p class="text-muted-foreground text-lg max-w-2xl mx-auto leading-relaxed">
            A Hestia liga produção, conformidade e inteligência num único sistema que funciona desde o primeiro dia.
          </p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          {[
            {
              icon: "Factory",
              title: "Gestão de Produção",
              description: "Orquestração das operações têxteis em tempo real. Acompanhe encomendas, monitorize máquinas e otimize fluxos de trabalho - tudo num único painel.",
              tag: "Core",
            },
            {
              icon: "ShieldCheck",
              title: "Motor de Conformidade UE",
              description: "Conformidade ESPR automática com atualizações regulamentares integradas. Fique à frente de 2027 sem consultores nem auditorias manuais.",
              tag: "Conformidade",
            },
            {
              icon: "FileText",
              title: "Passaportes Digitais de Produto",
              description: "Gere DPPs em conformidade com a UE automaticamente a partir dos seus dados de produção. Rastreabilidade completa da fibra à peça incluída.",
              tag: "DPP",
            },
            {
              icon: "Cpu",
              title: "Analítica com IA",
              description: "Manutenção preditiva, previsão de procura e otimização de qualidade. Tome decisões baseadas em dados em tempo real.",
              tag: "Inteligência",
            },
            {
              icon: "Plug",
              title: "Integração IoT",
              description: "Ligue as suas máquinas diretamente à Hestia. Recolha de dados em tempo real, alertas e monitorização - zero introdução manual.",
              tag: "IoT",
            },
            {
              icon: "Layers",
              title: "Inventário e Cadeia de Abastecimento",
              description: "Controlo total de inventário, das matérias-primas aos produtos acabados. Gestão de fornecedores e aprovisionamento automatizado.",
              tag: "Operações",
            },
          ].map((feature) => (
            <div class="relative border border-border rounded-2xl p-8 bg-card hover:border-primary/40 hover:shadow-lg transition-all group overflow-hidden">
              <div class="absolute top-0 right-0 bg-primary/8 text-primary text-[10px] font-bold px-3 py-1.5 rounded-bl-xl tracking-widest uppercase">
                {feature.tag}
              </div>
              <div class="w-12 h-12 rounded-xl bg-primary/10 flex items-center justify-center mb-6 group-hover:bg-primary group-hover:text-white transition-all duration-300">
                {feature.icon === "Factory" && <Factory className="w-6 h-6 text-primary group-hover:text-white transition-colors" />}
                {feature.icon === "ShieldCheck" && <ShieldCheck className="w-6 h-6 text-primary group-hover:text-white transition-colors" />}
                {feature.icon === "FileText" && <FileText className="w-6 h-6 text-primary group-hover:text-white transition-colors" />}
                {feature.icon === "Cpu" && <Cpu className="w-6 h-6 text-primary group-hover:text-white transition-colors" />}
                {feature.icon === "Plug" && <Plug className="w-6 h-6 text-primary group-hover:text-white transition-colors" />}
                {feature.icon === "Layers" && <Layers className="w-6 h-6 text-primary group-hover:text-white transition-colors" />}
              </div>
              <h3 class="font-heading font-bold text-xl mb-3">{feature.title}</h3>
              <p class="text-sm text-muted-foreground leading-relaxed">{feature.description}</p>
            </div>
          ))}
        </div>

        <div class="text-center mt-12">
          <a href="/pt/features" class="inline-flex items-center gap-2 text-primary font-semibold hover:gap-3 transition-all">
            Explorar todas as funcionalidades
            <ArrowRight className="w-4 h-4" />
          </a>
        </div>
      </div>
    </section>

    <!-- ══════════════════════════════════════════════════ -->
    <!-- ── HOW IT WORKS - 3 steps ── -->
    <!-- ══════════════════════════════════════════════════ -->
    <section class="py-24 md:py-32">
      <div class="container mx-auto px-4 md:px-6 max-w-6xl">
        <div class="text-center mb-16">
          <p class="text-[11px] font-bold uppercase tracking-widest text-primary mb-4">Como Funciona</p>
          <h2 class="font-heading text-3xl md:text-5xl font-bold tracking-tight leading-tight mb-5">
            Operacional em semanas. Não em meses.
          </h2>
          <p class="text-muted-foreground text-lg max-w-xl mx-auto">
            Três passos para transformar o funcionamento da sua empresa têxtil.
          </p>
        </div>

        <div class="grid md:grid-cols-3 gap-8 md:gap-6">
          {[
            {
              step: "01",
              icon: "Plug",
              title: "Ligue os Seus Sistemas",
              description: "Integramos com as suas máquinas, ERPs e fluxos de trabalho existentes. A sua equipa continua a trabalhar enquanto configuramos tudo. Implementação típica: 2 a 4 semanas.",
            },
            {
              step: "02",
              icon: "ScanLine",
              title: "Veja Tudo em Tempo Real",
              description: "Painéis inteligentes com IA dão-lhe visibilidade instantânea sobre produção, qualidade e conformidade. Identifique ineficiências que nunca soube que existiam.",
            },
            {
              step: "03",
              icon: "ShieldCheck",
              title: "Cresça com Confiança",
              description: "Gere DPPs automaticamente, cumpra os objetivos de conformidade da UE e expanda para novos mercados. As atualizações regulamentares acontecem em segundo plano.",
            },
          ].map((step, i) => (
            <div class="relative">
              {i < 2 && (
                <div class="hidden md:block absolute top-12 left-full w-full h-px bg-gradient-to-r from-border to-transparent -translate-x-1/2 z-0"></div>
              )}
              <div class="relative bg-card border border-border rounded-2xl p-8 hover:shadow-lg transition-all h-full">
                <div class="flex items-center gap-4 mb-6">
                  <div class="w-12 h-12 rounded-full bg-primary text-white flex items-center justify-center font-heading font-bold text-sm shrink-0">
                    {step.step}
                  </div>
                  <div class="w-10 h-10 rounded-xl bg-primary/10 flex items-center justify-center">
                    {step.icon === "Plug" && <Plug className="w-5 h-5 text-primary" />}
                    {step.icon === "ScanLine" && <ScanLine className="w-5 h-5 text-primary" />}
                    {step.icon === "ShieldCheck" && <ShieldCheck className="w-5 h-5 text-primary" />}
                  </div>
                </div>
                <h3 class="font-heading text-xl font-bold mb-3">{step.title}</h3>
                <p class="text-sm text-muted-foreground leading-relaxed">{step.description}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ══════════════════════════════════════════════════ -->
    <!-- ── COMPARISON - Legacy vs Hestia ── -->
    <!-- ══════════════════════════════════════════════════ -->
    <section class="py-24 md:py-32 bg-muted/30 border-y border-border/60">
      <div class="container mx-auto px-4 md:px-6 max-w-6xl">
        <div class="text-center mb-16">
          <p class="text-[11px] font-bold uppercase tracking-widest text-primary mb-4">Porquê Mudar</p>
          <h2 class="font-heading text-3xl md:text-5xl font-bold tracking-tight leading-tight mb-5">
            Construído para ESPR. Não adaptado à pressa.
          </h2>
          <p class="text-muted-foreground text-lg max-w-2xl mx-auto">
            Descubra porque é que os fabricantes mais inovadores estão a substituir ferramentas legadas pela Hestia.
          </p>
        </div>

        <div class="grid md:grid-cols-2 gap-6 max-w-4xl mx-auto">
          <!-- Legacy -->
          <div class="border border-border rounded-2xl p-8 bg-card/50">
            <h3 class="font-heading text-xl font-bold text-muted-foreground mb-8">Sistemas Legados</h3>
            <ul class="space-y-5">
              {[
                "Sem conformidade ESPR ou DPP",
                "6 a 18 meses para implementar",
                "Rastreio manual de lotes de fio",
                "Consultores de TI para cada atualização",
                "Sem visibilidade em tempo real",
                "Dados presos em silos",
                "Mais de 50.000€/ano em custos ocultos",
              ].map((item) => (
                <li class="flex items-start gap-3 text-sm text-muted-foreground">
                  <div class="w-5 h-5 rounded-full bg-red-100 text-red-500 dark:bg-red-900/30 flex items-center justify-center shrink-0 mt-0.5">
                    <X className="w-3 h-3" />
                  </div>
                  {item}
                </li>
              ))}
            </ul>
          </div>

          <!-- Hestia -->
          <div class="border-2 border-primary/30 rounded-2xl p-8 bg-primary/[0.03] relative overflow-hidden">
            <div class="absolute top-0 right-0 bg-primary text-white text-[10px] font-bold px-4 py-1.5 rounded-bl-xl tracking-widest uppercase">
              Hestia OS
            </div>
            <h3 class="font-heading text-xl font-bold mb-8">Hestia</h3>
            <ul class="space-y-5">
              {[
                "Geração nativa de DPP da UE (pronto para ESPR)",
                "Operacional em 2 a 4 semanas, não meses",
                "Rastreabilidade completa da fibra à peça",
                "Atualizações SaaS automáticas - zero custos de TI",
                "Monitorização das operações têxteis em tempo real",
                "API aberta - os seus dados, sempre acessíveis",
                "A partir de 99€/mês, tudo incluído",
              ].map((item) => (
                <li class="flex items-start gap-3 text-sm font-medium">
                  <div class="w-5 h-5 rounded-full bg-primary/15 text-primary flex items-center justify-center shrink-0 mt-0.5">
                    <Check className="w-3 h-3" />
                  </div>
                  {item}
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- ══════════════════════════════════════════════════ -->
    <!-- ── DPP REGULATION - Urgency section ── -->
    <!-- ══════════════════════════════════════════════════ -->
    <section class="relative bg-[#060E24] text-white py-24 md:py-32 overflow-hidden">
      <!-- Background effects -->
      <div class="absolute inset-0 pointer-events-none">
        <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-primary/10 rounded-full blur-[120px]"></div>
        <div class="absolute inset-0 opacity-[0.03]" style="background-image: linear-gradient(to right, white 1px, transparent 1px), linear-gradient(to bottom, white 1px, transparent 1px); background-size: 48px 48px;"></div>
      </div>

      <div class="container relative mx-auto px-4 md:px-6 max-w-6xl">
        <div class="grid lg:grid-cols-2 gap-16 items-center">
          <div class="space-y-6 min-w-0">
            <div class="inline-flex items-center gap-2.5 bg-white/[0.06] text-white/70 text-[10px] font-bold px-4 py-2 rounded-full uppercase tracking-widest border border-white/10">
              <span class="relative flex h-2 w-2">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-amber-400 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-2 w-2 bg-amber-400"></span>
              </span>
              Regulamento UE · ESPR
            </div>
            <h2 class="font-heading text-4xl md:text-5xl lg:text-5xl font-extrabold leading-[1.05]">
              Passaportes Digitais de Produto são obrigatórios a partir de 2027
            </h2>
          </div>

          <div class="space-y-6">
            <p class="text-white/50 text-lg leading-relaxed">
              O Regulamento da UE para o Ecodesign de Produtos Sustentáveis (ESPR) torna os Passaportes Digitais de Produto obrigatórios para todos os produtos têxteis vendidos na Europa. Produtos não conformes serão bloqueados do mercado.
            </p>
            <div class="border border-white/10 rounded-2xl p-6 bg-white/[0.03]">
              <div class="grid grid-cols-2 gap-4">
                {[
                  { value: "€166B", label: "Mercado em risco" },
                  { value: "2027", label: "Data de aplicação" },
                  { value: "27", label: "Países da UE" },
                  { value: "0", label: "Dias a desperdiçar" },
                ].map((stat) => (
                  <div class="text-center py-3">
                    <div class="font-heading text-2xl md:text-3xl font-extrabold text-white tabular-nums">{stat.value}</div>
                    <div class="text-xs text-white/40 mt-1">{stat.label}</div>
                  </div>
                ))}
              </div>
            </div>
            <div class="flex flex-col sm:flex-row items-center gap-3 pt-2">
              <Button size="lg" className="rounded-xl bg-white text-[#060E24] hover:bg-white/90 font-bold h-12 px-8 text-base" asChild>
                <a href="/pt/dpp">Saber Mais Sobre DPP</a>
              </Button>
              <GoogleCalendarButton client:load label="Falar com um Especialista" variant="outline" size="lg" className="bg-transparent! border-white/20! text-white! hover:bg-white/10! rounded-xl! h-12!" />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ══════════════════════════════════════════════════ -->
    <!-- ── SOCIAL PROOF - Testimonials / Validation ── -->
    <!-- ══════════════════════════════════════════════════ -->
    <section class="py-24 md:py-32">
      <div class="container mx-auto px-4 md:px-6 max-w-6xl">
        <div class="text-center mb-16">
          <p class="text-[11px] font-bold uppercase tracking-widest text-primary mb-4">Acesso Antecipado</p>
          <h2 class="font-heading text-3xl md:text-5xl font-bold tracking-tight leading-tight mb-5">
            A confiança dos fabricantes mais inovadores
          </h2>
          <p class="text-muted-foreground text-lg max-w-2xl mx-auto">
            Os nossos parceiros de acesso antecipado já estão a ver resultados.
          </p>
        </div>

        <div class="grid md:grid-cols-3 gap-6">
          {[
            {
              quote: "Passámos anos a tentar que o nosso ERP legado lidasse com os requisitos DPP. A Hestia resolveu-o em semanas.",
              author: "Diretor de Produção",
              company: "Fabricante Têxtil Português",
            },
            {
              quote: "Só a visibilidade de produção em tempo real já justificou a mudança. A automatização da conformidade foi o bónus.",
              author: "Gestor de Operações Fabris",
              company: "Exportador Têxtil da UE",
            },
            {
