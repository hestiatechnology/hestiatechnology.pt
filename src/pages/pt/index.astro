---
import Layout from "@/layouts/Layout.astro";
import { Button } from "@/components/ui/button";
import FeatureShowcase from "@/components/FeatureShowcase";
import { HowItWorks } from "@/components/HowItWorks.pt";
import { Image } from "astro:assets";
import IPCALogo from "@/assets/ipca_cor.png";
import STARTIpca from "@/assets/start-ipca.png";
import { TypewriterEffect } from "@/components/ui/typewriter-effect";
import { Magnetic } from "@/components/ui/magnetic";
import { GoogleCalendarButton } from "@/components/GoogleCalendarButton";
---

<Layout title="Hestia ERP - A Plataforma de Operações para Fabricantes Têxteis">
  <div class="flex flex-col">
    <!-- Hero Section -->
    <section class="min-h-[80vh] flex flex-col items-center justify-center text-center relative overflow-hidden pt-32 lg:pt-40 pb-20">
      <!-- Background Gradient -->
      <div class="absolute inset-0 -z-10">
        <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,_var(--tw-gradient-stops))] from-primary/10 via-background to-background"></div>
        <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[1000px] h-[600px] bg-primary/20 blur-[120px] rounded-full opacity-50"></div>
      </div>

      <div class="container mx-auto px-4 md:px-6 relative z-10 flex flex-col items-center">
        <div class="max-w-4xl mx-auto space-y-8">
          <h1
            class="text-5xl md:text-7xl lg:text-8xl font-bold tracking-tight text-foreground animate-fade-up"
          >
            O ERP com IA para Fabricantes Têxteis
          </h1>
          <p class="max-w-2xl mx-auto text-xl text-muted-foreground animate-fade-up [animation-delay:200ms]">
            O Hestia automatiza a conformidade com a UE, o acompanhamento da produção e os Passaportes Digitais de Produto — substituindo sistemas legados dispendiosos e pouco fiáveis.
          </p>
          <div class="flex flex-col sm:flex-row justify-center gap-4 animate-fade-up [animation-delay:400ms]">
            <GoogleCalendarButton client:load label="Agendar uma Demonstração" size="lg" />
            <Magnetic client:load>
              <Button size="lg" variant="outline" className="rounded-full text-lg h-12 px-8">
                <a href={`/${Astro.currentLocale}/features`}>Ver Funcionalidades</a>
              </Button>
            </Magnetic>
          </div>
        </div>
      </div>
    </section>

    <!-- Stats Strip -->
    <div class="border-y bg-muted/30 py-10">
      <div class="container mx-auto px-4 md:px-6">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
          <div>
            <div class="text-3xl font-bold text-foreground">2027</div>
            <div class="text-sm text-muted-foreground mt-1">Data-Alvo DPP da UE</div>
          </div>
          <div>
            <div class="text-3xl font-bold text-foreground">€166B</div>
            <div class="text-sm text-muted-foreground mt-1">Receita da Indústria Têxtil da UE</div>
          </div>
          <div>
            <div class="text-3xl font-bold text-foreground">27</div>
            <div class="text-sm text-muted-foreground mt-1">Países da UE Afetados</div>
          </div>
          <div>
            <div class="text-3xl font-bold text-foreground">ESPR</div>
            <div class="text-sm text-muted-foreground mt-1">Regulamento da UE que impõe o DPP</div>
          </div>
        </div>
      </div>
    </div>

    <!-- Institutional Partners -->
    <div class="border-b bg-background py-8">
      <div class="container mx-auto px-4 text-center">
        <p class="text-xs font-semibold text-muted-foreground uppercase tracking-wider mb-6">Apoio Institucional</p>
        <div class="flex flex-wrap items-center justify-center gap-x-12 gap-y-6 opacity-60 grayscale hover:grayscale-0 hover:opacity-100 transition-all duration-500">
          <Image src={IPCALogo} height={40} alt="IPCA" class="h-10 w-auto object-contain" />
          <Image src={STARTIpca} height={40} alt="Start IPCA" class="h-10 w-auto object-contain" />
        </div>
      </div>
    </div>

    <!-- Features Section -->
    <div class="py-20 md:py-32">
      <FeatureShowcase
        client:load
        locale={Astro.currentLocale}
        title="O ERP Inteligente para Fabricantes Têxteis"
        description="Automatizamos a conformidade com a UE e o acompanhamento da produção, substituindo sistemas legados dispendiosos e pouco fiáveis."
      />
    </div>

    <!-- How It Works Section -->
    <HowItWorks client:visible />

    <!-- Comparison Section -->
    <section class="py-20 md:py-32 bg-muted/30 relative">
      <div class="container mx-auto px-4 md:px-6">
        <div class="text-center mb-16">
          <h2 class="text-3xl font-bold tracking-tighter sm:text-5xl text-foreground mb-4">
            Porquê Mudar para o Hestia?
          </h2>
          <p class="max-w-2xl mx-auto text-muted-foreground md:text-xl">
            Os ERPs legados não foram criados para o ESPR, DPP ou rastreabilidade têxtil em tempo real. O Hestia foi.
          </p>
        </div>
        <div class="grid md:grid-cols-2 gap-8 max-w-5xl mx-auto">
          <!-- Legacy ERP Card -->
          <div class="bg-card/50 border rounded-2xl p-8 lg:p-10 backdrop-blur-sm">
            <h3 class="text-2xl font-bold text-muted-foreground mb-8">ERPs Legados</h3>
            <ul class="space-y-6">
              <li class="flex items-center gap-4 text-muted-foreground text-lg">
                <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-red-100 text-red-600 dark:bg-red-900/30">✕</div>
                Sem conformidade ESPR / DPP integrada
              </li>
              <li class="flex items-center gap-4 text-muted-foreground text-lg">
                <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-red-100 text-red-600 dark:bg-red-900/30">✕</div>
                Rastreio manual de lotes e partidas de fio
              </li>
              <li class="flex items-center gap-4 text-muted-foreground text-lg">
                <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-red-100 text-red-600 dark:bg-red-900/30">✕</div>
                Consultores de TI dispendiosos para cada atualização
              </li>
              <li class="flex items-center gap-4 text-muted-foreground text-lg">
                <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-red-100 text-red-600 dark:bg-red-900/30">✕</div>
                Sem monitorização em tempo real do chão de fábrica
              </li>
            </ul>
          </div>

          <!-- Hestia ERP Card -->
          <div class="bg-gradient-to-br from-card to-background border-2 border-primary/20 rounded-2xl p-8 lg:p-10 shadow-2xl relative overflow-hidden group hover:border-primary/40 transition-colors">
            <div class="absolute inset-0 bg-primary/5 opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none"></div>
            <div class="absolute top-0 right-0 bg-primary text-primary-foreground text-xs font-bold px-4 py-1.5 rounded-bl-xl shadow-sm">
              RECOMENDADO
            </div>
            <h3 class="text-3xl font-bold text-foreground mb-8">Hestia ERP</h3>
            <ul class="space-y-6">
              <li class="flex items-center gap-4 font-medium text-lg">
                <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-primary/10 text-primary">✓</div>
                Geração nativa de DPP (pronto para ESPR)
              </li>
              <li class="flex items-center gap-4 font-medium text-lg">
                <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-primary/10 text-primary">✓</div>
                Rastreabilidade total da fibra ao produto final
              </li>
              <li class="flex items-center gap-4 font-medium text-lg">
                <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-primary/10 text-primary">✓</div>
                Atualizações regulatórias automáticas via SaaS
              </li>
              <li class="flex items-center gap-4 font-medium text-lg">
                <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-primary/10 text-primary">✓</div>
                Monitorização da produção em tempo real
              </li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Testimonials / Social Proof Section -->
    <section class="py-20 md:py-32">
      <div class="container mx-auto px-4 md:px-6">
        <div class="text-center mb-16">
          <h2 class="text-3xl font-bold tracking-tighter sm:text-4xl text-foreground mb-4">
            O Que Dizem os Fabricantes
          </h2>
          <p class="max-w-2xl mx-auto text-muted-foreground md:text-lg">
            Os primeiros utilizadores partilham a sua experiência com o Hestia.
          </p>
        </div>
        <div class="grid md:grid-cols-3 gap-6 max-w-5xl mx-auto">
          <!-- Testimonial 1 -->
          <div class="bg-card border rounded-2xl p-7 flex flex-col gap-4 shadow-sm hover:shadow-md transition-shadow">
            <div class="flex gap-1 text-primary">
              {"★★★★★".split("").map((s) => <span>{s}</span>)}
            </div>
            <p class="text-muted-foreground text-sm leading-relaxed flex-1">
              "Passávamos semanas por trimestre a preparar documentos de conformidade manualmente. O Hestia reduziu isso para minutos. Só a geração de DPP justifica toda a plataforma."
            </p>
            <div>
              <div class="font-semibold text-sm text-foreground">Responsável de Produção</div>
              <div class="text-xs text-muted-foreground">Fabricante Têxtil, Norte de Portugal</div>
            </div>
          </div>

          <!-- Testimonial 2 -->
          <div class="bg-card border rounded-2xl p-7 flex flex-col gap-4 shadow-sm hover:shadow-md transition-shadow">
            <div class="flex gap-1 text-primary">
              {"★★★★★".split("").map((s) => <span>{s}</span>)}
            </div>
            <p class="text-muted-foreground text-sm leading-relaxed flex-1">
              "O nosso ERP legado precisava de um consultor de TI sempre que as regulamentações mudavam. Com o Hestia atualiza automaticamente. É um modelo completamente diferente."
            </p>
            <div>
              <div class="font-semibold text-sm text-foreground">Diretor de Operações</div>
              <div class="text-xs text-muted-foreground">Empresa de Tecelagem, Braga</div>
            </div>
          </div>

          <!-- Testimonial 3 -->
          <div class="bg-card border rounded-2xl p-7 flex flex-col gap-4 shadow-sm hover:shadow-md transition-shadow">
            <div class="flex gap-1 text-primary">
              {"★★★★★".split("").map((s) => <span>{s}</span>)}
            </div>
            <p class="text-muted-foreground text-sm leading-relaxed flex-1">
              "O painel em tempo real mostrou-nos exatamente onde estavam os nossos estrangulamentos. Melhorámos o rendimento sem adicionar recursos humanos. O ROI foi visível no primeiro mês."
            </p>
            <div>
              <div class="font-semibold text-sm text-foreground">Proprietário de Fábrica</div>
              <div class="text-xs text-muted-foreground">Fiação, Guimarães</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- DPP Section -->
    <section id="dpp" class="py-20 md:py-32 overflow-hidden bg-muted/20">
      <div class="container mx-auto px-4 md:px-6">
        <div class="relative bg-primary/5 rounded-3xl p-8 md:p-16 text-center max-w-5xl mx-auto border border-primary/10">
          <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,_var(--tw-gradient-stops))] from-primary/10 via-transparent to-transparent opacity-50"></div>

          <div class="relative z-10">
            <div class="inline-block bg-primary/10 text-primary text-xs font-bold px-4 py-1.5 rounded-full uppercase tracking-wider mb-6">
              Regulamento da UE: ESPR
            </div>
            <h2
              class="text-4xl font-bold tracking-tight sm:text-5xl text-foreground mb-6"
            >
              Os Passaportes Digitais de Produto São Obrigatórios
            </h2>
            <p
              class="max-w-3xl mx-auto text-lg text-muted-foreground mb-10 leading-relaxed"
            >
              O Regulamento de Ecodesign para Produtos Sustentáveis da UE (ESPR) torna os Passaportes Digitais de Produto obrigatórios para produtos têxteis. Produtos não conformes serão bloqueados nos mercados da UE. O Hestia gera DPPs automaticamente a partir dos seus dados de produção existentes — sem consultores externos, sem introdução manual de dados, sem perturbação das operações.
            </p>
            <div class="flex flex-col sm:flex-row justify-center gap-4">
              <Button size="lg" className="rounded-full px-8">
                <a href={`/${Astro.currentLocale}/dpp`}>Saiba Mais Sobre o DPP</a>
              </Button>
              <GoogleCalendarButton client:load label="Falar com um Especialista" variant="outline" size="lg" />
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>
