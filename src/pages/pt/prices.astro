---
import { Button } from "@/components/ui/button";
import Layout from "@/layouts/Layout.astro";
import { Check } from "lucide-react";
import PricingSimulator from "@/components/PricingSimulator";
---

<Layout title="Preços - Hestia ERP">
  <div class="flex flex-col min-h-screen">

    <!-- ── Hero ── -->
    <section class="pt-20 pb-16 md:pt-28 md:pb-20 border-b border-border/60">
      <div class="container mx-auto px-4 md:px-6 max-w-6xl">
        <div class="max-w-2xl">
          <p class="text-[11px] font-bold uppercase tracking-widest text-primary mb-4">Preços</p>
          <h1 class="font-heading text-5xl md:text-6xl font-bold tracking-tight leading-tight mb-5">
            Pague Apenas o Que Usa
          </h1>
          <p class="text-lg text-muted-foreground leading-relaxed">
            Uma taxa fixa de plataforma, depois adicione utilizadores e módulos à medida que a sua fábrica cresce. Sem surpresas, sem custos iniciais.
          </p>
        </div>
      </div>
    </section>

    <!-- ── How pricing works ── -->
    <section class="py-16 md:py-20 bg-muted/20 border-b border-border/60">
      <div class="container mx-auto px-4 md:px-6 max-w-6xl">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {[
            { n: "1", title: "Base da Plataforma", desc: "Uma taxa mensal fixa que cobre o ERP principal e o motor de conformidade DPP." },
            { n: "2", title: "Adicione Utilizadores", desc: "Pague apenas pelos lugares que precisa — Operadores e Gestores a preços diferentes." },
            { n: "3", title: "Escolha Módulos", desc: "Ative funcionalidades avançadas apenas quando a sua fábrica estiver pronta para elas." },
          ].map((step) => (
            <div class="flex gap-5">
              <div class="w-8 h-8 rounded-full bg-primary text-white flex items-center justify-center font-heading font-bold text-sm shrink-0 mt-0.5">
                {step.n}
              </div>
              <div>
                <h3 class="font-heading font-bold mb-2">{step.title}</h3>
                <p class="text-sm text-muted-foreground leading-relaxed">{step.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ── Base platform card ── -->
    <section class="py-16 md:py-20">
      <div class="container mx-auto px-4 md:px-6 max-w-6xl">
        <div class="grid lg:grid-cols-[1fr,2fr] gap-12 items-start">
          <div>
            <p class="text-[11px] font-bold uppercase tracking-widest text-primary mb-4">Plano Base</p>
            <h2 class="font-heading text-3xl font-bold leading-tight mb-4">
              Tudo o que precisa para começar
            </h2>
            <p class="text-sm text-muted-foreground leading-relaxed">
              Uma taxa única cobre o ERP principal, geração de DPP e conformidade regulatória automática.
            </p>
          </div>

          <div class="border-2 border-primary/30 rounded-2xl p-8 bg-primary/4">
            <div class="flex items-start justify-between mb-6">
              <div>
                <div class="flex items-baseline gap-1">
                  <span class="font-heading text-5xl font-bold">€99</span>
                  <span class="text-muted-foreground">/mês</span>
                </div>
                <p class="text-xs text-muted-foreground mt-1">ou ~€1.015/ano com 15% de desconto</p>
              </div>
              <div class="bg-primary text-white text-[10px] font-bold px-3 py-1 rounded-full uppercase tracking-widest">
                Incluído
              </div>
            </div>
            <ul class="grid sm:grid-cols-2 gap-3 mb-8">
              {[
                "ERP Principal (produção, inventário, fornecedores)",
                "Geração de Passaporte Digital de Produto da UE",
                "Atualizações regulatórias automáticas",
                "2 lugares de Gestor incluídos",
                "5 lugares de Operador incluídos",
                "Suporte padrão",
              ].map((f) => (
                <li class="flex items-start gap-3 text-sm">
                  <div class="mt-0.5 bg-primary/15 p-1 rounded-full shrink-0">
                    <Check class="w-3 h-3 text-primary" />
                  </div>
                  <span class="text-foreground/80">{f}</span>
                </li>
              ))}
            </ul>
            <Button size="lg" className="rounded-lg font-semibold w-full sm:w-auto" asChild>
              <a href={`/${Astro.currentLocale}/contact`}>Começar Agora</a>
            </Button>
          </div>
        </div>
      </div>
    </section>

    <!-- ── User seats ── -->
    <section class="py-16 md:py-20 bg-muted/20 border-y border-border/60">
      <div class="container mx-auto px-4 md:px-6 max-w-6xl">
        <div class="grid lg:grid-cols-[1fr,2fr] gap-12 items-start">
          <div>
            <p class="text-[11px] font-bold uppercase tracking-widest text-primary mb-4">Utilizadores</p>
            <h2 class="font-heading text-3xl font-bold leading-tight mb-4">
              Lugares de Utilizador
            </h2>
            <p class="text-sm text-muted-foreground leading-relaxed">
              Adicione lugares além dos incluídos na base da plataforma.
            </p>
          </div>

          <div class="grid sm:grid-cols-2 gap-5">
            {[
              {
                role: "Operador",
                price: "€5",
                period: "/utilizador/mês",
                features: ["Registar runs de produção", "Digitalizar e rastrear artigos", "Consultar tarefas atribuídas", "Introdução de dados básica"],
              },
              {
                role: "Gestor",
                price: "€18",
                period: "/utilizador/mês",
                features: ["Tudo o que os Operadores podem fazer", "Aprovar fluxos de trabalho", "Gestão de inventário", "Acesso a relatórios e análises"],
              },
            ].map((seat) => (
              <div class="border border-border rounded-2xl p-6 bg-card">
                <div class="mb-5">
                  <h3 class="font-heading text-xl font-bold mb-2">{seat.role}</h3>
                  <div class="flex items-baseline gap-1">
                    <span class="font-heading text-3xl font-bold">{seat.price}</span>
                    <span class="text-sm text-muted-foreground">{seat.period}</span>
                  </div>
                </div>
                <ul class="space-y-2.5">
                  {seat.features.map((f) => (
                    <li class="flex items-start gap-2.5 text-sm text-foreground/75">
                      <Check class="w-4 h-4 text-primary shrink-0 mt-0.5" />
                      {f}
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- ── Add-on modules ── -->
    <section class="py-16 md:py-20">
      <div class="container mx-auto px-4 md:px-6 max-w-6xl">
        <div class="mb-10">
          <p class="text-[11px] font-bold uppercase tracking-widest text-primary mb-4">Módulos</p>
          <h2 class="font-heading text-3xl font-bold leading-tight mb-3">Módulos Adicionais</h2>
          <p class="text-muted-foreground text-sm max-w-xl">
            Ative capacidades avançadas quando a sua fábrica estiver pronta. Cada módulo adiciona-se ao plano base.
          </p>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
          {[
            { name: "Validação de Documentos com IA", desc: "Valide automaticamente documentos e certificações de fornecedores.", price: "€129", period: "/mês" },
            { name: "Integrações Avançadas", desc: "Ligue-se à Smartex e outras plataformas de produção.", price: "€99", period: "/mês por integração" },
            { name: "Análise em Tempo Real", desc: "Dashboards de produção em direto e relatórios de desempenho.", price: "€99", period: "/mês" },
            { name: "DPP Avançado", desc: "Gestão e exportação de DPP para múltiplos produtos.", price: "€79", period: "/mês" },
          ].map((mod) => (
            <div class="border border-border rounded-2xl p-6 bg-card hover:border-primary/50 transition-colors group">
              <h3 class="font-heading font-bold text-sm leading-snug mb-2 group-hover:text-primary transition-colors">{mod.name}</h3>
              <div class="flex items-baseline gap-1 mb-3">
                <span class="font-heading text-2xl font-bold">{mod.price}</span>
                <span class="text-xs text-muted-foreground">{mod.period}</span>
              </div>
              <p class="text-xs text-muted-foreground leading-relaxed">{mod.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ── Examples ── -->
    <section class="py-16 md:py-20 bg-muted/20 border-y border-border/60">
      <div class="container mx-auto px-4 md:px-6 max-w-6xl">
        <div class="mb-10">
          <p class="text-[11px] font-bold uppercase tracking-widest text-primary mb-4">Exemplos</p>
          <h2 class="font-heading text-3xl font-bold leading-tight">Quanto Custa na Prática?</h2>
        </div>
        <div class="grid md:grid-cols-2 gap-6 max-w-3xl">
          {[
            {
              label: "Pequena Fábrica",
              title: "1 Gestor · 15 Operadores",
              items: [
                { desc: "Base da plataforma", amount: "€99" },
                { desc: "1 gestor (incluído na base)", amount: "€0", muted: true },
                { desc: "10 operadores extra × €5", amount: "€50" },
              ],
              total: "€149/mês",
              note: "~€1.790/ano · Sem custos iniciais",
            },
            {
              label: "Fábrica Média",
              title: "3 Gestores · 40 Operadores",
              items: [
                { desc: "Base da plataforma", amount: "€99" },
                { desc: "1 gestor extra × €18", amount: "€18" },
                { desc: "35 operadores extra × €5", amount: "€175" },
                { desc: "Análise + 1 integração", amount: "€198" },
              ],
              total: "€490/mês",
              note: "~€5.880/ano · Inclui dois módulos premium",
            },
          ].map((ex) => (
            <div class="border border-border rounded-2xl p-7 bg-card">
              <div class="text-[10px] font-bold uppercase tracking-widest text-muted-foreground mb-1">{ex.label}</div>
              <h3 class="font-heading font-bold text-lg mb-6">{ex.title}</h3>
              <div class="space-y-2.5 text-sm mb-5">
                {ex.items.map((item) => (
                  <div class="flex justify-between">
                    <span class="text-muted-foreground">{item.desc}</span>
                    <span class={item.muted ? "text-muted-foreground" : "font-medium"}>{item.amount}</span>
                  </div>
                ))}
                <div class="border-t border-border/60 pt-3 flex justify-between font-bold">
                  <span>Total</span>
                  <span class="text-primary">{ex.total}</span>
                </div>
              </div>
              <p class="text-xs text-muted-foreground">{ex.note}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ── Simulator ── -->
    <section class="py-16 md:py-24">
      <div class="container mx-auto px-4 md:px-6 max-w-6xl">
        <div class="mb-10">
          <p class="text-[11px] font-bold uppercase tracking-widest text-primary mb-4">Simulador</p>
          <h2 class="font-heading text-3xl font-bold leading-tight mb-3">Simule o Seu Preço</h2>
          <p class="text-muted-foreground text-sm">Ajuste utilizadores e módulos para ver o custo mensal exato.</p>
        </div>
        <PricingSimulator locale="pt" contactHref={`/${Astro.currentLocale}/contact`} client:load />
      </div>
    </section>

    <!-- ── CTA ── -->
    <section class="bg-[#0D1A3A] text-white py-20">
      <div class="container mx-auto px-4 md:px-6 max-w-6xl text-center">
        <h2 class="font-heading text-3xl md:text-4xl font-bold mb-4">
          Não tem a certeza de qual a configuração ideal?
        </h2>
        <p class="text-white/60 mb-8 max-w-md mx-auto">
          A nossa equipa ajuda-o a encontrar o plano certo para a dimensão e necessidades da sua fábrica.
        </p>
        <Button size="lg" className="rounded-lg bg-white text-[#0D1A3A] hover:bg-white/90 font-semibold" asChild>
          <a href={`/${Astro.currentLocale}/contact`}>Falar com a Nossa Equipa</a>
        </Button>
      </div>
    </section>

  </div>
</Layout>
