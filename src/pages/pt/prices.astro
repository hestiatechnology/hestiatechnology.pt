---
import {
  Card,
  CardContent,
  CardDescription,
  CardHeader,
  CardTitle,
} from "@/components/ui/card";
import { Button } from "@/components/ui/button";
import Layout from "@/layouts/Layout.astro";
import { Check } from "lucide-react";

const tiers = [
  {
    name: "Conformidade",
    price: "4.800€",
    period: "/ano",
    description: "Funcionalidades essenciais para começar.",
    features: [
      "ERP Essencial",
      "Fluxo de Trabalho de Produção",
      "Geração de DPP da UE",
    ],
    buttonText: "Começar",
    buttonVariant: "outline",
  },
  {
    name: "Pro",
    price: "12.000€",
    period: "/ano",
    description: "Funcionalidades avançadas para empresas em crescimento.",
    features: [
      "Tudo no plano Conformidade",
      "Validação de Documentos com IA",
      "Integrações Avançadas com Fornecedores (Smartex, etc.)",
      "Análises",
    ],
    buttonText: "Atualizar Agora",
    buttonVariant: "default",
  },
  {
    name: "Empresarial",
    price: "Contacte-nos",
    period: "",
    description: "Soluções personalizadas para operações de grande escala.",
    features: [
      "Tudo no plano Pro",
      "Fluxos de Trabalho Personalizados",
      "Suporte Dedicado",
      "etc.",
    ],
    buttonText: "Contactar Vendas",
    buttonVariant: "outline",
  },
];
---

<Layout title="Preços - Hestia ERP">
  <section class="py-20 md:py-32 lg:py-40">
    <div class="px-4 md:px-6">
      <div class="text-center mb-12">
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold tracking-tighter text-foreground">
          Planos de Subscrição Simples
        </h1>
        <p class="max-w-2xl mx-auto mt-4 text-muted-foreground md:text-xl">
          Escolha o plano perfeito para as suas necessidades de fabrico.
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {
          tiers.map((tier) => (
            <Card className="border">
              <CardHeader>
                <CardTitle>{tier.name}</CardTitle>
                <CardDescription>{tier.description}</CardDescription>
              </CardHeader>
              <CardContent className="space-y-6">
                <div class="text-4xl font-bold">
                  {tier.price}
                  <span class="text-lg font-normal text-muted-foreground">
                    {tier.period}
                  </span>
                </div>
                <ul class="space-y-2">
                  {tier.features.map((feature) => (
                    <li class="flex items-center gap-2">
                      <Check className="w-5 h-5 text-primary" />
                      <span>{feature}</span>
                    </li>
                  ))}
                </ul>
                <Button
                  size="lg"
                  className="w-full"
                  variant={tier.buttonVariant as any}
                >
                  {tier.buttonText}
                </Button>
              </CardContent>
            </Card>
          ))
        }
      </div>
    </div>
  </section>
</Layout>
