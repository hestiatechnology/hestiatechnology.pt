---
import {
  Card,
  CardContent,
  CardDescription,
  CardHeader,
  CardTitle,
} from "@/components/ui/card";
import { Button } from "@/components/ui/button";
import Layout from "@/layouts/Layout.astro";
import { Check, HelpCircle } from "lucide-react";
import { Badge } from "@/components/ui/badge";

const tiers = [
  {
    name: "Essencial",
    price: "4.800€",
    period: "/ano",
    description: "Funcionalidades essenciais para pequenas fábricas iniciarem.",
    features: [
      "ERP Essencial",
      "Fluxo de Trabalho de Produção",
      "Geração de DPP da UE (Básico)",
      "Suporte Padrão",
      "5 Utilizadores"
    ],
    buttonText: "Começar Agora",
    buttonVariant: "outline",
    popular: false,
  },
  {
    name: "Crescimento",
    price: "12.000€",
    period: "/ano",
    description: "Ferramentas avançadas para operações em expansão.",
    features: [
      "Tudo no plano Essencial",
      "Validação de Documentos com IA",
      "Integrações Avançadas (Smartex, etc.)",
      "Painel de Análise em Tempo Real",
      "Utilizadores Ilimitados",
      "Suporte Prioritário"
    ],
    buttonText: "Atualizar para Crescimento",
    buttonVariant: "default",
    popular: true,
  },
  {
    name: "Empresarial",
    price: "Sob Consulta",
    period: "",
    description: "Soluções personalizadas para operações industriais de grande escala.",
    features: [
      "Tudo no plano Crescimento",
      "Fluxos de Trabalho e APIs Personalizadas",
      "Gestor de Sucesso Dedicado",
      "Opções de Instalação On-premise",
      "Garantias SLA",
      "Formação Personalizada"
    ],
    buttonText: "Contactar Vendas",
    buttonVariant: "outline",
    popular: false,
  },
];
---

<Layout title="Preços - Hestia ERP">
  <div class="flex flex-col min-h-screen">
    <section class="py-20 md:py-32 lg:py-40 relative overflow-hidden">
       {/* Background Decoration */}
       <div class="absolute inset-0 -z-10 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-primary/10 via-background to-background"></div>
      
      <div class="container mx-auto px-4 md:px-6">
        <div class="text-center mb-16 space-y-4">
          <Badge variant="secondary" className="mb-4">Preços Simples e Transparentes</Badge>
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold tracking-tighter text-foreground">
            Invista no Futuro da Sua Fábrica
          </h1>
          <p class="max-w-2xl mx-auto text-muted-foreground md:text-xl">
            Escolha o plano perfeito para a escala da sua produção. Sem taxas ocultas.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-7xl mx-auto">
          {
            tiers.map((tier) => (
              <Card className={`flex flex-col border-2 relative transition-all duration-300 hover:shadow-xl ${tier.popular ? 'border-primary shadow-lg scale-105 z-10' : 'border-border hover:border-primary/50'}`}>
                {tier.popular && (
                    <div class="absolute top-0 right-0 -mt-3 -mr-3">
                        <span class="bg-primary text-primary-foreground text-xs font-bold px-3 py-1 rounded-full shadow-md">MAIS POPULAR</span>
                    </div>
                )}
                <CardHeader className="pb-8">
                  <CardTitle className="text-2xl mb-2">{tier.name}</CardTitle>
                  <CardDescription className="text-base">{tier.description}</CardDescription>
                </CardHeader>
                <CardContent className="flex flex-col flex-1 gap-8">
                  <div class="flex items-baseline gap-1">
                    <span class="text-4xl font-bold tracking-tight">{tier.price}</span>
                    <span class="text-muted-foreground font-medium">{tier.period}</span>
                  </div>
                  
                  <ul class="space-y-4 flex-1">
                    {tier.features.map((feature) => (
                      <li class="flex items-start gap-3">
                        <div class="mt-1 bg-primary/10 p-1 rounded-full">
                            <Check className="w-3 h-3 text-primary" />
                        </div>
                        <span class="text-sm text-foreground/80 leading-tight">{feature}</span>
                      </li>
                    ))}
                  </ul>
                  
                  <Button
                    size="lg"
                    className={`w-full rounded-full font-semibold ${tier.popular ? 'shadow-lg shadow-primary/20' : ''}`}
                    variant={tier.buttonVariant as any}
                  >
                    <a href={`/${Astro.currentLocale}/contact`} class="w-full h-full flex items-center justify-center">
                        {tier.buttonText}
                    </a>
                  </Button>
                </CardContent>
              </Card>
            ))
          }
        </div>

        <div class="mt-20 text-center">
            <p class="text-muted-foreground mb-4">Tem dúvidas sobre os preços?</p>
            <Button variant="link" asChild>
                <a href={`/${Astro.currentLocale}/contact`} class="gap-2">
                    Fale com a nossa equipa de suporte <HelpCircle className="w-4 h-4" />
                </a>
            </Button>
        </div>
      </div>
    </section>
  </div>
</Layout>