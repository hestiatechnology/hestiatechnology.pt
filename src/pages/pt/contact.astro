---
import Layout from "@/layouts/Layout.astro";
import { actions } from "astro:actions";
import { ContactForm } from "@/components/ContactForm";
import { Mail, Phone, MapPin } from "lucide-react";

export const prerender = false;

let captchaError = "";

if (Astro.request.method === "POST") {
  try {
    const formData = await Astro.request.formData();

    const captchaToken = formData.get("h-captcha-response");

    const captchaVerify = await fetch("https://api.hcaptcha.com/siteverify", {
      method: "POST",
      headers: { "Content-Type": "application/x-www-form-urlencoded" },
      body: new URLSearchParams({
        secret: import.meta.env.HCAPTCHA_SECRET_KEY,
        response: captchaToken?.toString() || "",
        remoteip: Astro.request.headers.get("x-forwarded-for") || "",
        sitekey: "22ee0f18-378a-46ce-9246-473c5c64bd9a",
      }),
    });

    const captchaResult = await captchaVerify.json();

    if (!captchaResult.success) {
      captchaError = "Captcha falhou. Por favor, tente novamente.";
    } else {
      const { data, error } = await Astro.callAction(actions.email, formData);
      return Astro.redirect(`/${Astro.currentLocale}/contact?submitted=true`);
    }
  } catch (error) {
    if (error instanceof Error) {
      captchaError = "Ocorreu um erro. Tente novamente.";
      console.error(error.message);
    }
  }
}

const labels = {
  company: "Empresa",
  email: "Email",
  phone: "Telefone (Opcional)",
  topic: "Assunto",
  message: "Mensagem",
  submit: "Enviar Mensagem",
  selectPlaceholder: "Selecione um assunto",
  topics: {
    sales: "Vendas",
    support: "Suporte",
    partnership: "Parceria",
    other: "Outro",
  },
};
---

<Layout title="Contactos - Hestia ERP">
  <div class="flex flex-col min-h-screen">

    <!-- ── Hero ── -->
    <section class="pt-20 pb-16 md:pt-28 md:pb-20 border-b border-border/60">
      <div class="container mx-auto px-4 md:px-6 max-w-6xl">
        <div class="max-w-2xl">
          <p class="text-[11px] font-bold uppercase tracking-widest text-primary mb-4">Contacto</p>
          <h1 class="font-heading text-5xl md:text-6xl font-bold tracking-tight leading-tight mb-5">
            Fale Connosco
          </h1>
          <p class="text-lg text-muted-foreground leading-relaxed">
            Tem alguma dúvida ou quer agendar uma demonstração? A nossa equipa está pronta para ajudar.
          </p>
        </div>
      </div>
    </section>

    <!-- ── Contact body ── -->
    <section class="py-16 md:py-20 flex-1">
      <div class="container mx-auto px-4 md:px-6 max-w-6xl">
        <div class="grid lg:grid-cols-[1fr,1.5fr] gap-12 lg:gap-16">

          <!-- Left: info -->
          <div class="space-y-10">
            <div>
              <h2 class="font-heading text-2xl font-bold mb-3">Entre em contacto</h2>
              <p class="text-muted-foreground text-sm leading-relaxed">
                Preencha o formulário e entraremos em contacto consigo o mais brevemente possível.
              </p>
            </div>

            <div class="space-y-6">
              {[
                {
                  Icon: Mail,
                  title: "Email",
                  sub: "Dúvidas gerais e suporte",
                  value: "info@hestiatechnology.pt",
                  href: "mailto:info@hestiatechnology.pt",
                },
                {
                  Icon: Phone,
                  title: "Telefone",
                  sub: "Seg-Sex, 9h às 18h",
                  value: "+351 928 251 008",
                  href: "tel:+351928251008",
                },
                {
                  Icon: MapPin,
                  title: "Escritório",
                  sub: "Incubadora IPCA, Campus do IPCA\nLugar do Aldão, 4750-810 Barcelos\nPortugal",
                  value: null,
                  href: null,
                },
              ].map(({ Icon, title, sub, value, href }) => (
                <div className="flex items-start gap-4">
                  <div className="w-10 h-10 bg-primary/10 rounded-xl flex items-center justify-center shrink-0 text-primary">
                    <Icon className="w-5 h-5" />
                  </div>
                  <div>
                    <h3 className="font-heading font-bold text-sm mb-0.5">{title}</h3>
                    <p className="text-xs text-muted-foreground whitespace-pre-line leading-relaxed">{sub}</p>
                    {value && href && (
                      <a
                        href={href}
                        className="text-sm font-medium text-foreground hover:text-primary transition-colors mt-1 inline-block"
                      >
                        {value}
                      </a>
                    )}
                  </div>
                </div>
              ))}
            </div>
          </div>

          <!-- Right: form -->
          <div class="bg-card border border-border rounded-2xl p-8">
            <h2 class="font-heading text-xl font-bold mb-6">Envie-nos uma mensagem</h2>
            {captchaError && (
              <div class="bg-destructive/10 text-destructive text-sm p-3 rounded-xl mb-5 border border-destructive/20">
                {captchaError}
              </div>
            )}
            <ContactForm
              client:load
              labels={labels}
              siteKey="22ee0f18-378a-46ce-9246-473c5c64bd9a"
            />
          </div>

        </div>
      </div>
    </section>

  </div>
</Layout>
