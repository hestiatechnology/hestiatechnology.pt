---
import Layout from "@/layouts/Layout.astro";
import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card";
import { actions } from "astro:actions";
import { ContactForm } from "@/components/ContactForm";
import { Mail, Phone, MapPin } from "lucide-react";

export const prerender = false;

let captchaError = "";

if (Astro.request.method === "POST") {
  try {
    const formData = await Astro.request.formData();

    const captchaToken = formData.get("h-captcha-response");

    const captchaVerify = await fetch("https://api.hcaptcha.com/siteverify", {
      method: "POST",
      headers: { "Content-Type": "application/x-www-form-urlencoded" },
      body: new URLSearchParams({
        secret: import.meta.env.HCAPTCHA_SECRET_KEY,
        response: captchaToken?.toString() || "",
        remoteip: Astro.request.headers.get("x-forwarded-for") || "",
        sitekey: "22ee0f18-378a-46ce-9246-473c5c64bd9a",
      }),
    });

    const captchaResult = await captchaVerify.json();

    console.log("hCaptcha result:", captchaResult);

    if (!captchaResult.success) {
      captchaError = "Captcha falhou. Por favor, tente novamente.";
    } else {
      const { data, error } = await Astro.callAction(actions.email, formData);
      return Astro.redirect(`/${Astro.currentLocale}/contact?submitted=true`);
    }
  } catch (error) {
    if (error instanceof Error) {
      captchaError = "Ocorreu um erro. Tente novamente.";
      console.error(error.message);
    }
  }
}

const labels = {
  company: "Empresa",
  email: "Email",
  phone: "Telefone (Opcional)",
  topic: "Assunto",
  message: "Mensagem",
  submit: "Enviar Mensagem",
  selectPlaceholder: "Selecione um assunto",
  topics: {
    sales: "Vendas",
    support: "Suporte",
    partnership: "Parceria",
    other: "Outro",
  },
};
---

<Layout title="Contactos - Hestia ERP">
  <div class="min-h-screen bg-muted/30">
    <!-- Header -->
    <section class="py-20 md:py-32 relative overflow-hidden bg-background border-b">
      <div class="absolute inset-0 -z-10 bg-[radial-gradient(ellipse_at_bottom,_var(--tw-gradient-stops))] from-primary/5 via-background to-background"></div>
      <div class="container mx-auto px-4 md:px-6 text-center">
        <h1 class="text-4xl md:text-5xl font-bold tracking-tight text-foreground mb-4">
          Fale Connosco
        </h1>
        <p class="text-muted-foreground text-lg max-w-2xl mx-auto">
          Tem alguma dúvida ou quer agendar uma demonstração? A nossa equipa está pronta para ajudar.
        </p>
      </div>
    </section>

    <div class="container mx-auto px-4 md:px-6 py-12 md:py-20">
      <div class="grid lg:grid-cols-2 gap-12 max-w-6xl mx-auto">
        
        <!-- Contact Info -->
        <div class="space-y-8">
          <div>
            <h2 class="text-2xl font-bold mb-4">Entre em contacto</h2>
            <p class="text-muted-foreground">
              Preencha o formulário e entraremos em contacto consigo o mais brevemente possível.
            </p>
          </div>

          <div class="grid gap-6">
            <Card class="border-0 shadow-none bg-transparent">
              <div class="flex items-start gap-5 p-4">
                <div class="bg-primary/10 p-3 rounded-lg text-primary shrink-0">
                  <Mail class="w-6 h-6" />
                </div>
                <div>
                  <h3 class="font-semibold text-lg">Email</h3>
                  <p class="text-muted-foreground text-sm mb-1">Dúvidas gerais e suporte</p>
                  <a href="mailto:info@hestiatechnology.pt" class="text-foreground hover:text-primary transition-colors font-medium">info@hestiatechnology.pt</a>
                </div>
              </div>
            </Card>

            <Card class="border-0 shadow-none bg-transparent">
              <div class="flex items-start gap-5 p-4">
                <div class="bg-primary/10 p-3 rounded-lg text-primary shrink-0">
                  <Phone class="w-6 h-6" />
                </div>
                <div>
                  <h3 class="font-semibold text-lg">Telefone</h3>
                  <p class="text-muted-foreground text-sm mb-1">Seg-Sex, 9h às 18h</p>
                  <a href="tel:+351928251008" class="text-foreground hover:text-primary transition-colors font-medium">+351 928 251 008</a>
                </div>
              </div>
            </Card>

            <Card class="border-0 shadow-none bg-transparent">
              <div class="flex items-start gap-5 p-4">
                <div class="bg-primary/10 p-3 rounded-lg text-primary shrink-0">
                  <MapPin class="w-6 h-6" />
                </div>
                <div>
                  <h3 class="font-semibold text-lg">Escritório</h3>
                  <p class="text-muted-foreground text-sm leading-relaxed">
                    Incubadora IPCA, Campus do IPCA<br />
                    Lugar do Aldão, 4750-810 Barcelos<br />
                    Portugal
                  </p>
                </div>
              </div>
            </Card>
          </div>
        </div>

        <!-- Contact Form -->
        <Card className="border shadow-lg bg-card">
          <CardHeader>
            <CardTitle>Envie-nos uma mensagem</CardTitle>
          </CardHeader>
          <CardContent>
            {captchaError && (
              <div class="bg-destructive/10 text-destructive text-sm p-3 rounded-md mb-4 border border-destructive/20">
                {captchaError}
              </div>
            )}
            <ContactForm
              client:load
              labels={labels}
              siteKey="22ee0f18-378a-46ce-9246-473c5c64bd9a"
            />
          </CardContent>
        </Card>

      </div>
    </div>
  </div>
</Layout>