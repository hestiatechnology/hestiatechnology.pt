---
import Layout from "@/layouts/Layout.astro";
import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card";
import { actions } from "astro:actions";
import { ContactForm } from "@/components/ContactForm";

export const prerender = false;

let captchaError = "";

if (Astro.request.method === "POST") {
  try {
    const formData = await Astro.request.formData();

    const captchaToken = formData.get("h-captcha-response");

    const captchaVerify = await fetch("https://api.hcaptcha.com/siteverify", {
      method: "POST",
      headers: { "Content-Type": "application/x-www-form-urlencoded" },
      body: new URLSearchParams({
        secret: import.meta.env.HCAPTCHA_SECRET_KEY,
        response: captchaToken?.toString() || "",
        remoteip: Astro.request.headers.get("x-forwarded-for") || "",
        sitekey: "22ee0f18-378a-46ce-9246-473c5c64bd9a",
      }),
    });

    const captchaResult = await captchaVerify.json();

    console.log("hCaptcha result:", captchaResult);

    if (!captchaResult.success) {
      captchaError = "Captcha failed. Please try again.";
    } else {
      const { data, error } = await Astro.callAction(actions.email, formData);
      return Astro.redirect("/contact?submitted=true");
    }
  } catch (error) {
    if (error instanceof Error) {
      captchaError = "Ocorreu um erro. Tente novamente.";
      console.error(error.message);
    }
  }
}

const labels = {
  company: "Empresa",
  email: "Email",
  phone: "Telefone (Opcional)",
  topic: "Assunto",
  message: "Mensagem",
  submit: "Enviar",
  selectPlaceholder: "Selecione um assunto",
  topics: {
    sales: "Vendas",
    support: "Suporte",
    partnership: "Parceria",
    other: "Outro",
  },
};
---

<Layout title="Contactos">
  <section class="py-15 px-3 md:px-0">
    <div class="container mx-auto max-w-2xl">
      <Card className="border">
        <CardHeader>
          <CardTitle className="text-3xl font-bold">Contacto</CardTitle>
        </CardHeader>
        <CardContent>
          {captchaError && (
            <div class="text-red-600 mb-2">{captchaError}</div>
          )}
          <ContactForm
            client:load
            labels={labels}
            siteKey="22ee0f18-378a-46ce-9246-473c5c64bd9a"
          />
        </CardContent>
      </Card>
    </div>
  </section>
</Layout>

