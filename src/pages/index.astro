---
import Layout from "@/layouts/Layout.astro";
import { Badge } from "@/components/ui/badge";
import { Button } from "@/components/ui/button";
import FeatureCard from "@/components/FeatureCard";
import { CheckCircle, XCircle, Zap } from "lucide-react";
import TeamSection from "@/components/TeamSection.tsx";
import { Image } from "astro:assets";
import IPCALogo from "@/assets/ipca_cor.png";
import STARTIpca from "@/assets/start-ipca.png";
import SafariBackground from "@/components/SafariBackground";

const problems = [
  {
    title: "The Production Black Hole",
    description:
      "Production stops because a fabric delivery is late, with no prior warning about the delay.",
    icon: "XCircle",
  },
  {
    title: "The Coordination Chaos",
    description:
      "Getting one status update means chasing emails, checking spreadsheets, and making multiple phone calls. It's all guesswork.",
    icon: "XCircle",
  },
  {
    title: "The Trust Deficit",
    description:
      "Promising a client a delivery date without any real confidence it can be met, risking the company's reputation.",
    icon: "XCircle",
  },
];

const solutions = [
  {
    title: "From Flying Blind to Seeing Everything",
    description:
      "Eliminate unexpected production stops with total visibility, turning proactive alerts into uninterrupted workflow.",
    icon: "CheckCircle",
  },
  {
    title: "From Guesswork to Absolute Certainty",
    description:
      "Replace scattered emails and spreadsheets with a single, real-time source of truth for your entire supply chain.",
    icon: "CheckCircle",
  },
  {
    title: "From Broken Promises to Unbreakable Trust",
    description:
      "Transform risky delivery estimates into reliable deadlines you can confidently promise and consistently meet.",
    icon: "CheckCircle",
  },
];
---

<Layout title="Hestia ERP - The Operations Platform for Textile Manufacturers">
  <div class="flex flex-col">
    <!-- Hero Section -->
    <section class="py-20 md:py-32 lg:py-40 text-center">
      <div class="container mx-auto px-4 md:px-6">
        <Badge className="mb-4 bg-primary text-primary-foreground">
         Built for the future of business
        </Badge>
        <h1
          class="text-4xl md:text-5xl lg:text-6xl font-bold tracking-tighter text-foreground"
        >
          The Operations Platform for <span class="text-primary"
            >Textile Manufacturers</span
          >
        </h1>
        <p class="max-w-3xl mx-auto mt-4 text-muted-foreground md:text-xl">
          Hestia ERP turns your biggest operational challenges into your greatest
          strengths. Move from operational chaos to full control.
        </p>
        <div class="mt-8 flex justify-center gap-4">
          <Button size="lg" asChild>
            <a href="/contact">Schedule a Demo</a>
          </Button>
          <Button size="lg" variant="outline" asChild>
            <a href="/prices">View Pricing</a>
          </Button>
        </div>
		<div class="mt-8">
			<SafariBackground client:only="react" />
		</div>
      </div>
    </section>

    <!-- Problems Section -->
    <section id="problems" class="py-12 md:py-24 bg-muted">
      <div class="container mx-auto px-4 md:px-6">
        <div class="text-center mb-12">
          <h2 class="text-3xl font-bold tracking-tighter sm:text-4xl text-foreground">
            Flying Blind in Your Supply Chain?
          </h2>
          <p class="max-w-2xl mx-auto mt-4 text-muted-foreground md:text-lg">
            This isn't an inconvenience. It's an annual tax of up to €100k on
            your business.
          </p>
        </div>
        <div class="grid gap-8 md:grid-cols-3">
          {
            problems.map((problem) => (
              <div class="flex flex-col items-center text-center">
                <XCircle className="w-12 h-12 text-destructive" />
                <h3 class="mt-4 text-xl font-bold">{problem.title}</h3>
                <p class="mt-2 text-muted-foreground">
                  {problem.description}
                </p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Solutions Section -->
    <section id="solutions" class="py-12 md:py-24">
      <div class="container mx-auto px-4 md:px-6">
        <div class="text-center mb-12">
          <h2 class="text-3xl font-bold tracking-tighter sm:text-4xl text-foreground">
            From Operational Chaos to Full Control
          </h2>
          <p class="max-w-2xl mx-auto mt-4 text-muted-foreground md:text-lg">
            Hestia ERP turns your biggest operational challenges into your
            greatest strengths.
          </p>
        </div>
        <div class="grid gap-8 md:grid-cols-3">
          {
            solutions.map((solution) => (
              <div class="flex flex-col items-center text-center">
                <CheckCircle className="w-12 h-12 text-green-500" />
                <h3 class="mt-4 text-xl font-bold">{solution.title}</h3>
                <p class="mt-2 text-muted-foreground">
                  {solution.description}
                </p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Why Now? Section -->
    <section id="why-now" class="py-12 md:py-24 bg-muted">
      <div class="container mx-auto px-4 md:px-6">
        <div class="text-center">
          <Zap className="w-12 h-12 text-primary mx-auto" />
          <h2
            class="mt-4 text-3xl font-bold tracking-tighter sm:text-4xl text-foreground"
          >
            So... Why now?
          </h2>
          <p
            class="max-w-3xl mx-auto mt-4 text-muted-foreground md:text-lg"
          >
            The <span class="font-bold text-foreground"
              >EU Digital Product Passport (DPP)</span
            > will be mandatory by 2027. Legacy systems cannot handle this,
            lacking the data architecture to track information from origin to
            final product.
          </p>
          <p
            class="max-w-3xl mx-auto mt-4 text-lg font-semibold text-foreground"
          >
            Hestia is built from the ground up for this new reality, with
            native support for DPP requirements to ensure seamless compliance.
          </p>
          <div class="mt-8">
            <Button asChild>
              <a href="/dpp">Learn About DPP Compliance</a>
            </Button>
          </div>
        </div>
      </div>
    </section>

    <!-- Team Section -->
    <TeamSection client:load />

    <!-- Partners Section -->
    <section id="partners" class="py-12 md:py-24">
      <div class="container mx-auto">
        <h2
          class="text-3xl font-bold tracking-tighter sm:text-5xl text-foreground mb-8 text-center"
        >
          Our Partners
        </h2>
        <div
          class="flex flex-col md:flex-row items-center justify-center gap-x-12 gap-y-8"
        >
          <Image
            src={IPCALogo}
            height={120}
            alt="IPCA Logo"
            class="grayscale hover:grayscale-0 transition-all"
          />
          <Image
            src={STARTIpca}
            height={120}
            alt="START IPCA Logo"
            class="grayscale hover:grayscale-0 transition-all"
          />
        </div>
      </div>
    </section>
  </div>
</Layout>