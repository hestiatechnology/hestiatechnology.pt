---
import { Safari } from "@/components/magicui/safari";
import Layout from "../layouts/Layout.astro";
import { Badge } from "@/components/ui/badge";

import FeatureCard from "@/components/FeatureCard";
import { Modules } from "@/data/features";
import { Image } from "astro:assets";
import IPCALogo from "@/assets/ipca_cor.png";
import STARTIpca from "@/assets/start-ipca.png";

---

<Layout>
  <div class="flex flex-col">
    <section class="py-12 md:py-24 lg:py-32">
      <div class="container mx-auto px-4 md:px-6">
        <div class="flex flex-col gap-y-6 justify-center items-center">
          <Badge className="w-fit h-fit text-primary bg-primary-foreground">
            ✨ Em estado de Beta
          </Badge>
          <h1
            class="text-3xl font-bold tracking-tighter sm:text-5xl xl:text-6xl/none text-foreground text-center"
          >
            Gestão <span class="text-primary">feita simples</span> para empresas.
          </h1>

          <p class="max-w-[600px] text-muted-foreground md:text-xl text-center">
            Cresça com o seu negócio. O nosso software de gestão adapta-se às
            suas necessidades, desde startups até grandes empresas.
          </p>

          <div class="relative">
            <Safari
              url="erp.hestiatechnology.pt"
              className="size-full"
              imageSrc="https://5g41m27qal.ufs.sh/f/XyxsTHN0lM5Yq1fnu2hOeLrQCFgzH7dKDG41hjBkIJTsx03S"
              client:only="react"
            />
          </div>
        </div>
      </div>
    </section>

    <section id="patners">
      <div class="container mx-auto">
        <h2
          class="text-3xl font-bold tracking-tighter sm:text-5xl text-foreground mb-4 text-center"
        >
          Parceiros
        </h2>
        <div
          class="flex flex-col md:flex-row items-center md:justify-around gap-y-4"
        >
          <Image src={IPCALogo} height={140} alt="IPCA Logo" />
          <Image src={STARTIpca} height={140} alt="START IPCA Logo" />
        </div>
      </div>
    </section>

    <section id="recursos" class="py-12 md:py-24 lg:py-32">
      <div class="container mx-auto px-4 md:px-6">
        <div class="text-center mb-12">
          <Badge className="mb-4 bg-blue-100 text-blue-800">Recursos</Badge>
          <h2
            class="text-3xl font-bold tracking-tighter sm:text-5xl text-foreground mb-4"
          >
            Tudo que sua empresa precisa em um só lugar
          </h2>
          <p class="max-w-[900px] mx-auto text-muted-foreground md:text-xl">
            Nosso ERP oferece módulos integrados para gerenciar todos os
            aspectos do seu negócio
          </p>
        </div>

        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {Modules.map((resource) => <FeatureCard data={resource} />)}
        </div>
      </div>
    </section>
  </div>
</Layout>
