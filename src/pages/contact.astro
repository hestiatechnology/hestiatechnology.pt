---
import { Input } from "@/components/ui/input";
import Layout from "../layouts/Layout.astro";
import { Label } from "@/components/ui/label";
import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card";
import { Textarea } from "@/components/ui/textarea";
import { Button } from "@/components/ui/button";
import { actions } from "astro:actions";

export const prerender = false;

if (Astro.request.method === "POST") {
  try {
    const formData = await Astro.request.formData();

    const captchaToken = formData.get("h-captcha-response");

    const captchaVerify = await fetch("https://hcaptcha.com/siteverify", {
      method: "POST",
      headers: { "Content-Type": "application/x-www-form-urlencoded" },
      body: new URLSearchParams({
        secret: import.meta.env.HCAPTCHA_SECRET_KEY,
        response: captchaToken?.toString() || "",
        remoteip: Astro.request.headers.get("x-forwarded-for") || "",
      }),
    });

    const captchaResult = await captchaVerify.json();

    if (!captchaResult.success) {
      return new Response("Captcha failed. Please try again.", { status: 400 });
    }

    const { data, error } = await Astro.callAction(actions.email, formData);
    return Astro.redirect("/contact?submitted=true");
  } catch (error) {
    if (error instanceof Error) {
      console.error(error.message);
    }
  }
}
---

<Layout title="Contactos">
  <section class="max-w-3xl mx-auto py-15 px-3 md:px-0">
    <Card>
      <CardHeader>
        <CardTitle className="text-3xl font-bold">Contacto</CardTitle>
      </CardHeader>
      <CardContent>
        <form method="POST" class="flex flex-col gap-y-5">
          <div class="flex flex-col gap-y-1">
            <Label htmlFor="empresa">Empresa</Label>
            <Input id="empresa" type="text" name="company" />
          </div>
          <div class="flex flex-col gap-y-1">
            <Label htmlFor="email">Email</Label>
            <Input id="email" type="email" name="email" />
          </div>
          <div class="flex flex-col gap-y-1">
            <Label htmlFor="message">Mensagem</Label>
            <Textarea id="message" name="message" />
          </div>
          <div
            class="h-captcha"
            data-sitekey="bdaa5ad0-6866-4f88-ace4-cbb2aa40c2fc"
          >
          </div>
          <Button>Submit</Button>
        </form>
      </CardContent>
    </Card>
  </section>
</Layout>

<script src="https://hcaptcha.com/1/api.js" async defer></script>
