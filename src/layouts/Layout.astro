---
import "@/styles/global.css";
import { AnnouncementBar } from "@/components/annoucement-bar";
import Footer from "@/components/Footer";
import Header from "@/components/Header";
import { translations } from "@/lib/translations";

const { title } = Astro.props;
const locale = Astro.currentLocale as keyof typeof translations;

const t = (key: keyof (typeof translations)[typeof locale]) => {
  return translations[locale][key] || translations.en[key];
};

// Get the current URL path
const currentPath = Astro.url.pathname;
const siteUrl = Astro.site || "https://hestiatechnology.pt";

// Construct canonical URL (remove query parameters for clean canonical)
const canonicalURL = new URL(currentPath, siteUrl).href.split('?')[0];

// Construct alternate language URLs
// Remove locale prefix and rebuild URLs for each language
const pathWithoutLocale = currentPath.replace(/^\/(en|pt)/, "") || "/";
const enURL = new URL(`/en${pathWithoutLocale}`, siteUrl).href;
const ptURL = new URL(`/pt${pathWithoutLocale}`, siteUrl).href;
---

<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Canonical and alternate language tags for SEO -->
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang="en" href={enURL} />
    <link rel="alternate" hreflang="pt" href={ptURL} />
    <link rel="alternate" hreflang="x-default" href={ptURL} />

    <title>Hestia - {title}</title>
    <meta
      name="description"
      content={t("layout.meta.description")}
    />

    <meta property="og:title" content="Hestia Technology Lda" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://hestiatechnology.pt/" />
    <meta
      property="og:description"
      content={t("layout.og.description")}
    />

    <link
      href="https://calendar.google.com/calendar/scheduling-button-script.css"
      rel="stylesheet"
    />
    <script
      src="https://calendar.google.com/calendar/scheduling-button-script.js"
      async></script>

    <!-- Structured Data for SEO -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "Hestia Technology Lda",
      "url": "https://hestiatechnology.pt",
      "logo": "https://hestiatechnology.pt/HestiaTechnology.svg",
      "description": t("layout.meta.description"),
      "sameAs": [
        "https://www.linkedin.com/company/hestia-technology"
      ],
      "contactPoint": {
        "@type": "ContactPoint",
        "contactType": "Customer Service",
        "availableLanguage": ["Portuguese", "English"]
      }
    })} />
  </head>
  <body class="min-h-screen flex flex-col antialiased">
    <AnnouncementBar
      message={t("announcement.message")}
      type="promotion"
      actionText={t("announcement.action")}
      actionHref=`/${Astro.currentLocale}/investments`
    />
    <Header client:only="react" locale={locale} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer client:only="react" locale={locale} />
  </body>
</html>

<script is:inline>
  const getThemePreference = () => {
    if (typeof localStorage !== "undefined" && localStorage.getItem("theme")) {
      return localStorage.getItem("theme");
    }
    return window.matchMedia("(prefers-color-scheme: dark)").matches
      ? "dark"
      : "light";
  };
  const isDark = getThemePreference() === "dark";
  document.documentElement.classList[isDark ? "add" : "remove"]("dark");

  if (typeof localStorage !== "undefined") {
    const observer = new MutationObserver(() => {
      const isDark = document.documentElement.classList.contains("dark");
      localStorage.setItem("theme", isDark ? "dark" : "light");
    });
    observer.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ["class"],
    });
  }
</script>
